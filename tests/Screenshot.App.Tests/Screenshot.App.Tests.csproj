    <EmbeddedResource Include="Fixtures\pin-recapture-chat.jpg" />
    <EmbeddedResource Include="Fixtures\camel-case-selection.png" />
    <EmbeddedResource Include="Fixtures\translation-provider-selection.png" />
    <EmbeddedResource Include="Fixtures\mixed-ocr-host-selection.png" />
