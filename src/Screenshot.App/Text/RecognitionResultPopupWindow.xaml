<Window x:Class="Screenshot.App.Text.RecognitionResultPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:presentation="clr-namespace:Screenshot.App.Presentation"
        Title="识别结果"
        Width="480"
        Height="350"
        MinWidth="300"
        MinHeight="260"
        AllowsTransparency="False"
        Background="{DynamicResource AppPanelBackgroundBrush}"
        FontFamily="Microsoft YaHei UI"
        ResizeMode="CanResize"
        ShowActivated="True"
        ShowInTaskbar="True"
        Topmost="False"
        WindowStartupLocation="Manual"
        WindowStyle="None">
    <Window.Resources>
        <Style x:Key="ReadingText" TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource AppReadingForegroundBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource AppReadingForegroundBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="SelectionTextBrush" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      Background="Transparent" Focusable="False" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Geometry x:Key="PinIconGeometry">M 6,2 H 12 L 11.5,6 L 14,8.5 L 10,9.5 L 9,16 L 8,9.5 L 4,8.5 L 6.5,6 Z</Geometry>
        <Style x:Key="PopupIconToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource AppPanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AppControlForegroundBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource AppAccentBrush}" />
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Opacity" Value="0.78" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Border x:Name="Shell" Margin="0" Background="{DynamicResource AppGlassBackgroundBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource AppHeaderBackgroundBrush}" BorderBrush="{DynamicResource AppSubtleBorderBrush}"
                        BorderThickness="0,0,0,1" CornerRadius="10,10,0,0">
                    <Grid Background="Transparent" MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                            <Image Source="{x:Static presentation:AppBrandIcon.Source}" Width="19" Height="19" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="SnapCut" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        </StackPanel>
                        <ToggleButton x:Name="PinButton" Grid.Column="1" Width="32" Height="30" Margin="4,0,5,0" Click="OnPinClick"
                                      Background="Transparent" BorderThickness="0" Style="{StaticResource PopupIconToggle}" ToolTip="置顶窗口">
                            <Path Data="{StaticResource PinIconGeometry}" Width="14" Height="16" Fill="{DynamicResource AppTextPrimaryBrush}" Stretch="Uniform" />
                        </ToggleButton>
                        <Button Grid.Column="2" Width="38" Height="30" Margin="0,0,7,0" Padding="0" Background="Transparent" BorderThickness="0"
                                Content="×" FontSize="20" Click="OnCloseClick" Cursor="Hand" ToolTip="关闭" />
                    </Grid>
                </Border>
                <StackPanel Grid.Row="1" Margin="20,16,20,0">
                    <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                    <Border Height="2" Width="36" Margin="0,9,0,0" HorizontalAlignment="Left" Background="{DynamicResource SelectionBorderBrush}" />
                </StackPanel>
                <Grid Grid.Row="2" Margin="20,14,20,18">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /></Grid.RowDefinitions>
                    <presentation:ActivityRail x:Name="BusyRail" />
                    <TextBox x:Name="ResultTextBox" Grid.Row="1" Padding="2" Margin="0,6,0,0" AcceptsReturn="True" Style="{StaticResource ReadingText}"
                             Background="Transparent" BorderThickness="0" FontSize="16"
                             IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    <TextBlock x:Name="BusyText" Grid.Row="1" Text="正在识别文字…" Visibility="Collapsed" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                </Grid>
                <Border Grid.Row="3" Padding="16,12" BorderBrush="{DynamicResource AppSubtleBorderBrush}" BorderThickness="0,1,0,0"
                        Background="{DynamicResource AppHeaderBackgroundBrush}" CornerRadius="0,0,10,10">
                    <DockPanel LastChildFill="True">
                        <Button x:Name="CopyAllButton" DockPanel.Dock="Right" MinWidth="86" Padding="12,6" Content="复制全部" Click="OnCopyClick"
                                Background="{DynamicResource AppAccentBrush}" Foreground="{DynamicResource AppOnAccentBrush}" BorderBrush="{DynamicResource SelectionBorderBrush}" />
                        <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Margin="0,0,8,0" Fill="{DynamicResource SelectionBorderBrush}" />
                        <TextBlock x:Name="SourceText" Tag="UserContent" Margin="0,0,12,0" MaxHeight="44" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
