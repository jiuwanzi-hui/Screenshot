<UserControl x:Class="Screenshot.App.Presentation.CaptureToolbarLayoutEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DataContextChanged="OnDataContextChanged">
    <UserControl.Resources>
        <Style x:Key="ToolbarDesignerButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource EditorToolbarButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EditorToolbarButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource EditorToolbarIconBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource EditorToolbarButtonHoverBackgroundBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource EditorToolbarButtonHoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource EditorToolbarButtonSelectedBackgroundBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource EditorToolbarButtonSelectedBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LayoutChoiceButton" TargetType="RadioButton">
            <Setter Property="MinWidth" Value="54" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Shell"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource EditorToolbarButtonHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="{DynamicResource EditorToolbarButtonSelectedBackgroundBrush}" />
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource EditorToolbarButtonSelectedBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                       Text="工具布局" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <RadioButton x:Name="OneRowButton"
                             Margin="0,0,6,0"
                             Checked="OnRowCountChecked"
                             Content="一行"
                             GroupName="CaptureToolbarRows"
                             Style="{StaticResource LayoutChoiceButton}"
                             Tag="1" />
                <RadioButton x:Name="TwoRowsButton"
                             Checked="OnRowCountChecked"
                             Content="两行"
                             GroupName="CaptureToolbarRows"
                             Style="{StaticResource LayoutChoiceButton}"
                             Tag="2" />
            </StackPanel>
        </Grid>

        <Border Margin="0,10,0,0"
                Padding="9"
                Background="{DynamicResource AppPanelBackgroundBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="7">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          PreviewMouseWheel="OnNestedScrollViewerPreviewMouseWheel"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="EditorRowsHost"
                            HorizontalAlignment="Left" />
            </ScrollViewer>
        </Border>

        <TextBlock Margin="0,13,0,0"
                   FontSize="12"
                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                   Text="实时预览" />
        <Border Margin="0,7,0,0"
                Padding="9"
                Background="{DynamicResource AppPanelBackgroundBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="7">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          PreviewMouseWheel="OnNestedScrollViewerPreviewMouseWheel"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PreviewRowsHost"
                            HorizontalAlignment="Left" />
            </ScrollViewer>
        </Border>
    </StackPanel>
</UserControl>
