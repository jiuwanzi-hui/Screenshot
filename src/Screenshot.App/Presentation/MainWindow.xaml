                                            DragOver="OnTranslationProfileRowDragOver"
                                            DragLeave="OnTranslationProfileRowDragLeave"
                                            Drop="OnTranslationProfileRowDrop">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Border x:Name="TranslationProfileDropMarker"
                                                    Grid.ColumnSpan="4"
                                                    Height="3"
                                                    Panel.ZIndex="2"
                                                    IsHitTestVisible="False"
                                                    Background="{DynamicResource AppAccentBrush}"
                                                    Visibility="Collapsed" />
                                            <CheckBox VerticalAlignment="Center" IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Click="OnTranslationProfileChanged" />
                                            <StackPanel Grid.Column="1"
                                                        Margin="8,0,8,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding Name}" />
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                           Text="{Binding ProviderDisplayName}" />
                                            </StackPanel>
                                            <Border Grid.Column="2"
                                                    Margin="0,0,8,0"
                                                    Padding="7,2"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="4"
