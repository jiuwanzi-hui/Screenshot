<Window x:Class="Screenshot.App.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Screenshot.App.Presentation"
        xmlns:core="clr-namespace:Screenshot.App.Core"
        mc:Ignorable="d"
        Icon="/SnapCut;component/Assets/Screenshot.ico"
        Title="SnapCut"
        Width="780"
        Height="560"
        MinWidth="680"
        MinHeight="480"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource AppWindowBackgroundBrush}"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Background" Value="{DynamicResource AppPanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AppControlForegroundBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="NavigationItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="NavigationBackground"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavigationBackground" Property="Background" Value="{DynamicResource AppAccentMutedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AppAccentForegroundBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThemeOptionButton" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="Background" Value="{DynamicResource AppPanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AppControlForegroundBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ThemeOptionBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ThemeOptionBorder" Property="Background" Value="{DynamicResource AppAccentBrush}" />
                                <Setter TargetName="ThemeOptionBorder" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThemeOptionBorder" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MouseDurationSlider" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="28" Background="Transparent">
                            <Track x:Name="PART_Track"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}"
                                   IsDirectionReversed="False"
                                   VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                  Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="8"
                                                        Margin="0,0,-4,0"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource AppAccentBrush}"
                                                        CornerRadius="4" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="24"
                                           Height="24"
                                           Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="24" Height="24">
                                                    <Border x:Name="ThumbHalo"
                                                            Background="{DynamicResource AppAccentBrush}"
                                                            CornerRadius="12"
                                                            Opacity="0.18" />
                                                    <Border x:Name="ThumbCore"
                                                            Width="18"
                                                            Height="18"
                                                            Background="{DynamicResource AppAccentBrush}"
                                                            BorderBrush="#F4FFFFFF"
                                                            BorderThickness="2"
                                                            CornerRadius="9"
                                                            SnapsToDevicePixels="True" />
                                                    <Ellipse Width="5"
                                                             Height="5"
                                                             Fill="#F7FFFFFF"
                                                             IsHitTestVisible="False" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbHalo"
                                                                Property="Opacity"
                                                                Value="0.34" />
                                                        <Setter TargetName="ThumbCore"
                                                                Property="Width"
                                                                Value="20" />
                                                        <Setter TargetName="ThumbCore"
                                                                Property="Height"
                                                                Value="20" />
                                                        <Setter TargetName="ThumbCore"
                                                                Property="CornerRadius"
                                                                Value="10" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbHalo"
                                                                Property="Opacity"
                                                                Value="0.48" />
                                                        <Setter TargetName="ThumbCore"
                                                                Property="Width"
                                                                Value="16" />
                                                        <Setter TargetName="ThumbCore"
                                                                Property="Height"
                                                                Value="16" />
                                                        <Setter TargetName="ThumbCore"
                                                                Property="CornerRadius"
                                                                Value="8" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                  Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="8"
                                                        Margin="-4,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource AppAccentMutedBrush}"
                                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                                        BorderThickness="0,1,1,1"
                                                        CornerRadius="4" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type local:HotKeyCaptureBox}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="{DynamicResource AppInputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AppControlForegroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type local:HotKeyCaptureBox}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          Focusable="False" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="8"
            Background="{DynamicResource AppGlassBackgroundBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="20"
            SnapsToDevicePixels="True">
      <Grid Background="{DynamicResource AppWindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="178" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource AppSidebarBackgroundBrush}"
                BorderBrush="{DynamicResource AppSubtleBorderBrush}"
                BorderThickness="0,0,1,0"
                CornerRadius="16">
            <Grid Margin="24,26,20,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Text="SnapCut" />
                    <Border Height="1"
                            Margin="0,24,0,18"
                            Background="{DynamicResource AppSeparatorBrush}" />
                </StackPanel>

                <ListBox x:Name="SettingsNavigation"
                         Grid.Row="1"
                         BorderThickness="0"
                         Background="Transparent"
                         FocusVisualStyle="{x:Null}"
                         SelectionChanged="OnSettingsNavigationSelectionChanged">
                    <ListBoxItem IsSelected="True"
                                 Style="{StaticResource NavigationItem}">
                        <Grid Height="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Height="24"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"
                                       LineHeight="24"
                                       LineStackingStrategy="BlockLineHeight"
                                       Text="&#xE713;"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Height="24"
                                       Margin="10,0,0,0"
                                       LineHeight="24"
                                       LineStackingStrategy="BlockLineHeight"
                                       Text="常规设置"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavigationItem}">
                        <Grid Height="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Height="24"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"
                                       LineHeight="24"
                                       LineStackingStrategy="BlockLineHeight"
                                       Text="&#xE765;"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Height="24"
                                       Margin="10,0,0,0"
                                       LineHeight="24"
                                       LineStackingStrategy="BlockLineHeight"
                                       Text="快捷键"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavigationItem}">
                        <Grid Height="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Height="24"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"
                                       LineHeight="24"
                                       LineStackingStrategy="BlockLineHeight"
                                       Text="&#xE8A1;"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Height="24"
                                       Margin="10,0,0,0"
                                       LineHeight="24"
                                       LineStackingStrategy="BlockLineHeight"
                                       Text="文字识别"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavigationItem}">
                        <Grid Height="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Height="24"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"
                                       LineHeight="24"
                                       LineStackingStrategy="BlockLineHeight"
                                       Text="&#xE774;"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Height="24"
                                       Margin="10,0,0,0"
                                       LineHeight="24"
                                       LineStackingStrategy="BlockLineHeight"
                                       Text="翻译"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavigationItem}">
                        <Grid Height="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Height="24"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="17"
                                       LineHeight="24"
                                       LineStackingStrategy="BlockLineHeight"
                                       Text="&#xE895;"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="UpdateNavigationText"
                                       Grid.Column="1"
                                       Height="24"
                                       Margin="10,0,0,0"
                                       LineHeight="24"
                                       LineStackingStrategy="BlockLineHeight"
                                       Text="版本更新"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </ListBoxItem>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Column="1"
              Margin="34,28,34,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer x:Name="GeneralSettingsPanel"
                          Grid.Row="0"
                          Grid.RowSpan="2"
                          VerticalScrollBarVisibility="Auto">
              <Grid Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Text="常规" />
                    <TextBlock Margin="0,7,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Text="保存位置和运行方式" />
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Margin="0,28,0,0">
                    <TextBlock FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Text="截图保存位置" />
                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Height="34"
                                 Padding="10,3"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="{DynamicResource AppBorderBrush}"
                                 LostKeyboardFocus="OnSettingEditorLostKeyboardFocus"
                                 TextChanged="OnTextSettingChanged"
                                 Text="{Binding SaveDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1"
                                Margin="10,0,0,0"
                                Click="OnBrowseSaveDirectoryClick"
                                Content="浏览"
                                Style="{StaticResource SecondaryButton}"
                                ToolTip="选择截图保存目录" />
                    </Grid>

                    <StackPanel Margin="0,18,0,0">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   Text="界面主题" />
                        <StackPanel Margin="0,9,0,0" Orientation="Horizontal">
                            <RadioButton x:Name="SystemThemeOption"
                                         Checked="OnThemeOptionChecked"
                                         Content="跟随系统"
                                         GroupName="AppTheme"
                                         Style="{StaticResource ThemeOptionButton}"
                                         Tag="{x:Static core:AppTheme.System}" />
                            <RadioButton x:Name="LightThemeOption"
                                         Checked="OnThemeOptionChecked"
                                         Content="浅色"
                                         GroupName="AppTheme"
                                         Style="{StaticResource ThemeOptionButton}"
                                         Tag="{x:Static core:AppTheme.Light}" />
                            <RadioButton x:Name="DarkThemeOption"
                                         Checked="OnThemeOptionChecked"
                                         Content="深色"
                                         GroupName="AppTheme"
                                         Style="{StaticResource ThemeOptionButton}"
                                         Tag="{x:Static core:AppTheme.Dark}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Separator Grid.Row="2"
                           Margin="0,27,0,18"
                           Background="{DynamicResource AppSeparatorBrush}" />

                <StackPanel Grid.Row="3">
                    <TextBlock FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Text="点击关闭按钮时" />
                    <StackPanel Margin="0,9,0,8" Orientation="Horizontal">
                        <RadioButton x:Name="MinimizeOnCloseOption"
                                     Checked="OnCloseBehaviorOptionChecked"
                                     Content="最小化到后台"
                                     GroupName="WindowCloseBehavior"
                                     Style="{StaticResource ThemeOptionButton}"
                                     Tag="{x:Static core:WindowCloseBehavior.MinimizeToBackground}" />
                        <RadioButton x:Name="ExitOnCloseOption"
                                     Checked="OnCloseBehaviorOptionChecked"
                                     Content="退出程序"
                                     GroupName="WindowCloseBehavior"
                                     Style="{StaticResource ThemeOptionButton}"
                                     Tag="{x:Static core:WindowCloseBehavior.ExitApplication}" />
                    </StackPanel>
                    <CheckBox x:Name="ShowTaskbarIconCheckBox"
                              MinHeight="30"
                              FontSize="14"
                              Foreground="{DynamicResource AppTextPrimaryBrush}"
                              IsChecked="{Binding ShowTaskbarIcon}"
                              Checked="OnImmediateSettingChanged"
                              Unchecked="OnImmediateSettingChanged"
                              Content="在任务栏中显示窗口图标" />
                    <CheckBox x:Name="ShowNotificationIconCheckBox"
                              MinHeight="30"
                              Margin="0,12,0,0"
                              FontSize="14"
                              Foreground="{DynamicResource AppTextPrimaryBrush}"
                              IsChecked="{Binding ShowNotificationIcon}"
                              Checked="OnImmediateSettingChanged"
                              Unchecked="OnImmediateSettingChanged"
                              Content="显示通知区域图标" />
                    <CheckBox MinHeight="30"
                              Margin="0,12,0,0"
                              FontSize="14"
                              Foreground="{DynamicResource AppTextPrimaryBrush}"
                              IsChecked="{Binding LaunchAtStartup}"
                              Checked="OnImmediateSettingChanged"
                              Unchecked="OnImmediateSettingChanged"
                              Content="开机时启动 SnapCut" />
                    <CheckBox MinHeight="30"
                              Margin="0,12,0,0"
                              FontSize="14"
                              Foreground="{DynamicResource AppTextPrimaryBrush}"
                              IsChecked="{Binding KeepHistory}"
                              Checked="OnImmediateSettingChanged"
                              Unchecked="OnImmediateSettingChanged"
                              Content="保留本次运行的截图历史" />

                </StackPanel>
              </Grid>
            </ScrollViewer>

            <ScrollViewer x:Name="HotKeySettingsPanel"
                          Grid.Row="0"
                          Grid.RowSpan="2"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <StackPanel>
                    <TextBlock FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Text="快捷键" />
                    <TextBlock Margin="0,7,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="支持键盘组合和鼠标键；左/中/右键（含修饰键组合）需长按触发，短按和拖动保持原操作" />

                    <StackPanel Margin="0,25,0,0">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   Text="区域截图" />
                        <Grid Margin="0,8,16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:HotKeyCaptureBox x:Name="RegionCaptureHotKeyBox"
                                                    Height="34"
                                                    Padding="10,3"
                                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                                    GotKeyboardFocus="OnHotKeyCaptureGotKeyboardFocus"
                                                    HotKeyCaptured="OnHotKeyCaptured"
                                                    HotKeyCaptureCanceled="OnHotKeyCaptureCanceled"
                                                    LostKeyboardFocus="OnHotKeyCaptureLostKeyboardFocus"
                                                    Tag="RegionCaptureHotKey"
                                                    Text="{Binding RegionCaptureHotKey}"
                                                    TextAlignment="Center"
                                                    ToolTip="单击后按下键盘或鼠标按键" />
                            <Button Grid.Column="1"
                                    Width="68"
                                    Margin="8,0,0,0"
                                    Click="OnBeginHotKeyEditClick"
                                    Content="修改"
                                    Style="{StaticResource SecondaryButton}"
                                    Tag="RegionCaptureHotKeyBox"
                                    ToolTip="修改区域截图快捷键" />
                            <Button Grid.Column="2"
                                    Width="34"
                                    Margin="6,0,0,0"
                                    Click="OnClearHotKeyClick"
                                    Style="{StaticResource SecondaryButton}"
                                    Tag="RegionCaptureHotKeyBox"
                                    ToolTip="不设置区域截图快捷键">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE74D;" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel Margin="0,17,0,0">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   Text="翻译" />
                        <Grid Margin="0,8,16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:HotKeyCaptureBox x:Name="OcrHotKeyBox"
                                                    Height="34"
                                                    Padding="10,3"
                                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                                    GotKeyboardFocus="OnHotKeyCaptureGotKeyboardFocus"
                                                    HotKeyCaptured="OnHotKeyCaptured"
                                                    HotKeyCaptureCanceled="OnHotKeyCaptureCanceled"
                                                    LostKeyboardFocus="OnHotKeyCaptureLostKeyboardFocus"
                                                    Tag="OcrHotKey"
                                                    Text="{Binding OcrHotKey}"
                                                    TextAlignment="Center"
                                                    ToolTip="单击后按下键盘或鼠标按键" />
                            <Button Grid.Column="1"
                                    Width="68"
                                    Margin="8,0,0,0"
                                    Click="OnBeginHotKeyEditClick"
                                    Content="修改"
                                    Style="{StaticResource SecondaryButton}"
                                    Tag="OcrHotKeyBox"
                                    ToolTip="修改翻译快捷键" />
                            <Button Grid.Column="2"
                                    Width="34"
                                    Margin="6,0,0,0"
                                    Click="OnClearHotKeyClick"
                                    Style="{StaticResource SecondaryButton}"
                                    Tag="OcrHotKeyBox"
                                    ToolTip="不设置翻译快捷键">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE74D;" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel Margin="0,17,0,0">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   Text="钉图" />
                        <Grid Margin="0,8,16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:HotKeyCaptureBox x:Name="PinHotKeyBox"
                                                    Height="34"
                                                    Padding="10,3"
                                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                                    GotKeyboardFocus="OnHotKeyCaptureGotKeyboardFocus"
                                                    HotKeyCaptured="OnHotKeyCaptured"
                                                    HotKeyCaptureCanceled="OnHotKeyCaptureCanceled"
                                                    LostKeyboardFocus="OnHotKeyCaptureLostKeyboardFocus"
                                                    Tag="PinHotKey"
                                                    Text="{Binding PinHotKey}"
                                                    TextAlignment="Center"
                                                    ToolTip="单击后按下键盘或鼠标按键" />
                            <Button Grid.Column="1"
                                    Width="68"
                                    Margin="8,0,0,0"
                                    Click="OnBeginHotKeyEditClick"
                                    Content="修改"
                                    Style="{StaticResource SecondaryButton}"
                                    Tag="PinHotKeyBox"
                                    ToolTip="修改钉图快捷键" />
                            <Button Grid.Column="2"
                                    Width="34"
                                    Margin="6,0,0,0"
                                    Click="OnClearHotKeyClick"
                                    Style="{StaticResource SecondaryButton}"
                                    Tag="PinHotKeyBox"
                                    ToolTip="不设置钉图快捷键">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE74D;" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel Margin="0,17,16,8">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   Text="打开设置" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:HotKeyCaptureBox x:Name="OpenSettingsHotKeyBox"
                                                    Height="34"
                                                    Padding="10,3"
                                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                                    GotKeyboardFocus="OnHotKeyCaptureGotKeyboardFocus"
                                                    HotKeyCaptured="OnHotKeyCaptured"
                                                    HotKeyCaptureCanceled="OnHotKeyCaptureCanceled"
                                                    LostKeyboardFocus="OnHotKeyCaptureLostKeyboardFocus"
                                                    Tag="OpenSettingsHotKey"
                                                    Text="{Binding OpenSettingsHotKey}"
                                                    TextAlignment="Center"
                                                    ToolTip="单击后按下键盘或鼠标按键" />
                            <Button Grid.Column="1"
                                    Width="68"
                                    Margin="8,0,0,0"
                                    Click="OnBeginHotKeyEditClick"
                                    Content="修改"
                                    Style="{StaticResource SecondaryButton}"
                                    Tag="OpenSettingsHotKeyBox"
                                    ToolTip="修改打开设置快捷键" />
                            <Button Grid.Column="2"
                                    Width="34"
                                    Margin="6,0,0,0"
                                    Click="OnClearHotKeyClick"
                                    Style="{StaticResource SecondaryButton}"
                                    Tag="OpenSettingsHotKeyBox"
                                    ToolTip="不设置打开设置快捷键">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE74D;" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel Margin="0,18,16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       Text="鼠标长按触发时间" />
                            <Border Grid.Column="1"
                                    Padding="9,3"
                                    Background="{DynamicResource AppAccentMutedBrush}"
                                    CornerRadius="8">
                                <TextBlock FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppAccentForegroundBrush}"
                                           Text="{Binding MouseLongPressMilliseconds, StringFormat={}{0} ms}" />
                            </Border>
                        </Grid>
                        <Slider Margin="0,10,0,0"
                                Style="{StaticResource MouseDurationSlider}"
                                Minimum="300"
                                Maximum="2000"
                                TickFrequency="50"
                                IsSnapToTickEnabled="True"
                                SmallChange="50"
                                LargeChange="100"
                                Value="{Binding MouseLongPressMilliseconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                ValueChanged="OnMouseLongPressDurationChanged" />
                        <CheckBox Margin="0,9,0,0"
                                  IsChecked="{Binding MouseSideButtonsUseLongPress}"
                                  Checked="OnImmediateSettingChanged"
                                  Unchecked="OnImmediateSettingChanged"
                                  Content="鼠标后退键和前进键也使用长按触发" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="左、中、右键及其 Ctrl / Alt / Shift 组合均须按满此时间，短按保持原操作；移动鼠标会取消本次长按。侧键默认按下触发，勾选后也使用长按。" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Grid x:Name="OcrSettingsPanel"
                  Grid.Row="0"
                  Grid.RowSpan="2"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Text="文字识别" />
                    <TextBlock Margin="0,7,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Text="使用 Windows 已安装的 OCR 语言包" />
                </StackPanel>

                <StackPanel Grid.Row="1"
                            Margin="0,28,0,0">
                    <TextBlock FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Text="识别语言" />
                    <ComboBox x:Name="OcrLanguageComboBox"
                              Margin="0,9,0,0"
                              DisplayMemberPath="Label"
                              ItemsSource="{Binding OcrLanguageOptions}"
                              SelectedValue="{Binding OcrLanguageTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValuePath="Value"
                              SelectionChanged="OnImmediateSettingChanged"
                              ToolTip="仅显示 Windows 当前可用的 OCR 语言包" />
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="TranslationSettingsPanel"
                          Grid.Row="0"
                          Grid.RowSpan="2"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <StackPanel>
                    <TextBlock FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Text="翻译" />
                    <TextBlock Margin="0,7,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Text="可以使用在线大模型，也可以下载安装后完全离线翻译" />

                    <StackPanel x:Name="TranslationPriorityPanel"
                                Margin="0,24,0,0">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   Text="翻译优先顺序" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   Text="按序号从上到下尝试；当前方式连接失败或翻译失败时自动使用下一项。"
                                   TextWrapping="Wrap" />
                        <ItemsControl Margin="0,10,0,0"
                                      ItemsSource="{Binding TranslationPriorityItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,7"
                                            Padding="12,9"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            ToolTip="{Binding AvailabilityReason}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"
                                                        Value="{DynamicResource AppPanelBackgroundBrush}" />
                                                <Setter Property="BorderBrush"
                                                        Value="{DynamicResource AppBorderBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAvailable}"
                                                                 Value="True">
                                                        <Setter Property="Background"
                                                                Value="{DynamicResource AppAccentMutedBrush}" />
                                                        <Setter Property="BorderBrush"
                                                                Value="{DynamicResource AppAccentBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="24"
                                                    Height="24"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background"
                                                                Value="{DynamicResource AppInputBackgroundBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAvailable}"
                                                                         Value="True">
                                                                <Setter Property="Background"
                                                                        Value="{DynamicResource AppAccentMutedBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Position}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource AppTextSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAvailable}"
                                                                             Value="True">
                                                                    <Setter Property="Foreground"
                                                                            Value="{DynamicResource AppAccentBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center"
                                                           Text="{Binding Label}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource AppTextSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAvailable}"
                                                                             Value="True">
                                                                    <Setter Property="Foreground"
                                                                            Value="{DynamicResource AppTextPrimaryBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="2"
                                                    Margin="8,0,10,0"
                                                    Padding="7,2"
                                                    VerticalAlignment="Top"
                                                    CornerRadius="4"
                                                    ToolTip="{Binding AvailabilityReason}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background"
                                                                Value="{DynamicResource AppInputBackgroundBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAvailable}"
                                                                         Value="True">
                                                                <Setter Property="Background"
                                                                        Value="{DynamicResource AppAccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="11"
                                                           Text="{Binding AvailabilityLabel}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource AppTextSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAvailable}"
                                                                             Value="True">
                                                                    <Setter Property="Foreground"
                                                                            Value="White" />
                                                                    <Setter Property="FontWeight"
                                                                            Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <StackPanel Grid.Column="3"
                                                        Orientation="Horizontal">
                                                <Button Width="30"
                                                        Height="28"
                                                        Padding="0"
                                                        Click="OnMoveTranslationProviderUpClick"
                                                        Content="↑"
                                                        Focusable="False"
                                                        IsEnabled="{Binding CanMoveUp}"
                                                        Tag="{Binding Provider}"
                                                        ToolTip="提高优先级" />
                                                <Button Width="30"
                                                        Height="28"
                                                        Margin="6,0,0,0"
                                                        Padding="0"
                                                        Click="OnMoveTranslationProviderDownClick"
                                                        Content="↓"
                                                        Focusable="False"
                                                        IsEnabled="{Binding CanMoveDown}"
                                                        Tag="{Binding Provider}"
                                                        ToolTip="降低优先级" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   Text="在线项被尝试时，只会发送识别出的文字，不会上传截图图片。"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="TranslationTargetLanguagePanel"
                                Margin="0,18,0,0">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   Text="目标语言" />
                        <ComboBox x:Name="TranslationTargetLanguageComboBox"
                                  Margin="0,8,0,0"
                                  DisplayMemberPath="Label"
                                  ItemsSource="{Binding TranslationTargetLanguageOptions}"
                                  PreviewMouseWheel="OnTranslationSettingPreviewMouseWheel"
                                  SelectedValue="{Binding TranslationTargetLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Value"
                                  SelectionChanged="OnImmediateSettingChanged" />
                    </StackPanel>

                    <StackPanel x:Name="OnlineTranslationSettingsPanel"
                                Margin="0,18,0,0">
                        <Border Padding="14,11"
                                Background="{DynamicResource AppPanelBackgroundBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       Text="识别出的文字会发送给你配置的在线服务；截图图片本身不会上传。"
                                       TextWrapping="Wrap" />
                        </Border>

                        <StackPanel Margin="0,17,0,0">
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       Text="服务类型" />
                            <ComboBox x:Name="TranslationProviderComboBox"
                                      Margin="0,8,0,0"
                                      DisplayMemberPath="Label"
                                      ItemsSource="{Binding TranslationProviderOptions}"
                                      PreviewMouseWheel="OnTranslationSettingPreviewMouseWheel"
                                      SelectedValue="{Binding TranslationProvider, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Value"
                                      SelectionChanged="OnTranslationProviderSelectionChanged"
                                      ToolTip="自定义兼容接口排在第一项；内置厂商会显示其官方兼容地址" />
                        </StackPanel>

                        <StackPanel Margin="0,17,0,0">
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       Text="兼容接口地址" />
                            <TextBox x:Name="TranslationEndpointTextBox"
                                     Height="34"
                                     Margin="0,8,0,0"
                                     Padding="10,3"
                                     VerticalContentAlignment="Center"
                                     BorderBrush="{DynamicResource AppBorderBrush}"
                                     LostKeyboardFocus="OnSettingEditorLostKeyboardFocus"
                                     PreviewMouseWheel="OnTranslationSettingPreviewMouseWheel"
                                     TextChanged="OnTextSettingChanged"
                                     Text="{Binding TranslationEndpoint, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="内置厂商会自动填入官方地址；选择自定义后可填写任意 HTTPS 兼容地址" />
                            <TextBlock x:Name="TranslationProviderOfficialSiteText"
                                       Margin="0,6,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Margin="0,17,0,0">
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       Text="模型名称" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="TranslationModelComboBox"
                                          Grid.Column="0"
                                          IsEditable="True"
                                          ItemsSource="{Binding TranslationModelOptions}"
                                          LostKeyboardFocus="OnSettingEditorLostKeyboardFocus"
                                          PreviewMouseWheel="OnTranslationSettingPreviewMouseWheel"
                                          SelectionChanged="OnImmediateSettingChanged"
                                          Text="{Binding TranslationModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="可以获取厂家模型，也可以手动输入模型标识" />
                                <Button x:Name="FetchTranslationModelsButton"
                                        Grid.Column="1"
                                        MinWidth="94"
                                        Margin="8,0,0,0"
                                        Padding="12,3"
                                        Click="OnFetchTranslationModelsClick"
                                        Content="获取模型"
                                        ToolTip="使用当前服务地址和 API Key 获取模型列表" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Margin="0,17,0,8">
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       Text="API Key" />
                            <PasswordBox x:Name="TranslationApiKeyBox"
                                         Height="34"
                                         Margin="0,8,0,0"
                                         Padding="10,3"
                                         VerticalContentAlignment="Center"
                                         BorderBrush="{DynamicResource AppBorderBrush}"
                                         LostKeyboardFocus="OnTranslationApiKeyLostKeyboardFocus"
                                         PasswordChanged="OnTranslationApiKeyPasswordChanged"
                                         PreviewMouseWheel="OnTranslationSettingPreviewMouseWheel"
                                         ToolTip="仅加密保存在当前 Windows 用户下" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="OfflineTranslationSettingsPanel"
                                Margin="0,18,0,8">
                        <Border Padding="16"
                                Background="{DynamicResource AppPanelBackgroundBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel>
                                <TextBlock FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                           Text="多语言离线模型" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           Text="源语言由本地语言检测器自动识别。下载当前目标语言包后，可把全部受支持源语言翻译成目标语言；非英语语言之间自动经 English 中转。"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="OfflineModelRouteText"
                                           Margin="0,9,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="OfflineModelStatusText"
                                           Margin="0,9,0,0"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppAccentBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="OfflineModelPathText"
                                           Margin="0,5,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                                <ProgressBar x:Name="OfflineModelDownloadProgressBar"
                                             Height="6"
                                             Margin="0,13,0,0"
                                             Maximum="100"
                                             Visibility="Collapsed" />
                                <TextBlock x:Name="OfflineModelDownloadProgressText"
                                           Margin="0,5,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           Visibility="Collapsed" />
                                <StackPanel Margin="0,14,0,0"
                                            Orientation="Horizontal">
                                    <Button x:Name="DownloadOfflineModelButton"
                                            MinWidth="116"
                                            Padding="14,5"
                                            Click="OnDownloadOfflineModelClick"
                                            Content="下载目标语言包" />
                                    <Button Margin="8,0,0,0"
                                            Padding="14,5"
                                            Click="OnOpenOfflineModelDirectoryClick"
                                            Content="打开目录" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,14,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                    Text="语言检测：CLD3（完全本地） · 翻译引擎：Bergamot Translator（MPL-2.0） · 模型：Mozilla Firefox Translations 模型清单（优先正式版）"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="UpdateSettingsPanel"
                          Grid.Row="0"
                          Grid.RowSpan="2"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <StackPanel Margin="0,0,16,0">
                    <TextBlock FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Text="版本更新" />
                    <TextBlock Margin="0,7,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Text="自动选择 Gitee / GitHub 并校验最新正式版本" />

                    <Border Margin="0,26,0,0"
                            Padding="20"
                            Background="{DynamicResource AppPanelBackgroundBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                                               Text="SnapCut" />
                                    <TextBlock x:Name="CurrentVersionText"
                                               Margin="0,7,0,0"
                                               FontSize="14"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                </StackPanel>
                                <Button x:Name="CheckForUpdatesButton"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Click="OnCheckForUpdatesClick"
                                        Content="检查更新"
                                        Style="{StaticResource SecondaryButton}" />
                            </Grid>
                            <TextBlock x:Name="UpdateStatusText"
                                       Margin="0,18,0,0"
                                       FontSize="13"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       Text="点击“检查更新”自动选择可用的 Gitee / GitHub 更新源。"
                                       TextWrapping="Wrap" />
                            <ProgressBar x:Name="UpdateProgressBar"
                                         Height="5"
                                         Margin="0,12,0,0"
                                         Maximum="100"
                                         Visibility="Collapsed" />
                            <Button x:Name="InstallUpdateButton"
                                    Margin="0,14,0,0"
                                    HorizontalAlignment="Left"
                                    Click="OnInstallUpdateClick"
                                    Content="下载并更新"
                                    Style="{StaticResource PrimaryButton}"
                                    Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <Separator Margin="0,24,0,18"
                               Background="{DynamicResource AppSeparatorBrush}" />

                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Text="历史正式版本" />
                    <TextBlock x:Name="ReleaseHistoryStatusText"
                               Margin="0,6,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Text="打开此页面后会自动读取发布时间和更新内容。"
                               TextWrapping="Wrap" />

                    <TextBlock Margin="0,15,0,0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Text="选择要查看或回退的版本" />
                    <ComboBox x:Name="ReleaseHistorySelector"
                              Height="42"
                              Margin="0,8,0,0"
                              Padding="12,0,42,0"
                              FontSize="13"
                              SelectionChanged="OnReleaseHistorySelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Border x:Name="SelectedReleaseDetailsPanel"
                            Margin="0,14,0,0"
                            Padding="20"
                            Background="{DynamicResource AppPanelBackgroundBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Visibility="Collapsed">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SelectedReleaseTitleText"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                           TextWrapping="Wrap" />
                                <Border Grid.Column="1"
                                        Margin="12,0,0,0"
                                        Padding="9,3"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource AppAccentMutedBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9">
                                    <TextBlock x:Name="SelectedReleaseStateText"
                                               FontSize="12"
                                               Foreground="{DynamicResource AppAccentForegroundBrush}" />
                                </Border>
                            </Grid>
                            <TextBlock x:Name="SelectedReleaseDateText"
                                       Margin="0,5,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                            <TextBlock Margin="0,15,0,0"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       Text="更新内容" />
                            <TextBlock x:Name="SelectedReleaseNotesText"
                                       Margin="0,7,0,0"
                                       FontSize="13"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       LineHeight="21"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="SelectedReleasePackageStatusText"
                                       Margin="0,15,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <StackPanel Margin="0,14,0,0"
                                        Orientation="Horizontal">
                                <Button x:Name="SelectedReleaseActionButton"
                                        Click="OnInstallSelectedReleaseClick"
                                        Content="回退到所选版本"
                                        Style="{StaticResource PrimaryButton}"
                                        Visibility="Collapsed" />
                                <Button Margin="8,0,0,0"
                                        Click="OnOpenSelectedReleasePageClick"
                                        Content="查看发布页"
                                        Style="{StaticResource SecondaryButton}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,18,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Text="更新包会校验文件大小和 SHA-256。覆盖更新不会删除 ScreenshotData 中的设置、历史和截图。"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <TextBlock Grid.Row="2"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                       Text="{Binding StatusMessage}"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
      </Grid>
    </Border>
</Window>
