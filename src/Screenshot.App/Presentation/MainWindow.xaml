                    <CheckBox MinHeight="30"
                              Margin="0,8,0,0"
                              FontSize="14"
                              Foreground="{DynamicResource AppTextPrimaryBrush}"
                              IsChecked="{Binding LaunchAtStartup}"
                              Checked="OnImmediateSettingChanged"
                              Unchecked="OnImmediateSettingChanged"
                              Content="开机时启动 SnapCut" />
                    <CheckBox x:Name="RequestAdministratorPrivilegesCheckBox"
                              MinHeight="30"
                              Margin="0,8,0,0"
                              FontSize="14"
                              Foreground="{DynamicResource AppTextPrimaryBrush}"
                              IsChecked="{Binding RequestAdministratorPrivileges}"
                              Checked="OnImmediateSettingChanged"
                              Unchecked="OnImmediateSettingChanged"
                              Content="下次真正启动时请求管理员权限" />
                    <TextBlock Margin="26,2,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="点击右上角关闭只会最小化到后台；请使用“退出程序”后再启动。包括开机启动；拒绝 Windows 提示后仍以普通权限运行，高权限窗口中的鼠标截图快捷键可能不可用。" />
                </StackPanel>

                <Border Style="{StaticResource GeneralGroupSeparator}" />

                <StackPanel x:Name="GeneralFloatingCaptureGroup">
                    <TextBlock Style="{StaticResource GeneralGroupTitle}"
                               Text="悬浮截图" />
                    <TextBlock Style="{StaticResource GeneralGroupDescription}"
                               Text="桌面悬浮按钮及单击行为" />

                    <CheckBox x:Name="ShowFloatingCaptureButtonCheckBox"
                              MinHeight="30"
                              Margin="0,14,0,0"
                              FontSize="14"
                              Foreground="{DynamicResource AppTextPrimaryBrush}"
                              IsChecked="{Binding ShowFloatingCaptureButton}"
                              Checked="OnImmediateSettingChanged"
                              Unchecked="OnImmediateSettingChanged"
                              Content="显示截图悬浮按钮" />
                    <StackPanel Margin="26,7,0,0"
                                IsEnabled="{Binding ShowFloatingCaptureButton}">
                        <TextBlock FontSize="13"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   Text="单击悬浮按钮时" />
                        <ComboBox x:Name="FloatingCaptureClickBehaviorComboBox"
                                  Width="238"
                                  Height="34"
                                  Margin="0,7,0,0"
                                  HorizontalAlignment="Left"
                                  Padding="9,2"
                                  FontSize="13"
                                  SelectedValuePath="Tag"
                                  SelectionChanged="OnFloatingCaptureClickBehaviorSelectionChanged"
                                  ToolTip="选择单击悬浮按钮时执行的功能">
                            <ComboBox.Resources>
                                <Style BasedOn="{StaticResource {x:Type ComboBoxItem}}"
                                       TargetType="ComboBoxItem">
                                    <Setter Property="Background"
                                            Value="{DynamicResource AppPanelBackgroundBrush}" />
                                </Style>
                            </ComboBox.Resources>
                            <ComboBoxItem Content="上次区域直接截图"
                                          Tag="{x:Static core:FloatingCaptureClickBehavior.CaptureImmediately}" />
                            <ComboBoxItem Content="显示上次截图区域"
                                          Tag="{x:Static core:FloatingCaptureClickBehavior.ShowSelection}" />
                            <ComboBoxItem Content="区域截图"
                                          Tag="{x:Static core:FloatingCaptureClickBehavior.RegionCapture}" />
                            <ComboBoxItem Content="视频录制"
                                          Tag="{x:Static core:FloatingCaptureClickBehavior.VideoRecording}" />
                            <ComboBoxItem Content="长截图"
                                          Tag="{x:Static core:FloatingCaptureClickBehavior.ScrollCapture}" />
                            <ComboBoxItem Content="钉图"
                                          Tag="{x:Static core:FloatingCaptureClickBehavior.PinCapture}" />
                            <ComboBoxItem Content="全部屏幕截图"
                                          Tag="{x:Static core:FloatingCaptureClickBehavior.CaptureAllScreens}" />
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <Border Style="{StaticResource GeneralGroupSeparator}" />

                <StackPanel x:Name="GeneralScrollCaptureGroup">
                    <TextBlock Style="{StaticResource GeneralGroupTitle}"
                               Text="长截图" />
                    <TextBlock Style="{StaticResource GeneralGroupDescription}"
                               Text="选择页面滚动和拼接的控制方式" />
                    <TextBlock Margin="0,14,0,0"
                               Style="{StaticResource GeneralFieldLabel}"
                               Text="滚动方式" />
                    <ComboBox x:Name="ScrollCaptureModeComboBox"
                              Width="270"
                              Height="34"
                              Margin="0,7,0,0"
                              HorizontalAlignment="Left"
                              Padding="9,2"
                              FontSize="13"
                              SelectedValuePath="Tag"
                              SelectionChanged="OnScrollCaptureModeSelectionChanged"
                              ToolTip="自动滚动或由鼠标滚轮手动控制">
                        <ComboBoxItem Content="自动滚动（单击开始 / 暂停）"
                                      Tag="{x:Static core:ScrollCaptureMode.Automatic}" />
                        <ComboBoxItem Content="手动鼠标滚轮"
                                      Tag="{x:Static core:ScrollCaptureMode.ManualWheel}" />
                    </ComboBox>
                    <TextBlock Margin="0,7,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="手动模式下滚轮直接控制页面，可随意上下滚动、不限速度，预览实时跟随；完成后点击长截图预览窗口中的完成按钮。" />
                </StackPanel>

                <Border Style="{StaticResource GeneralGroupSeparator}" />

                <StackPanel x:Name="GeneralHistoryGroup">
                    <TextBlock Style="{StaticResource GeneralGroupTitle}"
                               Text="历史记录" />
                    <TextBlock Style="{StaticResource GeneralGroupDescription}"
                               Text="超过保留天数或最大数量时，自动删除更早的记录" />

                    <TextBlock Margin="0,15,0,0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Text="截图历史" />
                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource GeneralFieldLabel}"
                                   Text="保留" />
                        <TextBox x:Name="ScreenshotHistoryRetentionDaysTextBox"
                                 Grid.Column="1"
                                 Width="72"
                                 Height="34"
                                 Margin="8,0"
                                 MaxLength="4"
                                 Padding="9,3"
                                 VerticalContentAlignment="Center"
                                 LostKeyboardFocus="OnSettingEditorLostKeyboardFocus"
                                 TextChanged="OnTextSettingChanged"
                                 Text="{Binding ScreenshotHistoryRetentionDaysText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox"
                                       BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding KeepAllScreenshotHistory}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                            <Setter Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource GeneralFieldLabel}"
                                   Text="天" />
                        <TextBlock Grid.Column="3"
                                   Margin="18,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource GeneralFieldLabel}"
                                   Text="最多保留" />
                        <TextBox x:Name="ScreenshotHistoryLimitTextBox"
                                 Grid.Column="4"
                                 Width="72"
                                 Height="34"
                                 Margin="8,0"
                                 MaxLength="3"
                                 Padding="9,3"
                                 VerticalContentAlignment="Center"
                                 LostKeyboardFocus="OnSettingEditorLostKeyboardFocus"
                                 TextChanged="OnTextSettingChanged"
                                 Text="{Binding ScreenshotHistoryLimitText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox"
                                       BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding KeepAllScreenshotHistory}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                            <Setter Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBlock Grid.Column="5"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource GeneralFieldLabel}"
                                   Text="张（1-100）" />
                        <CheckBox x:Name="KeepAllScreenshotHistoryCheckBox"
                                  Grid.Column="6"
                                  MinHeight="30"
                                  Margin="18,0,0,0"
                                  VerticalAlignment="Center"
                                  FontSize="13"
                                  Foreground="{DynamicResource AppTextPrimaryBrush}"
                                  IsChecked="{Binding KeepAllScreenshotHistory}"
                                  Checked="OnImmediateSettingChanged"
                                  Unchecked="OnImmediateSettingChanged"
                                  Content="全部保留" />
                    </Grid>
                    <TextBlock Margin="0,7,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="截图历史会保存本地缓存。保留越多，占用的硬盘空间和缩略图内存越多，打开历史窗口也可能稍慢。" />

                    <TextBlock Margin="0,17,0,0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Text="录屏历史" />
                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource GeneralFieldLabel}"
                                   Text="保留" />
                        <TextBox x:Name="VideoHistoryRetentionDaysTextBox"
                                 Grid.Column="1"
                                 Width="72"
                                 Height="34"
                                 Margin="8,0"
                                 MaxLength="4"
                                 Padding="9,3"
                                 VerticalContentAlignment="Center"
                                 LostKeyboardFocus="OnSettingEditorLostKeyboardFocus"
                                 TextChanged="OnTextSettingChanged"
                                 Text="{Binding VideoHistoryRetentionDaysText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox"
                                       BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding KeepAllVideoHistory}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                            <Setter Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource GeneralFieldLabel}"
                                   Text="天" />
                        <TextBlock Grid.Column="3"
                                   Margin="18,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource GeneralFieldLabel}"
                                   Text="最多保留" />
                        <TextBox x:Name="VideoHistoryLimitTextBox"
                                 Grid.Column="4"
                                 Width="72"
                                 Height="34"
                                 Margin="8,0"
                                 MaxLength="3"
                                 Padding="9,3"
                                 VerticalContentAlignment="Center"
                                 LostKeyboardFocus="OnSettingEditorLostKeyboardFocus"
                                 TextChanged="OnTextSettingChanged"
                                 Text="{Binding VideoHistoryLimitText, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.Style>
                                <Style TargetType="TextBox"
                                       BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Setter Property="IsEnabled" Value="True" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding KeepAllVideoHistory}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                            <Setter Property="Opacity" Value="0.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBlock Grid.Column="5"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource GeneralFieldLabel}"
                                   Text="个（1-100）" />
                        <CheckBox x:Name="KeepAllVideoHistoryCheckBox"
                                  Grid.Column="6"
                                  MinHeight="30"
                                  Margin="18,0,0,0"
                                  VerticalAlignment="Center"
                                  FontSize="13"
                                  Foreground="{DynamicResource AppTextPrimaryBrush}"
                                  IsChecked="{Binding KeepAllVideoHistory}"
                                  Checked="OnImmediateSettingChanged"
                                  Unchecked="OnImmediateSettingChanged"
                                  Content="全部保留" />
                    </Grid>
                    <TextBlock Margin="0,7,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource AppDangerBrush}"
                               TextWrapping="Wrap"
                               Text="自动清理录屏历史会直接删除视频保存目录中的本地录屏文件，删除后无法在应用内恢复。" />
                    <TextBlock Margin="0,5,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="录屏通常占用较多硬盘空间；保留数量越多，历史列表扫描和加载时间也会增加。" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="HotKeySettingsPanel"
                          Grid.Row="0"
                          Grid.RowSpan="2"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <StackPanel>
                    <TextBlock FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Text="快捷键" />
                    <TextBlock Margin="0,7,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="支持键盘组合、单独 F1-F24 / PrintScreen / 小键盘数字键和鼠标键；左/中/右键（含修饰键组合）需长按触发，短按和拖动保持原操作" />

                    <StackPanel Margin="0,25,0,0">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   Text="区域截图" />
                        <Grid Margin="0,8,16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:HotKeyCaptureBox x:Name="RegionCaptureHotKeyBox"
                                                    Height="34"
                                                    Padding="10,3"
                                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                                    GotKeyboardFocus="OnHotKeyCaptureGotKeyboardFocus"
                                                    HotKeyCaptured="OnHotKeyCaptured"
                                                    HotKeyCaptureCanceled="OnHotKeyCaptureCanceled"
                                                    LostKeyboardFocus="OnHotKeyCaptureLostKeyboardFocus"
                                                    Tag="RegionCaptureHotKey"
                                                    Text="{Binding RegionCaptureHotKey}"
                                                    TextAlignment="Center"
                                                    ToolTip="单击后按下键盘或鼠标按键" />
                            <Button Grid.Column="1"
                                    Width="68"
                                    Margin="8,0,0,0"
                                    Click="OnBeginHotKeyEditClick"
                                    Content="修改"
                                    Style="{StaticResource SecondaryButton}"
                                    Tag="RegionCaptureHotKeyBox"
                                    ToolTip="修改区域截图快捷键" />
                            <Button Grid.Column="2"
                                    Width="34"
                                    Margin="6,0,0,0"
                                    Click="OnClearHotKeyClick"
                                    Style="{StaticResource SecondaryButton}"
                                    Tag="RegionCaptureHotKeyBox"
                                    ToolTip="不设置区域截图快捷键">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE74D;" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel Margin="0,17,0,0">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   Text="完成截图" />
                        <TextBlock Margin="0,4,16,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   TextWrapping="Wrap"
                               Text="默认使用 Ctrl+C；填写其他快捷键后会替换 Ctrl+C。仅在截图框选完成、底部工具栏显示后生效，用于完成当前截图并复制。支持键盘组合或单独一个英文字母。" />
                        <Grid Margin="0,8,16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:HotKeyCaptureBox x:Name="CompleteCaptureHotKeyBox"
                                                    Height="34"
                                                    Padding="10,3"
                                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                                    GotKeyboardFocus="OnHotKeyCaptureGotKeyboardFocus"
                                                    HotKeyCaptured="OnHotKeyCaptured"
                                                    HotKeyCaptureCanceled="OnHotKeyCaptureCanceled"
                                                    LostKeyboardFocus="OnHotKeyCaptureLostKeyboardFocus"
                                                    Tag="CompleteCaptureHotKey"
                                                    Text="{Binding CompleteCaptureHotKey}"
                                                    TextAlignment="Center"
                                                    ToolTip="单击后按下要用于完成当前截图的快捷键" />
                            <Button Grid.Column="1"
                                    Width="68"
                                    Margin="8,0,0,0"
                                    Click="OnBeginHotKeyEditClick"
                                    Content="修改"
                                    Style="{StaticResource SecondaryButton}"
                                    Tag="CompleteCaptureHotKeyBox"
                                    ToolTip="修改完成截图快捷键" />
                            <Button Grid.Column="2"
                                    Width="34"
                                    Margin="6,0,0,0"
                                    Click="OnClearHotKeyClick"
                                    Style="{StaticResource SecondaryButton}"
                                    Tag="CompleteCaptureHotKeyBox"
                                    ToolTip="不设置完成截图快捷键">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE74D;" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel Margin="0,17,0,0">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   Text="视频录制" />
                        <Grid Margin="0,8,16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:HotKeyCaptureBox x:Name="VideoRecordingHotKeyBox"
                                                    Height="34"
                                                    Padding="10,3"
                                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                                    GotKeyboardFocus="OnHotKeyCaptureGotKeyboardFocus"
                                                    HotKeyCaptured="OnHotKeyCaptured"
                                                    HotKeyCaptureCanceled="OnHotKeyCaptureCanceled"
                                                    LostKeyboardFocus="OnHotKeyCaptureLostKeyboardFocus"
                                                    Tag="VideoRecordingHotKey"
                                                    Text="{Binding VideoRecordingHotKey}"
                                                    TextAlignment="Center"
                                                    ToolTip="单击后按下键盘或鼠标按键" />
                            <Button Grid.Column="1"
                                    Width="68"
                                    Margin="8,0,0,0"
                                    Click="OnBeginHotKeyEditClick"
                                    Content="修改"
                                    Style="{StaticResource SecondaryButton}"
                                    Tag="VideoRecordingHotKeyBox"
                                    ToolTip="修改视频录制快捷键" />
                            <Button Grid.Column="2"
                                    Width="34"
                                    Margin="6,0,0,0"
                                    Click="OnClearHotKeyClick"
                                    Style="{StaticResource SecondaryButton}"
                                    Tag="VideoRecordingHotKeyBox"
                                    ToolTip="不设置视频录制快捷键">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE74D;" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel Margin="0,17,0,0">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   Text="结束录制" />
                        <TextBlock Margin="0,4,16,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   TextWrapping="Wrap"
                                   Text="录制过程中触发此快捷键会保存并结束当前视频，默认 Alt+2。" />
                        <Grid Margin="0,8,16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:HotKeyCaptureBox x:Name="EndVideoRecordingHotKeyBox"
                                                    Height="34"
                                                    Padding="10,3"
                                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                                    GotKeyboardFocus="OnHotKeyCaptureGotKeyboardFocus"
                                                    HotKeyCaptured="OnHotKeyCaptured"
                                                    HotKeyCaptureCanceled="OnHotKeyCaptureCanceled"
                                                    LostKeyboardFocus="OnHotKeyCaptureLostKeyboardFocus"
                                                    Tag="EndVideoRecordingHotKey"
                                                    Text="{Binding EndVideoRecordingHotKey}"
                                                    TextAlignment="Center"
                                                    ToolTip="单击后按下结束录制快捷键" />
                            <Button Grid.Column="1"
                                    Width="68"
                                    Margin="8,0,0,0"
                                    Click="OnBeginHotKeyEditClick"
                                    Content="修改"
                                    Style="{StaticResource SecondaryButton}"
                                    Tag="EndVideoRecordingHotKeyBox"
                                    ToolTip="修改结束录制快捷键" />
                            <Button Grid.Column="2"
                                    Width="34"
                                    Margin="6,0,0,0"
                                    Click="OnClearHotKeyClick"
                                    Style="{StaticResource SecondaryButton}"
                                    Tag="EndVideoRecordingHotKeyBox"
                                    ToolTip="不设置结束录制快捷键">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE74D;" />
                            </Button>
                        </Grid>
                    </StackPanel>

                    <StackPanel Margin="0,17,0,0">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   Text="翻译" />
                        <Grid Margin="0,8,16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:HotKeyCaptureBox x:Name="OcrHotKeyBox"
                                                    Height="34"
                                                    Padding="10,3"
                                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                                    GotKeyboardFocus="OnHotKeyCaptureGotKeyboardFocus"
                                                    HotKeyCaptured="OnHotKeyCaptured"
                                                    HotKeyCaptureCanceled="OnHotKeyCaptureCanceled"
                                                    LostKeyboardFocus="OnHotKeyCaptureLostKeyboardFocus"
                                                    Tag="OcrHotKey"
                                                    Text="{Binding OcrHotKey}"
                                                    TextAlignment="Center"
                                                    ToolTip="单击后按下键盘或鼠标按键" />
                            <Button Grid.Column="1"
                                    Width="68"
                                    Margin="8,0,0,0"
                                    Click="OnBeginHotKeyEditClick"
                                    Content="修改"
