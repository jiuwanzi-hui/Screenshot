                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   Text="翻译优先顺序" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   Text="按序号从上到下尝试；离线优先仍允许失败后使用在线备用。仅需离线时，请取消在线模型列表中的启用勾选。结果会说明实际使用的模型和切换原因。"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,6,0,0" Text="拖动条目调整顺序，松手自动保存；也可选中后按 Alt+↑ / ↓。"
                                   FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" />
                        <ItemsControl x:Name="TranslationPriorityList" Margin="0,10,0,0"
                                      ItemsSource="{Binding TranslationPriorityItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,7"
                                            Padding="12,7"
                                            BorderThickness="0,0,0,1"
                                            CornerRadius="0"
                                            ToolTip="{Binding AvailabilityReason}"
                                            Cursor="SizeAll" Focusable="True" AllowDrop="True"
                                            PreviewKeyDown="OnTranslationPriorityKeyDown"
                                            PreviewMouseLeftButtonDown="OnTranslationProfileRowPreviewMouseLeftButtonDown"
                                            PreviewMouseMove="OnTranslationProfileRowPreviewMouseMove"
                                            DragOver="OnTranslationProfileRowDragOver"
                                            DragLeave="OnTranslationProfileRowDragLeave"
                                            Drop="OnTranslationProfileRowDrop">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource AppSubtleBorderBrush}" />
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="24"
                                                    Height="24"
                                                    VerticalAlignment="Center"
                                                    CornerRadius="4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background"
                                                                Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAvailable}"
                                                                         Value="True">
                                                                <Setter Property="Background"
                                                                        Value="{DynamicResource AppAccentMutedBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Position}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource AppTextSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAvailable}"
                                                                             Value="True">
                                                                    <Setter Property="Foreground"
                                                                            Value="{DynamicResource AppAccentTextBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center"
                                                           Text="{Binding Label}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource AppTextSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAvailable}"
                                                                             Value="True">
                                                                    <Setter Property="Foreground"
                                                                            Value="{DynamicResource AppTextPrimaryBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <Border Grid.Column="2"
                                                    Margin="8,0,10,0"
                                                    Padding="7,2"
                                                    VerticalAlignment="Top"
                                                    CornerRadius="4"
                                                    ToolTip="{Binding AvailabilityReason}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background"
                                                                Value="Transparent" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAvailable}"
                                                                         Value="True">
                                                                <Setter Property="Background"
                                                                        Value="{DynamicResource AppAccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="11"
                                                           Text="{Binding AvailabilityLabel}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource AppTextSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAvailable}"
                                                                             Value="True">
                                                                    <Setter Property="Foreground"
                                                                            Value="{DynamicResource AppOnAccentBrush}" />
                                                                    <Setter Property="FontWeight"
                                                                            Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <TextBlock Grid.Column="3" Text="⠿" FontSize="22" Width="30"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}" ToolTip="拖动调整优先顺序" />
                                            <Border x:Name="TranslationProfileDropMarker" Grid.ColumnSpan="4"
                                                    Height="3" Panel.ZIndex="2" IsHitTestVisible="False"
                                                    Background="{DynamicResource AppAccentBrush}" Visibility="Collapsed" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   Text="在线项被尝试时，只会发送识别出的文字，不会上传截图图片。"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="TranslationTargetLanguagePanel"
                                Margin="0,18,0,0">
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                   Text="目标语言" />
                        <ComboBox x:Name="TranslationTargetLanguageComboBox"
                                  Margin="0,8,0,0"
                                  DisplayMemberPath="Label"
                                  ItemsSource="{Binding TranslationTargetLanguageOptions}"
                                  PreviewMouseWheel="OnTranslationSettingPreviewMouseWheel"
                                  SelectedValue="{Binding TranslationTargetLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Value"
                                  SelectionChanged="OnImmediateSettingChanged" />
                    </StackPanel>

                    <StackPanel x:Name="OnlineTranslationSettingsPanel"
                                Margin="0,18,0,0"
                                Visibility="Collapsed">
                        <Border Padding="14,11"
                                Background="{DynamicResource AppPanelBackgroundBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <TextBlock Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       Text="识别出的文字会发送给你配置的在线服务；截图图片本身不会上传。"
                                       TextWrapping="Wrap" />
                        </Border>

                        <StackPanel Margin="0,17,0,0">
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       Text="服务类型" />
                            <ComboBox x:Name="TranslationProviderComboBox"
                                      Margin="0,8,0,0"
                                      DisplayMemberPath="Label"
                                      ItemsSource="{Binding TranslationProviderOptions}"
                                      PreviewMouseWheel="OnTranslationSettingPreviewMouseWheel"
                                      SelectedValue="{Binding TranslationProvider, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Value"
                                      SelectionChanged="OnTranslationProviderSelectionChanged"
                                      ToolTip="自定义兼容接口排在第一项；内置厂商会显示其官方兼容地址" />
                        </StackPanel>

                        <StackPanel Margin="0,17,0,0">
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       Text="兼容接口地址" />
                            <TextBox x:Name="TranslationEndpointTextBox"
                                     Height="34"
                                     Margin="0,8,0,0"
                                     Padding="10,3"
                                     VerticalContentAlignment="Center"
                                     BorderBrush="{DynamicResource AppBorderBrush}"
                                     LostKeyboardFocus="OnSettingEditorLostKeyboardFocus"
                                     PreviewMouseWheel="OnTranslationSettingPreviewMouseWheel"
                                     TextChanged="OnTextSettingChanged"
                                     Text="{Binding TranslationEndpoint, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="内置厂商会自动填入官方地址；选择自定义后可填写任意 HTTPS 兼容地址" />
                            <TextBlock x:Name="TranslationProviderOfficialSiteText"
                                       Margin="0,6,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Margin="0,17,0,0">
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       Text="模型名称" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="TranslationModelComboBox"
                                          Grid.Column="0"
                                          IsEditable="True"
                                          ItemsSource="{Binding TranslationModelOptions}"
                                          LostKeyboardFocus="OnSettingEditorLostKeyboardFocus"
                                          PreviewMouseWheel="OnTranslationSettingPreviewMouseWheel"
                                          SelectionChanged="OnImmediateSettingChanged"
                                          Text="{Binding TranslationModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          ToolTip="可以获取厂家模型，也可以手动输入模型标识" />
                                <Button x:Name="FetchTranslationModelsButton"
                                        Grid.Column="1"
                                        MinWidth="94"
                                        Margin="8,0,0,0"
                                        Padding="12,3"
                                        Click="OnFetchTranslationModelsClick"
                                        Content="获取模型"
                                        ToolTip="使用当前服务地址和 API Key 获取模型列表；服务不开放列表时请手动输入并测试模型" />
                                <Button x:Name="TestTranslationModelButton"
                                        Grid.Column="2"
                                        MinWidth="82"
                                        Margin="8,0,0,0"
                                        Padding="12,3"
                                        Click="OnTestTranslationModelClick"
                                        Content="测试模型"
                                        ToolTip="用当前模型发送一条最小请求，确认模型是否真正可用" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Margin="0,17,0,8">
                            <TextBlock FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       Text="API Key" />
                            <PasswordBox x:Name="TranslationApiKeyBox"
                                         Height="34"
                                         Margin="0,8,0,0"
                                         Padding="10,3"
                                         VerticalContentAlignment="Center"
                                         BorderBrush="{DynamicResource AppBorderBrush}"
                                         LostKeyboardFocus="OnTranslationApiKeyLostKeyboardFocus"
                                         PasswordChanged="OnTranslationApiKeyPasswordChanged"
                                         PreviewMouseWheel="OnTranslationSettingPreviewMouseWheel"
                                         ToolTip="仅加密保存在当前 Windows 用户下" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="OfflineTranslationSettingsPanel"
                                Margin="0,18,0,8">
                        <Border Padding="16"
                                Background="{DynamicResource AppPanelBackgroundBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel>
                                <TextBlock FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                           Text="多语言离线模型" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           Text="源语言由本地语言检测器自动识别。下载当前目标语言包后，可把全部受支持源语言翻译成目标语言；非英语语言之间自动经 English 中转。"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,12,0,0"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                           Text="翻译精度" />
                                <ComboBox x:Name="OfflineTranslationQualityComboBox"
                                          Margin="0,7,0,0"
                                          DisplayMemberPath="Label"
                                          ItemsSource="{Binding OfflineTranslationQualityOptions}"
                                          PreviewMouseWheel="OnTranslationSettingPreviewMouseWheel"
                                          SelectedValue="{Binding OfflineTranslationQuality, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Value"
                                          SelectionChanged="OnImmediateSettingChanged" />
                                <TextBlock Margin="0,6,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           Text="高质量与超高质量会增加 CPU 用量和等待时间，但无需重复下载模型；可翻译范围仍以 Mozilla 当前支持的语言为准。"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="OfflineModelRouteText"
                                           Margin="0,9,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="OfflineModelStatusText"
                                           Margin="0,9,0,0"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppAccentTextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock x:Name="OfflineModelPathText"
                                           Margin="0,5,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                                <ProgressBar x:Name="OfflineModelDownloadProgressBar"
                                             Height="6"
                                             Margin="0,13,0,0"
                                             Maximum="100"
                                             Visibility="Collapsed" />
                                <TextBlock x:Name="OfflineModelDownloadProgressText"
                                           Margin="0,5,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           Visibility="Collapsed" />
                                <StackPanel Margin="0,14,0,0"
                                            Orientation="Horizontal">
                                    <Button x:Name="DownloadOfflineModelButton"
                                            MinWidth="116"
                                            Padding="14,5"
                                            Click="OnDownloadOfflineModelClick"
                                            Content="下载目标语言包" />
                                    <Button Margin="8,0,0,0"
                                            Padding="14,5"
                                            Click="OnOpenOfflineModelDirectoryClick"
                                            Content="打开目录" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,12,0,0"
                                Padding="16"
                                Background="{DynamicResource AppPanelBackgroundBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                           x:Name="LocalLargeModelTitleText" Text="TranslateGemma 4B · 离线多语言翻译" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           x:Name="LocalLargeModelDescriptionText" Text="离线多语言翻译；首次加载及长文本取决于电脑性能。" />
                                <TextBlock Margin="0,6,0,0"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           x:Name="LocalLargeModelCleanupText" Text="保留多语言离线语言包与文字识别模型。" />
                                <TextBlock x:Name="LocalLargeModelStatusText"
                                           Margin="0,10,0,0"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppAccentTextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,6,0,0" FontSize="12"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"
                                           Text="模型优先使用魔搭国内源，失败自动换源并续传。Windows 安装包附带推理组件；无法联网时可导入当前版本的 GGUF 模型或 ZIP 推理组件。" />
                                <TextBlock x:Name="LocalLargeModelPathText"
                                           Margin="0,5,0,0"
                                           FontSize="12"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                                <ProgressBar x:Name="LocalLargeModelDownloadProgressBar"
                                             Height="6"
                                             Margin="0,13,0,0"
                                             Maximum="100"
                                             Visibility="Collapsed" />
                                <TextBlock x:Name="LocalLargeModelDownloadProgressText"
                                           Margin="0,5,0,0"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           Visibility="Collapsed" />
                                <StackPanel Margin="0,14,0,0"
                                            Orientation="Horizontal">
                                    <Button x:Name="DownloadLocalLargeModelButton"
                                            MinWidth="126"
                                            Padding="14,5"
                                            Click="OnDownloadLocalLargeModelClick"
                                            Content="下载多语言模型" />
                                    <Button x:Name="ImportLocalLargeModelButton" Margin="8,0,0,0"
                                            Padding="14,5" Click="OnImportLocalLargeModelClick"
                                            Content="导入本地文件" />
                                    <Button Margin="8,0,0,0"
                                            Padding="14,5"
                                            Click="OnOpenLocalLargeModelDirectoryClick"
                                            Content="打开目录" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,14,0,0"
                                   FontSize="12"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                    Text="语言检测：CLD3（完全本地） · 翻译引擎：Bergamot Translator（MPL-2.0） · 模型：Mozilla Firefox Translations 模型清单（优先正式版）"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="UpdateSettingsPanel"
                          Grid.Row="0"
                          Grid.RowSpan="2"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <StackPanel Margin="0,0,16,0">
                    <TextBlock FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Text="版本更新" />
                    <TextBlock Margin="0,7,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Text="自动选择 Gitee / GitHub 并校验最新正式版本" />

                    <Border Margin="0,26,0,0"
                            Padding="20"
                            Background="{DynamicResource AppPanelBackgroundBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                                               Text="SnapCut" />
                                    <TextBlock x:Name="CurrentVersionText"
                                               TextWrapping="Wrap"
                                               Margin="0,7,0,0"
                                               FontSize="14"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                </StackPanel>
                                <Button x:Name="CheckForUpdatesButton"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Click="OnCheckForUpdatesClick"
                                        Content="检查更新"
                                        Style="{StaticResource SecondaryButton}" />
                            </Grid>
                            <TextBlock x:Name="UpdateStatusText"
                                       Margin="0,18,0,0"
                                       FontSize="13"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       Text="点击“检查更新”自动选择可用的 Gitee / GitHub 更新源。"
                                       TextWrapping="Wrap" />
                            <ProgressBar x:Name="UpdateProgressBar"
                                         Height="5"
                                         Margin="0,12,0,0"
                                         Maximum="100"
                                         Visibility="Collapsed" />
                            <Button x:Name="InstallUpdateButton"
                                    Margin="0,14,0,0"
                                    HorizontalAlignment="Left"
                                    Click="OnInstallUpdateClick"
                                    Content="下载并更新"
                                    Style="{StaticResource PrimaryButton}"
                                    Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <Separator Margin="0,24,0,18"
                               Background="{DynamicResource AppSeparatorBrush}" />

                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Text="历史正式版本" />
                    <TextBlock x:Name="ReleaseHistoryStatusText"
                               Margin="0,6,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Text="打开此页面后会自动读取发布时间和更新内容。"
                               TextWrapping="Wrap" />

                    <TextBlock Margin="0,15,0,0"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Text="选择要查看或回退的版本" />
                    <ComboBox x:Name="ReleaseHistorySelector"
                              Height="42"
                              Margin="0,8,0,0"
                              Padding="12,0,42,0"
                              FontSize="13"
                              SelectionChanged="OnReleaseHistorySelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayText}"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Border x:Name="SelectedReleaseDetailsPanel"
                            Margin="0,14,0,0"
                            Padding="20"
                            Background="{DynamicResource AppPanelBackgroundBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Visibility="Collapsed">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SelectedReleaseTitleText"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                           TextWrapping="Wrap" />
                                <Border Grid.Column="1"
                                        Margin="12,0,0,0"
                                        Padding="9,3"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource AppAccentMutedBrush}"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9">
                                    <TextBlock x:Name="SelectedReleaseStateText"
                                               FontSize="12"
                                               Foreground="{DynamicResource AppAccentForegroundBrush}" />
                                </Border>
                            </Grid>
                            <TextBlock x:Name="SelectedReleaseDateText"
                                       Margin="0,5,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                            <TextBlock Margin="0,15,0,0"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       Text="更新内容" />
                            <TextBlock x:Name="SelectedReleaseNotesText"
                                       Margin="0,7,0,0"
                                       FontSize="13"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       LineHeight="21"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="SelectedReleasePackageStatusText"
                                       Margin="0,15,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <StackPanel Margin="0,14,0,0"
                                        Orientation="Horizontal">
                                <Button x:Name="SelectedReleaseActionButton"
                                        Click="OnInstallSelectedReleaseClick"
                                        Content="回退到所选版本"
                                        Style="{StaticResource PrimaryButton}"
                                        Visibility="Collapsed" />
                                <Button Margin="8,0,0,0"
                                        Click="OnOpenSelectedReleasePageClick"
                                        Content="查看发布页"
                                        Style="{StaticResource SecondaryButton}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,18,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Text="更新包会校验文件大小和 SHA-256。覆盖更新不会删除 ScreenshotData 中的设置、历史和截图。"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="DonateSettingsPanel"
                          Grid.Row="0"
                          Grid.RowSpan="2"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <StackPanel Margin="0,0,16,0">
                    <TextBlock FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Text="打赏支持" />
                    <TextBlock Margin="0,7,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Text="源码公开与长期维护不易，感谢每一份支持。你的鼓励会用于后续功能升级和 macOS 版本开发。"
                               TextWrapping="Wrap" />

                    <Border x:Name="CreatorProfileGlowHost"
                            Background="{DynamicResource AppSubtleBorderBrush}"
                            Margin="0,22,0,0"
                            Padding="2"
                            CornerRadius="10"
                            MouseEnter="OnCreatorProfileMouseEnter"
                            MouseLeave="OnCreatorProfileMouseLeave"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="CreatorProfileScale" ScaleX="1" ScaleY="1" />
                                <TranslateTransform x:Name="CreatorProfileTranslate" X="0" Y="0" />
                            </TransformGroup>
                        </Border.RenderTransform>

                        <Border x:Name="CreatorProfileCard"
                                Padding="18"
                                Background="{DynamicResource AppPanelBackgroundBrush}"
                                CornerRadius="8"
                                ClipToBounds="True">
                            <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="64"
                                             Height="64"
                                             VerticalAlignment="Center"
                                             Stroke="{DynamicResource AppAccentBrush}"
                                             StrokeThickness="2">
                                        <Ellipse.Fill>
                                            <ImageBrush x:Name="CreatorAvatarBrush"
                                                        Stretch="UniformToFill" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <StackPanel Grid.Column="1"
                                                Margin="14,0,18,0"
                                                VerticalAlignment="Center">
                                        <TextBlock FontSize="17"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                   Text="九万字__" />
                                        <TextBlock Margin="0,5,0,0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                   Text="SnapCut 作者 · 哔哩哔哩个人空间"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Margin="0,5,0,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                                   Text="欢迎反馈使用体验与功能建议"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2"
                                                VerticalAlignment="Center">
                                        <Button MinWidth="124"
                                                Padding="16,9"
                                                Click="OnOpenCreatorProfileClick"
                                                Content="访问 B 站主页"
                                                Style="{StaticResource SecondaryButton}"
                                                ToolTip="在默认浏览器中打开九万字__的个人空间" />
                                        <Button Margin="0,8,0,0"
                                                MinWidth="124"
                                                Padding="16,9"
                                                Click="OnOpenGithubRepositoryClick"
                                                Content="GitHub 项目"
                                                Style="{StaticResource SecondaryButton}"
                                                ToolTip="在默认浏览器中打开 SnapCut GitHub 项目" />
                                    </StackPanel>
                            </Grid>
                        </Border>
                    </Border>

                    <Border Margin="0,18,0,0"
                            Padding="24"
                            Background="{DynamicResource AppPanelBackgroundBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Border Width="238"
                                        Height="238"
                                        Padding="8"
                                        Background="White"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6">
                                    <Image x:Name="DonateQrImage"
                                           Stretch="Uniform"
                                           SnapsToDevicePixels="True" />
                                </Border>
                                <TextBlock Margin="0,10,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                           Text="微信扫码打赏" />
                            </StackPanel>
                            <StackPanel Grid.Column="1"
                                        Margin="26,2,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                           Text="多谢各位老板支持！"
                                           TextWrapping="Wrap" />
                                <TextBlock Margin="0,12,0,0"
                                           FontSize="13"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                           LineHeight="22"
                                           Text="你的支持会帮助 SnapCut 持续保持轻量、灵活和本地优先，并继续完善长截图、翻译、历史记录和鼠标快捷键等功能。"
                                           TextWrapping="Wrap" />
                                <Border Margin="0,18,0,0"
                                        Padding="12,9"
                                        Background="{DynamicResource AppAccentMutedBrush}"
                                        CornerRadius="8">
                                    <TextBlock FontSize="13"
                                               Foreground="{DynamicResource AppAccentForegroundBrush}"
                                               Text="后续计划：支持 macOS"
                                               TextWrapping="Wrap" />
                                </Border>

                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Margin="0,18,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Text="打赏仅用于个人非商业项目的持续维护与开发。SnapCut 采用个人非商业许可证，详情请查看仓库中的 LICENSE。"
                               TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ContactSettingsPanel"
                          Grid.Row="0"
                          Grid.RowSpan="2"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <StackPanel Margin="0,0,16,24">
                    <TextBlock FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Text="交流联系" />
                    <TextBlock Margin="0,7,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Text="欢迎加入 SnapCut 交流群，反馈问题、交流使用技巧和功能建议。"
                               TextWrapping="Wrap" />

                    <Border Margin="0,22,0,0"
                            Padding="22"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource AppPanelBackgroundBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel>
                            <TextBlock FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       Text="微信加入交流群"
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0,7,0,0"
                                       FontSize="13"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       Text="微信搜索或添加：openems"
                                       TextWrapping="Wrap" />
                            <Border Margin="0,18,0,0"
                                    Width="360"
                                    Height="360"
                                    Padding="8"
                                    Background="White"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6">
                                <Image x:Name="CommunityQrImage"
                                       Stretch="Uniform"
                                       SnapsToDevicePixels="True" />
                            </Border>
                            <TextBlock Margin="0,12,0,0"
                                       HorizontalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       Text="扫码后按群内提示加入 SnapCut 交流群"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="CommunityQrStatusText"
                                       Margin="0,10,0,0" MaxWidth="360" FontSize="12"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <Button x:Name="CommunityQrRefreshButton" Margin="0,10,0,0"
                                    HorizontalAlignment="Center" Padding="16,6"
                                    Content="刷新二维码" Click="OnCommunityQrRefreshClick" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Margin="0,12,16,0"
                    Padding="0"
                    Background="{DynamicResource AppPanelBackgroundBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    ToolTip="{Binding StatusMessage}">
                <Grid MinHeight="38">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource AppAccentBrush}"
                            CornerRadius="5,0,0,5" />
                    <TextBlock Grid.Column="1"
                               Margin="11,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="{DynamicResource AppAccentForegroundBrush}"
                               Text="&#xE946;" />
                    <TextBlock Grid.Column="2"
                               Margin="7,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Text="日志输出" />
                    <TextBlock Grid.Column="3"
                               Margin="12,0,12,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Text="{Binding StatusMessage}"
                               TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </Grid>
      </Grid>
    </Border>
</Window>
