<Window x:Class="Screenshot.App.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Screenshot.App.Presentation"
        xmlns:core="clr-namespace:Screenshot.App.Core"
        mc:Ignorable="d"
        Icon="/SnapCut;component/Assets/Screenshot.ico"
        Title="SnapCut"
        Width="980"
        Height="820"
        MinWidth="480"
        MinHeight="360"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource AppWindowBackgroundBrush}"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Geometry x:Key="SettingsNavigationGeneralIcon">M 3,6 H 8 M 12,6 H 21 M 3,12 H 14 M 18,12 H 21 M 3,18 H 6 M 10,18 H 21 M 8,3 V 9 H 12 V 3 Z M 14,9 V 15 H 18 V 9 Z M 6,15 V 21 H 10 V 15 Z</Geometry>
        <Geometry x:Key="SettingsNavigationHotkeyIcon">M 5,5 H 19 Q 22,5 22,8 V 17 Q 22,20 19,20 H 5 Q 2,20 2,17 V 8 Q 2,5 5,5 Z M 6,9 H 7 M 11,9 H 12 M 16,9 H 17 M 6,13 H 7 M 11,13 H 12 M 16,13 H 17 M 7,17 H 17</Geometry>
        <Geometry x:Key="SettingsNavigationOcrIcon">M 3,8 V 4 Q 3,3 4,3 H 8 M 16,3 H 20 Q 21,3 21,4 V 8 M 21,16 V 20 Q 21,21 20,21 H 16 M 8,21 H 4 Q 3,21 3,20 V 16 M 8,8 H 16 M 12,8 V 16 M 9,16 H 15</Geometry>
        <Geometry x:Key="SettingsNavigationTranslateIcon">M 2,5 H 14 M 8,2 V 5 M 5,5 C 6,10 9,13 13,15 M 12,5 C 11,10 7,14 3,16 M 13,21 L 17,11 L 21,21 M 14.5,17 H 19.5</Geometry>
        <Geometry x:Key="SettingsNavigationUpdateIcon">M 12,22 A 10,10 0 1 1 12,2 A 10,10 0 1 1 12,22 M 12,17 V 7 M 7,12 L 12,7 L 17,12</Geometry>
        <Geometry x:Key="SettingsNavigationDonateIcon">M 12,21 L 3.8,13 C -2,7 5,-1 12,6 C 19,-1 26,7 20.2,13 Z</Geometry>
        <Geometry x:Key="SettingsNavigationContactIcon">M 21,11.5 C 21,17 17,21 11.5,21 C 9,21 7,20 5.5,19 L 2,21 L 3.5,16.5 C 2.5,15 2,13.5 2,11.5 C 2,6 6,2 11.5,2 C 17,2 21,6 21,11.5 Z M 7,11.5 H 7.1 M 11.5,11.5 H 11.6 M 16,11.5 H 16.1</Geometry>
        <Style x:Key="SettingsNavigationIcon" TargetType="Path">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Background" Value="{DynamicResource AppPanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppControlEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AppControlForegroundBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SecondaryButtonSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource AppControlCornerRadius}">
                            <Grid>
                                <Border x:Name="SecondaryButtonLight" Margin="1" BorderThickness="1" BorderBrush="{DynamicResource AppControlHighlightBrush}"
                                        Background="{DynamicResource AppControlReflectionBrush}"
                                        CornerRadius="{DynamicResource AppControlCornerRadius}" IsHitTestVisible="False" />
                                <local:LiquidGlassLens Visibility="{DynamicResource AppLiquidLensVisibility}" IsEmphasized="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SecondaryButtonSurface" Property="BorderBrush" Value="{DynamicResource AppSelectedEdgeBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SecondaryButtonLight" Property="Opacity" Value="0.3" />
                                <Setter TargetName="SecondaryButtonSurface" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="NavigationItem" TargetType="ListBoxItem">
            <Setter Property="local:SelectionMotion.SurfaceName" Value="NavigationBackground" />
            <Setter Property="local:SelectionMotion.ThemeVisibility" Value="{DynamicResource AppSelectionMotionVisibility}" />
            <Setter Property="local:SelectionMotion.Fill" Value="{DynamicResource AppAccentMutedBrush}" />
            <Setter Property="local:SelectionMotion.Edge" Value="{DynamicResource AppSelectedEdgeBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource AppNavigationForegroundBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border x:Name="NavigationSeparator" Height="1" Margin="4,13,4,13" Background="{DynamicResource AppBorderBrush}" Opacity="0.65" Visibility="Collapsed" IsHitTestVisible="False" />
                        <Border x:Name="NavigationBackground" Grid.Row="1"
                                Background="Transparent"
                                CornerRadius="{DynamicResource AppControlCornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border><Border x:Name="NavigationAccent" Grid.Row="1" Width="3" HorizontalAlignment="Left" Margin="0,5" CornerRadius="1.5" Background="{DynamicResource SelectionBorderBrush}" Visibility="Collapsed" /></Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Maintenance"><Setter TargetName="NavigationSeparator" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="NavigationAccent" Property="Visibility" Value="Visible" />
                                <Setter TargetName="NavigationBackground" Property="Background" Value="{DynamicResource AppAccentMutedBrush}" />
                                <Setter TargetName="NavigationBackground" Property="BorderBrush" Value="{DynamicResource AppSelectedEdgeBrush}" />
                                <Setter TargetName="NavigationBackground" Property="BorderThickness" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource AppAccentForegroundBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="local:SelectionMotion.IsHosted" Value="True" />
                                    <Condition Property="IsSelected" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="NavigationBackground" Property="Background" Value="Transparent" />
                                <Setter TargetName="NavigationBackground" Property="BorderBrush" Value="Transparent" />
                                <Setter TargetName="NavigationAccent" Property="Visibility" Value="Collapsed" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThemeOptionButton" TargetType="RadioButton">
            <Setter Property="local:SelectionMotion.SurfaceName" Value="ThemeOptionBorder" />
            <Setter Property="local:SelectionMotion.ThemeVisibility" Value="{DynamicResource AppSelectionMotionVisibility}" />
            <Setter Property="local:SelectionMotion.Fill" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="local:SelectionMotion.Edge" Value="{DynamicResource AppSelectedEdgeBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="Background" Value="{DynamicResource AppPanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppControlEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AppControlForegroundBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ThemeOptionBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource AppControlCornerRadius}">
                            <Grid>
                                <Border Margin="1" BorderThickness="1" BorderBrush="{DynamicResource AppControlHighlightBrush}"
                                        CornerRadius="{DynamicResource AppControlCornerRadius}" IsHitTestVisible="False" />
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ThemeOptionBorder" Property="Background" Value="{DynamicResource AppAccentBrush}" />
                                <Setter TargetName="ThemeOptionBorder" Property="BorderBrush" Value="{DynamicResource AppSelectedEdgeBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AppOnAccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThemeOptionBorder" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="local:SelectionMotion.IsHosted" Value="True" />
                                    <Condition Property="IsChecked" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ThemeOptionBorder" Property="Background" Value="Transparent" />
                                <Setter TargetName="ThemeOptionBorder" Property="BorderBrush" Value="Transparent" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThemeCardButton" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="MinHeight" Value="76" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Background" Value="{DynamicResource AppPanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppControlEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AppControlForegroundBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="ThemeCardSurface"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource AppControlCornerRadius}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <Border Margin="2" BorderThickness="1" BorderBrush="{DynamicResource AppControlHighlightBrush}"
                                    CornerRadius="{DynamicResource AppControlCornerRadius}" IsHitTestVisible="False" />
                            <local:LiquidGlassLens Visibility="{DynamicResource AppLiquidLensVisibility}" IsEmphasized="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Border x:Name="ThemeSelectedBadge"
                                    Width="20"
                                    Height="20"
                                    Margin="0,7,7,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource AppAccentBrush}"
                                    CornerRadius="10"
                                    Visibility="Collapsed">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="10"
                                           Foreground="{DynamicResource AppOnAccentBrush}"
                                           Text="&#xE73E;" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThemeCardSurface"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AppAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AppSelectedControlForegroundBrush}" />
                                <Setter TargetName="ThemeCardSurface"
                                        Property="Background"
                                        Value="{DynamicResource AppAccentMutedBrush}" />
                                <Setter TargetName="ThemeCardSurface"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AppSelectedEdgeBrush}" />
                                <Setter TargetName="ThemeCardSurface"
                                        Property="BorderThickness"
                                        Value="2" />
                                <Setter TargetName="ThemeSelectedBadge"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GeneralGroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
        </Style>
        <Style x:Key="GeneralGroupDescription" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
        </Style>
        <Style x:Key="GeneralFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
        </Style>
        <Style x:Key="GeneralGroupSeparator" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,24,0,22" />
            <Setter Property="Background" Value="{DynamicResource AppSeparatorBrush}" />
            <Setter Property="Opacity" Value="0.82" />
        </Style>
        <Style x:Key="MouseDurationSlider" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="28" Background="Transparent">
                            <Track x:Name="PART_Track"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}"
                                   IsDirectionReversed="False"
                                   VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                  Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="8"
                                                        Margin="0,0,-4,0"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource AppAccentBrush}"
                                                        CornerRadius="4" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="24"
                                           Height="24"
                                           Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="24" Height="24">
                                                    <Border x:Name="ThumbHalo"
                                                            Background="{DynamicResource AppAccentBrush}"
                                                            CornerRadius="12"
                                                            Opacity="0.18" />
                                                    <Border x:Name="ThumbCore"
                                                            Width="18"
                                                            Height="18"
                                                            Background="{DynamicResource AppAccentBrush}"
                                                            BorderBrush="#F4FFFFFF"
                                                            BorderThickness="2"
                                                            CornerRadius="9"
                                                            SnapsToDevicePixels="True" />
                                                    <Ellipse Width="5"
                                                             Height="5"
                                                             Fill="#F7FFFFFF"
                                                             IsHitTestVisible="False" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbHalo"
                                                                Property="Opacity"
                                                                Value="0.34" />
                                                        <Setter TargetName="ThumbCore"
                                                                Property="Width"
                                                                Value="20" />
                                                        <Setter TargetName="ThumbCore"
                                                                Property="Height"
                                                                Value="20" />
                                                        <Setter TargetName="ThumbCore"
                                                                Property="CornerRadius"
                                                                Value="10" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbHalo"
                                                                Property="Opacity"
                                                                Value="0.48" />
                                                        <Setter TargetName="ThumbCore"
                                                                Property="Width"
                                                                Value="16" />
                                                        <Setter TargetName="ThumbCore"
                                                                Property="Height"
                                                                Value="16" />
                                                        <Setter TargetName="ThumbCore"
                                                                Property="CornerRadius"
                                                                Value="8" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                  Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="8"
                                                        Margin="-4,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource AppAccentMutedBrush}"
                                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                                        BorderThickness="0,1,1,1"
                                                        CornerRadius="4" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type local:HotKeyCaptureBox}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="{DynamicResource AppInputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AppControlForegroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type local:HotKeyCaptureBox}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource AppControlCornerRadius}">
                            <Grid>
                                <Border Margin="1" BorderThickness="1" BorderBrush="{DynamicResource AppControlHighlightBrush}"
                                        Background="{DynamicResource AppControlReflectionBrush}"
                                        CornerRadius="{DynamicResource AppControlCornerRadius}" IsHitTestVisible="False" />
                                <local:LiquidGlassLens Visibility="{DynamicResource AppLiquidLensVisibility}" IsEmphasized="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          Focusable="False" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Shortcut entries deliberately reuse the same dimensions and theme
             resources as the toolbar designer buttons above. -->
        <Style x:Key="ToolbarShortcutIcon" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="{DynamicResource AppInputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasShortcut}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource EditorToolbarButtonSelectedBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource EditorToolbarButtonSelectedBorderBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ToolbarShortcutCapture" TargetType="{x:Type local:HotKeyCaptureBox}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="{DynamicResource AppInputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource EditorToolbarIconBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type local:HotKeyCaptureBox}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource AppControlCornerRadius}">
                            <Grid>
                                <Border Margin="1" BorderThickness="1" BorderBrush="{DynamicResource AppControlHighlightBrush}"
                                        Background="{DynamicResource AppControlReflectionBrush}"
                                        CornerRadius="{DynamicResource AppControlCornerRadius}" IsHitTestVisible="False" />
                                <local:LiquidGlassLens Visibility="{DynamicResource AppLiquidLensVisibility}" IsEmphasized="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          Focusable="False" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasShortcut}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource EditorToolbarButtonSelectedBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource EditorToolbarButtonSelectedBorderBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SettingsSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                    <ContentPresenter VerticalAlignment="Center" />
                    <Border x:Name="SwitchTrack" Grid.Column="1" Height="25" CornerRadius="12.5" Background="{DynamicResource AppSubtleBorderBrush}">
                        <Ellipse x:Name="SwitchThumb" Width="19" Height="19" Margin="3" HorizontalAlignment="Left" Fill="White" />
                    </Border>
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource AppAccentBrush}"/>
                    <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                </Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10"
            Background="{DynamicResource AppGlassBackgroundBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            SnapsToDevicePixels="True">
      <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource AppSidebarBackgroundBrush}"
                BorderBrush="{DynamicResource AppSubtleBorderBrush}"
                BorderThickness="0,0,1,0"
                CornerRadius="12,0,0,12">
            <Grid Margin="14,22,14,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Text="SnapCut" />
                    <Border Height="1"
                            Margin="0,20,0,14"
                            Background="{DynamicResource AppSeparatorBrush}" />
                </StackPanel>

                <ListBox x:Name="SettingsNavigation"
                         Grid.Row="1"
                         BorderThickness="0"
                         Background="Transparent"
                         FocusVisualStyle="{x:Null}"
                         SelectionChanged="OnSettingsNavigationSelectionChanged">
                    <ListBoxItem IsSelected="True"
                                 Style="{StaticResource NavigationItem}">
                        <Grid Height="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource SettingsNavigationGeneralIcon}"
                                  Style="{StaticResource SettingsNavigationIcon}" />
                            <TextBlock Grid.Column="1"
