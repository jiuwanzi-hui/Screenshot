                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppAccentTextBrush}"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="HighQualityOcrModelPathText"
                                       Margin="0,5,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       TextWrapping="Wrap" />
                            <ProgressBar x:Name="HighQualityOcrDownloadProgressBar"
                                         Height="6"
                                         Margin="0,13,0,0"
                                         Maximum="100"
                                         Visibility="Collapsed" />
                            <TextBlock x:Name="HighQualityOcrDownloadProgressText"
                                       Margin="0,5,0,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       Visibility="Collapsed" />
                            <StackPanel Margin="0,14,0,0"
                                        Orientation="Horizontal">
                                <Button x:Name="DownloadHighQualityOcrModelButton"
                                        MinWidth="116"
                                        Padding="14,5"
                                        Click="OnDownloadHighQualityOcrModelClick"
                                        Content="下载识别模型" />
                                <Button Margin="8,0,0,0"
                                        Padding="14,5"
                                        Click="OnOpenHighQualityOcrModelDirectoryClick"
                                        Content="打开目录" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="TranslationSettingsPanel"
