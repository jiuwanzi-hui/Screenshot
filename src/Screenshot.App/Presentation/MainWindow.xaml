                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Text="内容识别" />
                    <TextBlock Margin="0,7,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="在本机识别文字、二维码和表格；可开启框选后自动识别文字，也可下载更准确的多语言模型" />

                    <TextBlock FontSize="14"
                               Margin="0,28,0,0"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Text="识别引擎" />
                    <ComboBox x:Name="OcrEngineComboBox"
                              Margin="0,9,0,0"
                              DisplayMemberPath="Label"
