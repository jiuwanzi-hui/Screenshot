                                       VerticalAlignment="Center" />
                        </Grid>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavigationItem}">
                        <Grid Height="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource SettingsNavigationDonateIcon}"
                                  Style="{StaticResource SettingsNavigationIcon}" />
                            <TextBlock Grid.Column="1"
                                       Height="24"
                                       Margin="10,0,0,0"
                                       LineHeight="24"
                                       LineStackingStrategy="BlockLineHeight"
                                       Text="打赏支持"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavigationItem}">
                        <Grid Height="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource SettingsNavigationContactIcon}"
                                  Style="{StaticResource SettingsNavigationIcon}" />
                            <TextBlock Grid.Column="1"
                                       Height="24"
                                       Margin="10,0,0,0"
                                       LineHeight="24"
