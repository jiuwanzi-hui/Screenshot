<Window x:Class="Screenshot.App.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Screenshot.App.Presentation"
        xmlns:core="clr-namespace:Screenshot.App.Core"
        mc:Ignorable="d"
        Icon="/SnapCut;component/Assets/Screenshot.ico"
        Title="SnapCut"
        Width="780"
        Height="560"
        MinWidth="680"
        MinHeight="480"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource AppWindowBackgroundBrush}"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Geometry x:Key="SettingsNavigationGeneralIcon">M 9,1 L 10.5,1.5 L 11.1,3.1 L 12.7,3.8 L 14.2,3.1 L 15.5,4.4 L 14.8,5.9 L 15.5,7.5 L 17,8.1 V 9.9 L 15.5,10.5 L 14.8,12.1 L 15.5,13.6 L 14.2,14.9 L 12.7,14.2 L 11.1,14.9 L 10.5,16.5 H 8.5 L 7.9,14.9 L 6.3,14.2 L 4.8,14.9 L 3.5,13.6 L 4.2,12.1 L 3.5,10.5 L 2,9.9 V 8.1 L 3.5,7.5 L 4.2,5.9 L 3.5,4.4 L 4.8,3.1 L 6.3,3.8 L 7.9,3.1 L 8.5,1 Z M 9.5,5.8 A 2.2,2.2 0 1 0 9.5,10.2 A 2.2,2.2 0 1 0 9.5,5.8 Z</Geometry>
        <Geometry x:Key="SettingsNavigationHotkeyIcon">M 2,4 H 16 V 13 H 2 Z M 4,6 H 5 M 7,6 H 8 M 10,6 H 11 M 13,6 H 14 M 4,9 H 5 M 7,9 H 8 M 10,9 H 11 M 13,9 H 14 M 4,12 H 12</Geometry>
        <Geometry x:Key="SettingsNavigationOcrIcon">M 3,2 H 15 V 16 H 3 Z M 6,5 H 12 M 6,8 H 12 M 6,11 H 10</Geometry>
        <Geometry x:Key="SettingsNavigationTranslateIcon">M 3,3 H 15 M 5,6 H 13 M 7,9 H 11 M 10,11 L 15,16</Geometry>
        <Geometry x:Key="SettingsNavigationUpdateIcon">M 4,5 A 6,6 0 1 1 4,13 M 4,5 V 1 M 4,5 H 8</Geometry>
        <Geometry x:Key="SettingsNavigationDonateIcon">M 9,15 C 8,14 3,11 3,7 A 3,3 0 0 1 9,5 A 3,3 0 0 1 15,7 C 15,11 10,14 9,15 Z</Geometry>
        <Geometry x:Key="SettingsNavigationContactIcon">M 2,3 H 16 V 12 H 10 L 6,16 V 12 H 2 Z M 5,6 H 13 M 5,9 H 11</Geometry>
        <Style x:Key="SettingsNavigationIcon" TargetType="Path">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Background" Value="{DynamicResource AppPanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AppControlForegroundBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton"
               TargetType="Button"
               BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="NavigationItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="NavigationBackground"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavigationBackground" Property="Background" Value="{DynamicResource AppAccentMutedBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AppAccentForegroundBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThemeOptionButton" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="Background" Value="{DynamicResource AppPanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AppControlForegroundBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ThemeOptionBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ThemeOptionBorder" Property="Background" Value="{DynamicResource AppAccentBrush}" />
                                <Setter TargetName="ThemeOptionBorder" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThemeOptionBorder" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ThemeCardButton" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="MinHeight" Value="76" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Background" Value="{DynamicResource AppPanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AppControlForegroundBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="ThemeCardSurface"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="ThemeSelectedBadge"
                                    Width="20"
                                    Height="20"
                                    Margin="0,7,7,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource AppAccentBrush}"
                                    CornerRadius="10"
                                    Visibility="Collapsed">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="10"
                                           Foreground="#FFFFFF"
                                           Text="&#xE73E;" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThemeCardSurface"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AppAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ThemeCardSurface"
                                        Property="Background"
                                        Value="{DynamicResource AppAccentMutedBrush}" />
                                <Setter TargetName="ThemeCardSurface"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AppAccentBrush}" />
                                <Setter TargetName="ThemeCardSurface"
                                        Property="BorderThickness"
                                        Value="2" />
                                <Setter TargetName="ThemeSelectedBadge"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GeneralGroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
        </Style>
        <Style x:Key="GeneralGroupDescription" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
        </Style>
        <Style x:Key="GeneralFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
        </Style>
        <Style x:Key="GeneralGroupSeparator" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,24,0,22" />
            <Setter Property="Background" Value="{DynamicResource AppSeparatorBrush}" />
            <Setter Property="Opacity" Value="0.82" />
        </Style>
        <Style x:Key="MouseDurationSlider" TargetType="Slider">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="28" Background="Transparent">
                            <Track x:Name="PART_Track"
                                   Minimum="{TemplateBinding Minimum}"
                                   Maximum="{TemplateBinding Maximum}"
                                   Value="{TemplateBinding Value}"
                                   IsDirectionReversed="False"
                                   VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                  Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="8"
                                                        Margin="0,0,-4,0"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource AppAccentBrush}"
                                                        CornerRadius="4" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="24"
                                           Height="24"
                                           Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="24" Height="24">
                                                    <Border x:Name="ThumbHalo"
                                                            Background="{DynamicResource AppAccentBrush}"
                                                            CornerRadius="12"
                                                            Opacity="0.18" />
                                                    <Border x:Name="ThumbCore"
                                                            Width="18"
                                                            Height="18"
                                                            Background="{DynamicResource AppAccentBrush}"
                                                            BorderBrush="#F4FFFFFF"
                                                            BorderThickness="2"
                                                            CornerRadius="9"
                                                            SnapsToDevicePixels="True" />
                                                    <Ellipse Width="5"
                                                             Height="5"
                                                             Fill="#F7FFFFFF"
                                                             IsHitTestVisible="False" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbHalo"
                                                                Property="Opacity"
                                                                Value="0.34" />
                                                        <Setter TargetName="ThumbCore"
                                                                Property="Width"
                                                                Value="20" />
                                                        <Setter TargetName="ThumbCore"
                                                                Property="Height"
                                                                Value="20" />
                                                        <Setter TargetName="ThumbCore"
                                                                Property="CornerRadius"
                                                                Value="10" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbHalo"
                                                                Property="Opacity"
                                                                Value="0.48" />
                                                        <Setter TargetName="ThumbCore"
                                                                Property="Width"
                                                                Value="16" />
                                                        <Setter TargetName="ThumbCore"
                                                                Property="Height"
                                                                Value="16" />
                                                        <Setter TargetName="ThumbCore"
                                                                Property="CornerRadius"
                                                                Value="8" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                  Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="8"
                                                        Margin="-4,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource AppAccentMutedBrush}"
                                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                                        BorderThickness="0,1,1,1"
                                                        CornerRadius="4" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type local:HotKeyCaptureBox}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="{DynamicResource AppInputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AppControlForegroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type local:HotKeyCaptureBox}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          Focusable="False" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="8"
            Background="{DynamicResource AppGlassBackgroundBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="20"
            SnapsToDevicePixels="True">
      <Grid Background="{DynamicResource AppWindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="178" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource AppSidebarBackgroundBrush}"
                BorderBrush="{DynamicResource AppSubtleBorderBrush}"
                BorderThickness="0,0,1,0"
                CornerRadius="16">
            <Grid Margin="24,26,20,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Text="SnapCut" />
                    <Border Height="1"
                            Margin="0,24,0,18"
                            Background="{DynamicResource AppSeparatorBrush}" />
                </StackPanel>

                <ListBox x:Name="SettingsNavigation"
                         Grid.Row="1"
                         BorderThickness="0"
                         Background="Transparent"
                         FocusVisualStyle="{x:Null}"
                         SelectionChanged="OnSettingsNavigationSelectionChanged">
                    <ListBoxItem IsSelected="True"
                                 Style="{StaticResource NavigationItem}">
                        <Grid Height="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource SettingsNavigationGeneralIcon}"
                                  Style="{StaticResource SettingsNavigationIcon}" />
                            <TextBlock Grid.Column="1"
                                       Height="24"
                                       Margin="10,0,0,0"
                                       LineHeight="24"
                                       LineStackingStrategy="BlockLineHeight"
                                       Text="常规设置"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavigationItem}">
                        <Grid Height="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource SettingsNavigationHotkeyIcon}"
                                  Style="{StaticResource SettingsNavigationIcon}" />
                            <TextBlock Grid.Column="1"
                                       Height="24"
                                       Margin="10,0,0,0"
                                       LineHeight="24"
                                       LineStackingStrategy="BlockLineHeight"
                                       Text="快捷键"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavigationItem}">
                        <Grid Height="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource SettingsNavigationOcrIcon}"
                                  Style="{StaticResource SettingsNavigationIcon}" />
                            <TextBlock Grid.Column="1"
                                       Height="24"
                                       Margin="10,0,0,0"
                                       LineHeight="24"
                                       LineStackingStrategy="BlockLineHeight"
                                       Text="内容识别"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavigationItem}">
                        <Grid Height="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource SettingsNavigationTranslateIcon}"
                                  Style="{StaticResource SettingsNavigationIcon}" />
                            <TextBlock Grid.Column="1"
                                       Height="24"
                                       Margin="10,0,0,0"
                                       LineHeight="24"
                                       LineStackingStrategy="BlockLineHeight"
                                       Text="翻译"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavigationItem}">
                        <Grid Height="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource SettingsNavigationUpdateIcon}"
                                  Style="{StaticResource SettingsNavigationIcon}" />
                            <TextBlock x:Name="UpdateNavigationText"
                                       Grid.Column="1"
                                       Height="24"
                                       Margin="10,0,0,0"
                                       LineHeight="24"
                                       LineStackingStrategy="BlockLineHeight"
                                       Text="版本更新"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavigationItem}">
                        <Grid Height="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource SettingsNavigationDonateIcon}"
                                  Style="{StaticResource SettingsNavigationIcon}" />
                            <TextBlock Grid.Column="1"
                                       Height="24"
                                       Margin="10,0,0,0"
                                       LineHeight="24"
                                       LineStackingStrategy="BlockLineHeight"
                                       Text="打赏支持"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </ListBoxItem>
                    <ListBoxItem Style="{StaticResource NavigationItem}">
                        <Grid Height="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource SettingsNavigationContactIcon}"
                                  Style="{StaticResource SettingsNavigationIcon}" />
                            <TextBlock Grid.Column="1"
                                       Height="24"
                                       Margin="10,0,0,0"
                                       LineHeight="24"
                                       LineStackingStrategy="BlockLineHeight"
                                       Text="交流联系"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </ListBoxItem>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Column="1"
              Margin="34,28,34,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer x:Name="GeneralSettingsPanel"
                          Grid.Row="0"
                          Grid.RowSpan="2"
                          VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,0,16,24">
                <StackPanel>
                    <TextBlock FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Text="常规" />
                    <TextBlock Margin="0,7,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Text="保存、外观和运行方式" />
                </StackPanel>

                <StackPanel x:Name="GeneralAppearanceGroup"
                            Margin="0,28,0,0">
                    <TextBlock Style="{StaticResource GeneralGroupTitle}"
                               Text="保存与外观" />
                    <TextBlock Style="{StaticResource GeneralGroupDescription}"
                               Text="截图、视频文件与界面显示" />

                    <Grid Margin="0,17,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource GeneralFieldLabel}"
                                       Text="截图保存位置" />
                            <TextBox Height="34"
                                     Margin="0,9,0,0"
                                     Padding="10,3"
                                     VerticalContentAlignment="Center"
                                     BorderBrush="{DynamicResource AppBorderBrush}"
                                     LostKeyboardFocus="OnSettingEditorLostKeyboardFocus"
                                     TextChanged="OnTextSettingChanged"
                                     Text="{Binding SaveDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <Button x:Name="BrowseSaveDirectoryButton"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Height="34"
                                VerticalAlignment="Bottom"
                                Click="OnBrowseSaveDirectoryClick"
                                Content="浏览"
                                Style="{StaticResource SecondaryButton}"
                                ToolTip="选择截图保存目录" />
                        <StackPanel Grid.Column="2"
                                    Margin="16,0,0,0">
                            <TextBlock Style="{StaticResource GeneralFieldLabel}"
                                       Text="PNG保存位置" />
                            <ComboBox Width="250"
                                      Height="34"
                                      Margin="0,9,0,0"
                                      Padding="9,2"
                                      FontSize="13"
                                      ItemsSource="{Binding PngSaveLocationModeOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding PngSaveLocationMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectionChanged="OnImmediateSettingChanged"
                                      ToolTip="选择使用默认截图目录，或每次保存时选择目录" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Margin="0,15,0,0"
                               Style="{StaticResource GeneralFieldLabel}"
                               Text="视频保存位置" />
                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Height="34"
                                 Padding="10,3"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="{DynamicResource AppBorderBrush}"
                                 LostKeyboardFocus="OnSettingEditorLostKeyboardFocus"
                                 TextChanged="OnTextSettingChanged"
                                 Text="{Binding VideoSaveDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        <Button x:Name="BrowseVideoSaveDirectoryButton"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Click="OnBrowseVideoSaveDirectoryClick"
                                Content="浏览"
                                Style="{StaticResource SecondaryButton}"
