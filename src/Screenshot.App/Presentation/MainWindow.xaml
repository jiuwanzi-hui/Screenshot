                    </ListBoxItem>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Column="1"
              Margin="26,24,18,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer x:Name="GeneralSettingsPanel"
                          Grid.Row="0"
                          Grid.RowSpan="2"
                          VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,0,16,24">
                <StackPanel>
                    <TextBlock FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Text="常规" />
                    <TextBlock Margin="0,7,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Text="保存、外观和运行方式" />
                    <StackPanel Margin="0,18,0,0">
                        <TextBlock Style="{StaticResource GeneralFieldLabel}"
                                   Text="界面主题" />
                        <ComboBox x:Name="ThemeComboBox"
                                  Width="270"
                                  Height="58"
                                  Margin="0,9,0,0"
                                  HorizontalAlignment="Left"
                                  Padding="9,2"
                                  ItemsSource="{Binding ThemeOptions}"
                                  SelectedValuePath="Value"
                                  SelectedValue="{Binding Theme, Mode=TwoWay}"
                                  SelectionChanged="OnThemeSelectionChanged"
                                  ToolTip="选择界面主题，选中后立即应用">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="48">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="28"
                                                Height="36"
                                                CornerRadius="5"
                                                VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#30343B" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Value}" Value="AuroraMist"><Setter Property="Background"><Setter.Value><LinearGradientBrush><GradientStop Color="#F7F8FB"/><GradientStop Color="#7E91D5" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></DataTrigger>
                                                        <DataTrigger Binding="{Binding Value}" Value="CoralSky"><Setter Property="Background"><Setter.Value><LinearGradientBrush><GradientStop Color="#F7D8D4"/><GradientStop Color="#BFDCE6" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></DataTrigger>
                                                        <DataTrigger Binding="{Binding Value}" Value="GinkgoPaper"><Setter Property="Background"><Setter.Value><LinearGradientBrush><GradientStop Color="#FAFAF7"/><GradientStop Color="#D3AF5B" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></DataTrigger>
                                                        <DataTrigger Binding="{Binding Value}" Value="ForestNight"><Setter Property="Background"><Setter.Value><LinearGradientBrush><GradientStop Color="#15181C"/><GradientStop Color="#4E8B74" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></DataTrigger>
                                                        <DataTrigger Binding="{Binding Value}" Value="ObsidianGold"><Setter Property="Background"><Setter.Value><LinearGradientBrush><GradientStop Color="#141516"/><GradientStop Color="#D3A343" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></DataTrigger>
                                                        <DataTrigger Binding="{Binding Value}" Value="NeonDeep"><Setter Property="Background"><Setter.Value><LinearGradientBrush><GradientStop Color="#10151E"/><GradientStop Color="#D65E76" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,3,0,3" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Label}" />
                                            <TextBlock Margin="0,3,0,0" FontSize="11" Opacity="0.68" Text="{Binding Description}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="GeneralAppearanceGroup"
                            Margin="0,28,0,0">
                    <TextBlock Style="{StaticResource GeneralGroupTitle}"
                               Text="保存与输出" />
                    <TextBlock Style="{StaticResource GeneralGroupDescription}"
                               Text="截图、视频文件与输出方式" />

                    <Grid Margin="0,17,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource GeneralFieldLabel}"
                                       Text="截图保存位置" />
                            <TextBox Height="34"
                                     Margin="0,9,0,0"
                                     Padding="10,3"
                                     VerticalContentAlignment="Center"
                                     BorderBrush="{DynamicResource AppBorderBrush}"
                                     LostKeyboardFocus="OnSettingEditorLostKeyboardFocus"
                                     TextChanged="OnTextSettingChanged"
                                     Text="{Binding SaveDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <Button x:Name="BrowseSaveDirectoryButton"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Height="34"
                                VerticalAlignment="Bottom"
                                Click="OnBrowseSaveDirectoryClick"
                                Content="浏览"
                                Style="{StaticResource SecondaryButton}"
                                ToolTip="选择截图保存目录" />
                        <StackPanel Grid.Column="2"
                                    Margin="16,0,0,0">
                            <TextBlock Style="{StaticResource GeneralFieldLabel}"
                                       Text="PNG保存位置" />
                            <ComboBox Width="250"
                                      Height="34"
                                      Margin="0,9,0,0"
                                      Padding="9,2"
                                      FontSize="13"
                                      ItemsSource="{Binding PngSaveLocationModeOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding PngSaveLocationMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectionChanged="OnImmediateSettingChanged"
                                      ToolTip="选择使用默认截图目录，或每次保存时选择目录" />
                        </StackPanel>
                    </Grid>

                    <CheckBox MinHeight="30"
                              Margin="0,12,0,0"
                              FontSize="14"
                              Foreground="{DynamicResource AppTextPrimaryBrush}"
                              IsChecked="{Binding AutoSaveOnComplete}"
                              Checked="OnImmediateSettingChanged"
                              Unchecked="OnImmediateSettingChanged"
                              Content="完成截图后自动保存 PNG"
                              ToolTip="点击完成按钮或使用完成截图快捷键后，按 PNG 保存位置设置保存截图" />

                    <TextBlock Margin="0,15,0,0"
                               Style="{StaticResource GeneralFieldLabel}"
                               Text="视频保存位置" />
                    <Grid Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Height="34"
                                 Padding="10,3"
                                 VerticalContentAlignment="Center"
                                 BorderBrush="{DynamicResource AppBorderBrush}"
                                 LostKeyboardFocus="OnSettingEditorLostKeyboardFocus"
                                 TextChanged="OnTextSettingChanged"
                                 Text="{Binding VideoSaveDirectory, UpdateSourceTrigger=PropertyChanged}" />
                        <Button x:Name="BrowseVideoSaveDirectoryButton"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                Click="OnBrowseVideoSaveDirectoryClick"
                                Content="浏览"
                                Style="{StaticResource SecondaryButton}"
                                ToolTip="选择视频保存目录" />
                    </Grid>

                    <TextBlock Margin="0,15,0,0"
                               Style="{StaticResource GeneralFieldLabel}"
                               Text="截图输出尺寸" />
                    <ComboBox x:Name="ScreenshotScalePercentComboBox"
                              Width="270"
                              Height="34"
                              Margin="0,9,0,0"
                              HorizontalAlignment="Left"
                              Padding="9,2"
                              FontSize="13"
                              SelectedValuePath="Tag"
                              SelectedValue="{Binding ScreenshotScalePercent, Mode=TwoWay}"
                              SelectionChanged="OnImmediateSettingChanged"
                              ToolTip="100% 保留屏幕原始像素；大于 100% 使用插值放大，不增加真实细节。钉图显示始终保留原图。">
                        <ComboBoxItem Content="50% · 更小文件"
                                      Tag="50" />
                        <ComboBoxItem Content="75% · 平衡"
                                      Tag="75" />
                        <ComboBoxItem Content="100% · 原始像素"
                                      Tag="100" />
                        <ComboBoxItem Content="125% · 插值放大"
                                      Tag="125" />
                        <ComboBoxItem Content="150% · 插值放大"
                                      Tag="150" />
                        <ComboBoxItem Content="200% · 插值放大"
                                      Tag="200" />
                    </ComboBox>
                    <TextBlock Margin="0,7,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="100% 保留原始像素；缩小会减少细节，放大仅增加像素数，不增加真实细节。仅影响保存和复制，钉图显示保留原图；长截图保持原始拼接像素。PNG 为无损格式。" />

                    <TextBlock Margin="0,15,0,0"
                               Style="{StaticResource GeneralFieldLabel}"
                               Text="普通截图比例" />
                    <ComboBox Width="270"
                              Height="34"
                              Margin="0,9,0,0"
                              HorizontalAlignment="Left"
                              Padding="9,2"
                              x:Name="CaptureAspectRatioComboBox"
                              ItemsSource="{Binding CaptureAspectRatioOptions}"
                              DisplayMemberPath="Label"
                              SelectedValuePath="Value"
                              SelectedValue="{Binding CaptureAspectRatio, Mode=TwoWay}"
                              SelectionChanged="OnImmediateSettingChanged"
                              ToolTip="只限制普通截图框选；长截图、录屏和其他模式不受影响。" />
                    <TextBlock Margin="0,7,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Text="选择比例后，拖动普通截图框选区会自动保持该比例；选择“自由比例”恢复自由伸缩。" />

                    <StackPanel Margin="0,18,0,0" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource GeneralFieldLabel}"
                                   Text="界面主题" />
                        <UniformGrid Margin="0,10,-10,0" Columns="2">
                            <RadioButton x:Name="AuroraMistThemeOption"
                                         Checked="OnThemeOptionChecked"
                                         GroupName="AppTheme"
                                         Style="{StaticResource ThemeCardButton}"
                                         Tag="{x:Static core:AppTheme.AuroraMist}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="50" CornerRadius="6">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#F7F8FB" Offset="0" />
                                                <GradientStop Color="#DDE6F2" Offset="0.55" />
                                                <GradientStop Color="#7E91D5" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="极光晨雾" />
                                        <TextBlock Margin="0,5,0,0" FontSize="11" Opacity="0.68" Text="浅色 · 雾白与靛蓝" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="CoralSkyThemeOption"
                                         Checked="OnThemeOptionChecked"
                                         GroupName="AppTheme"
                                         Style="{StaticResource ThemeCardButton}"
                                         Tag="{x:Static core:AppTheme.CoralSky}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="50" CornerRadius="6">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#F7D8D4" Offset="0" />
                                                <GradientStop Color="#F6ECE5" Offset="0.5" />
                                                <GradientStop Color="#BFDCE6" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="珊瑚晴空" />
                                        <TextBlock Margin="0,5,0,0" FontSize="11" Opacity="0.68" Text="浅色 · 珊瑚与天青" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="GinkgoPaperThemeOption"
                                         Checked="OnThemeOptionChecked"
                                         GroupName="AppTheme"
                                         Style="{StaticResource ThemeCardButton}"
                                         Tag="{x:Static core:AppTheme.GinkgoPaper}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="50" CornerRadius="6">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#FAFAF7" Offset="0" />
                                                <GradientStop Color="#ECE9DF" Offset="0.55" />
                                                <GradientStop Color="#D3AF5B" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="银杏纸白" />
                                        <TextBlock Margin="0,5,0,0" FontSize="11" Opacity="0.68" Text="浅色 · 纸白与银杏" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="ForestNightThemeOption"
                                         Checked="OnThemeOptionChecked"
                                         GroupName="AppTheme"
                                         Style="{StaticResource ThemeCardButton}"
                                         Tag="{x:Static core:AppTheme.ForestNight}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="50" CornerRadius="6">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#15181C" Offset="0" />
                                                <GradientStop Color="#2A3138" Offset="0.58" />
                                                <GradientStop Color="#4E8B74" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="松林夜雨" />
                                        <TextBlock Margin="0,5,0,0" FontSize="11" Opacity="0.68" Text="深色 · 石墨与松绿" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="ObsidianGoldThemeOption"
                                         Checked="OnThemeOptionChecked"
                                         GroupName="AppTheme"
                                         Style="{StaticResource ThemeCardButton}"
                                         Tag="{x:Static core:AppTheme.ObsidianGold}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="50" CornerRadius="6">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#141516" Offset="0" />
                                                <GradientStop Color="#303234" Offset="0.6" />
                                                <GradientStop Color="#D3A343" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="熔金曜石" />
                                        <TextBlock Margin="0,5,0,0" FontSize="11" Opacity="0.68" Text="深色 · 曜石与暖金" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>
                            <RadioButton x:Name="NeonDeepThemeOption"
                                         Checked="OnThemeOptionChecked"
                                         GroupName="AppTheme"
                                         Style="{StaticResource ThemeCardButton}"
                                         Tag="{x:Static core:AppTheme.NeonDeep}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="50" CornerRadius="6">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#10151E" Offset="0" />
                                                <GradientStop Color="#263247" Offset="0.58" />
                                                <GradientStop Color="#D65E76" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="霓虹深海" />
                                        <TextBlock Margin="0,5,0,0" FontSize="11" Opacity="0.68" Text="深色 · 深海与玫红" />
                                    </StackPanel>
                                </Grid>
                            </RadioButton>
                        </UniformGrid>
                    </StackPanel>
                </StackPanel>

                <Border Style="{StaticResource GeneralGroupSeparator}" />

                <StackPanel x:Name="GeneralCaptureToolbarGroup">
                    <TextBlock Style="{StaticResource GeneralGroupTitle}"
                               Text="工具栏" />
                    <TextBlock Style="{StaticResource GeneralGroupDescription}"
                               Text="长按功能按钮可拖拽；配置截图、钉图与录屏期间共用的工具栏大小，以及截图工具顺序、显隐和行数" />
                    <Grid Margin="0,16,0,0" MaxWidth="430" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="58" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Margin="0,0,14,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource GeneralFieldLabel}"
                                   Text="工具栏大小" />
                        <Slider Grid.Column="1"
                                Style="{StaticResource MouseDurationSlider}"
                                Minimum="50"
                                Maximum="150"
                                TickFrequency="1"
                                SmallChange="1"
                                LargeChange="1"
                                IsSnapToTickEnabled="True"
                                Value="{Binding ToolbarScalePercent, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                ValueChanged="OnToolbarScaleChanged" />
                        <TextBlock Grid.Column="2"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   Text="{Binding ToolbarScalePercent, StringFormat={}{0:0}%}" />
                    </Grid>
                    <local:CaptureToolbarLayoutEditor Margin="0,12,0,0"
                                                      LayoutChanged="OnCaptureToolbarLayoutChanged" />
                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Text="功能快捷键（支持数字或 Ctrl / Alt / Shift + 数字；在截图、钉图编辑和录制中生效）" />
                    <ItemsControl Margin="0,7,0,0"
                                  ItemsSource="{Binding CaptureToolbarAnnotationFeatureItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,12,8" Orientation="Horizontal">
                                    <Border Style="{StaticResource ToolbarShortcutIcon}" Width="32" Height="32" Padding="0">
                                        <Viewbox Width="18" Height="18" Stretch="Uniform"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <local:ToolbarFeatureIcon Feature="{Binding Feature}"
                                                                      Glyph="{Binding Glyph}" />
                                        </Viewbox>
                                    </Border>
                                    <local:HotKeyCaptureBox Style="{StaticResource ToolbarShortcutCapture}"
                                             Width="118"
                                             Height="32"
                                             Margin="7,0,0,0"
                                             Padding="2"
                                             MaxLength="24"
                                             HorizontalContentAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             HotKeyCaptureRequested="OnHotKeyCaptureRequested"
                                             GotKeyboardFocus="OnHotKeyCaptureGotKeyboardFocus"
                                             HotKeyCaptured="OnHotKeyCaptured"
                                             HotKeyCaptureCanceled="OnHotKeyCaptureCanceled"
                                             LostKeyboardFocus="OnHotKeyCaptureLostKeyboardFocus"
                                             Tag="{Binding Feature}"
                                             Text="{Binding Shortcut, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                             ToolTip="点击后按数字或组合键，例如 Ctrl+1；按 Backspace 清空" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <Border Style="{StaticResource GeneralGroupSeparator}" />

                <StackPanel x:Name="GeneralWindowGroup">
                    <TextBlock Style="{StaticResource GeneralGroupTitle}"
                               Text="窗口与后台" />
                    <TextBlock Style="{StaticResource GeneralGroupDescription}"
                               Text="关闭方式、系统入口与开机启动" />

                    <TextBlock Margin="0,17,0,0"
                               Style="{StaticResource GeneralFieldLabel}"
                               Text="点击关闭按钮时" />
                    <StackPanel Margin="0,9,0,8" Orientation="Horizontal">
                        <RadioButton x:Name="MinimizeOnCloseOption"
                                     Checked="OnCloseBehaviorOptionChecked"
                                     Content="最小化到后台"
                                     GroupName="WindowCloseBehavior"
                                     Style="{StaticResource ThemeOptionButton}"
                                     Tag="{x:Static core:WindowCloseBehavior.MinimizeToBackground}" />
                        <RadioButton x:Name="ExitOnCloseOption"
                                     Checked="OnCloseBehaviorOptionChecked"
                                     Content="退出程序"
                                     GroupName="WindowCloseBehavior"
                                     Style="{StaticResource ThemeOptionButton}"
                                     Tag="{x:Static core:WindowCloseBehavior.ExitApplication}" />
