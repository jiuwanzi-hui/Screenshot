                               TextWrapping="Wrap" />

                    <TextBlock Margin="0,18,0,0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               Text="Windows 识别语言" />
                    <ComboBox x:Name="OcrLanguageComboBox"
                              Margin="0,9,0,0"
                              DisplayMemberPath="Label"
                              ItemsSource="{Binding OcrLanguageOptions}"
                              SelectedValue="{Binding OcrLanguageTag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              SelectedValuePath="Value"
                              SelectionChanged="OnImmediateSettingChanged"
                              ToolTip="仅显示 Windows 当前可用的 OCR 语言包" />

                    <Border Margin="0,22,0,8"
                            Padding="16"
                            Background="{DynamicResource AppPanelBackgroundBrush}"
                            BorderBrush="{DynamicResource AppBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AppTextPrimaryBrush}"
                                       Text="PP-OCRv6 Small + 艺术字增强 · 本机多语言识别" />
                            <TextBlock Margin="0,6,0,0"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       TextWrapping="Wrap"
                                       Text="普通图片使用 Small 快速识别；困难小图及横竖混排海报按需调用 Medium，补充竖排与彩色描边大字识别，艺术字和标点仍需核对。完整文件约 163.1 MiB，文件大小不等于运行内存。完全本机运行，不上传截图；增强处理会增加等待和运行内存，空闲约 10 秒退出工作进程。" />
                            <TextBlock x:Name="HighQualityOcrModelStatusText"
