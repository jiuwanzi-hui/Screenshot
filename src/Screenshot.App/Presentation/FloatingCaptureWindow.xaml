<Window x:Class="Screenshot.App.Presentation.FloatingCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="40"
        Height="40"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Title="SnapCut 悬浮按钮"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="None">
    <Window.Resources>
        <Style x:Key="FloatingMenuButton" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="74" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BackgroundBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BackgroundBorder"
                                        Property="Background"
                                        Value="{DynamicResource AppAccentMutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FloatingContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Margin="5"
                                Padding="4"
                                Background="{DynamicResource AppPanelBackgroundBrush}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14"
                                                  Direction="270"
                                                  Opacity="0.24"
                                                  ShadowDepth="3"
                                                  Color="#000000" />
                            </Border.Effect>
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FloatingContextMenuItem" TargetType="MenuItem">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter VerticalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemSurface"
                                        Property="Background"
                                        Value="{DynamicResource AppAccentMutedBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ItemSurface" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="WindowRoot" ClipToBounds="True">
        <Border x:Name="FloatingButton"
                Width="40"
                Height="40"
                Background="Transparent"
                ContextMenuOpening="OnFloatingButtonContextMenuOpening"
                Cursor="Hand"
                MouseEnter="OnFloatingButtonMouseEnter"
                MouseMove="OnFloatingButtonMouseMove"
                PreviewMouseLeftButtonDown="OnFloatingButtonPreviewMouseLeftButtonDown"
                PreviewMouseLeftButtonUp="OnFloatingButtonPreviewMouseLeftButtonUp"
                PreviewMouseRightButtonDown="OnFloatingButtonPreviewMouseRightButtonDown">
            <Border.RenderTransform>
                <TranslateTransform x:Name="DockTranslateTransform" />
            </Border.RenderTransform>
            <Border.ContextMenu>
                <ContextMenu x:Name="FloatingButtonContextMenu"
                             Closed="OnFloatingContextMenuClosed"
                             Opened="OnFloatingContextMenuOpened"
                             Style="{StaticResource FloatingContextMenu}">
                    <MenuItem x:Name="CloseFloatingButtonMenuItem"
                              Click="OnCloseFloatingButtonClick"
                              Style="{StaticResource FloatingContextMenuItem}">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="18" Height="18" Margin="0,0,8,0">
                                    <Ellipse Fill="#18F04455" />
                                    <Path Margin="5"
                                          Data="M 1,1 L 7,7 M 7,1 L 1,7"
                                          Stroke="#F04455"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Stretch="Uniform" />
                                </Grid>
                                <TextBlock VerticalAlignment="Center"
                                           FontSize="12"
                                           Text="关闭悬浮按钮" />
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                </ContextMenu>
            </Border.ContextMenu>
            <Grid>
                <Image x:Name="FloatingButtonIcon"
                       Width="32"
                       Height="32"
                       IsHitTestVisible="False"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="pack://application:,,,/Assets/Screenshot.png"
                       SnapsToDevicePixels="True"
                       Stretch="Uniform" />
            </Grid>
        </Border>

        <Popup x:Name="FeatureMenuPopup"
               AllowsTransparency="True"
               Focusable="False"
               Placement="Top"
               PlacementTarget="{Binding ElementName=WindowRoot}"
               PopupAnimation="Fade"
               StaysOpen="True">
            <Border Margin="4"
                    Padding="2"
                    Background="{DynamicResource AppPanelBackgroundBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    MouseEnter="OnFeatureMenuMouseEnter"
                    MouseLeave="OnFeatureMenuMouseLeave">
                <StackPanel>
                    <Button x:Name="RegionCaptureMenuButton"
                            Click="OnRegionCaptureClick"
                            Content="区域截图"
                            Style="{StaticResource FloatingMenuButton}" />
                    <Border x:Name="RegionScrollMenuSeparator"
                            Height="1"
                            Margin="9,1"
                            Background="{DynamicResource AppSeparatorBrush}"
                            Opacity="0.72" />
                    <Button x:Name="ScrollCaptureMenuButton"
                            Click="OnScrollCaptureClick"
                            Content="长截图"
                            Style="{StaticResource FloatingMenuButton}" />
                    <Border x:Name="ScrollVideoMenuSeparator"
                            Height="1"
                            Margin="9,1"
                            Background="{DynamicResource AppSeparatorBrush}"
                            Opacity="0.72" />
                    <Button x:Name="VideoRecordingMenuButton"
                            Click="OnVideoRecordingClick"
                            Content="录制视频"
                            Style="{StaticResource FloatingMenuButton}" />
                    <Border x:Name="VideoPinMenuSeparator"
                             Height="1"
                             Margin="9,1"
                             Background="{DynamicResource AppSeparatorBrush}"
                             Opacity="0.72" />
                    <Button x:Name="PinCaptureMenuButton"
                            Click="OnPinCaptureClick"
                            Content="钉图"
                            Style="{StaticResource FloatingMenuButton}" />
                    <Border x:Name="PinAllScreensMenuSeparator"
                            Height="1"
                            Margin="9,1"
                            Background="{DynamicResource AppSeparatorBrush}"
                            Opacity="0.72" />
                    <Button x:Name="AllScreensCaptureMenuButton"
                            Click="OnAllScreensCaptureClick"
                            Content="全部屏幕截图"
                            Style="{StaticResource FloatingMenuButton}" />
                    <Border x:Name="AllScreensHistoryMenuSeparator"
                            Height="1"
                            Margin="9,1"
                            Background="{DynamicResource AppSeparatorBrush}"
                            Opacity="0.72" />
                    <Button x:Name="HistoryMenuButton"
                            Click="OnHistoryClick"
                            Content="历史查看"
                            Style="{StaticResource FloatingMenuButton}" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
