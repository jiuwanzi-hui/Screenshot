<Window x:Class="Screenshot.App.Capture.RecordingRegionFrameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AllowsTransparency="True"
        Background="Transparent"
        ShowActivated="False"
        ShowInTaskbar="False"
        Title="SnapCut Recording Region"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="None">
    <Border BorderBrush="{DynamicResource AppAccentBrush}"
            BorderThickness="3"
            CornerRadius="3"
            IsHitTestVisible="False" />
</Window>
