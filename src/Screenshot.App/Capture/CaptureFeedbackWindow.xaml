<Window x:Class="Screenshot.App.Capture.CaptureFeedbackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="False"
        IsHitTestVisible="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Title="SnapCut 截图反馈"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="None">
    <Canvas x:Name="FeedbackRoot" Background="Transparent">
        <Border x:Name="SelectionFrame"
                Width="4"
                Height="4"
                Background="#147B61FF"
                BorderThickness="2.5"
                CornerRadius="5"
                SnapsToDevicePixels="True">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#5C72FF" Offset="0" />
                    <GradientStop Color="#A55AF5" Offset="0.52" />
                    <GradientStop Color="#EC5DB6" Offset="1" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect BlurRadius="8"
                                  Direction="270"
                                  Opacity="0.42"
                                  ShadowDepth="1"
                                  Color="#6B5CFF" />
            </Border.Effect>
        </Border>

        <Border x:Name="CaptureToast"
                Width="166"
                Height="40"
                Padding="13,0"
                Background="#E8252730"
                BorderBrush="#667F8598"
                BorderThickness="1"
                CornerRadius="20"
                Opacity="0"
                Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Grid Width="18" Height="18" Margin="0,0,7,0">
                    <Ellipse Fill="#7B61FF" />
                    <Path Data="M 4,9 L 7.3,12.2 L 14,5.5"
                          Stroke="#FFFFFF"
                          StrokeThickness="1.8"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round" />
                </Grid>
                <TextBlock VerticalAlignment="Center"
                           Foreground="#FFFFFF"
                           FontFamily="Microsoft YaHei UI"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Text="已截取并复制" />
            </StackPanel>
        </Border>
    </Canvas>
</Window>
