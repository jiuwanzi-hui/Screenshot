<Window x:Class="Screenshot.App.Capture.ScrollCaptureProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Width="300"
        Height="480"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        PreviewMouseRightButtonDown="OnPreviewMouseRightButtonDown"
        PreviewMouseRightButtonUp="OnPreviewMouseRightButtonUp">
    <Border Background="#E6142830"
            BorderBrush="#7A5BBDB5"
            BorderThickness="1"
            CornerRadius="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              Direction="270"
                              Opacity="0.34"
                              ShadowDepth="6"
                              Color="#001014" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="78" />
                <RowDefinition Height="*" />
                <RowDefinition Height="54" />
            </Grid.RowDefinitions>
            <StackPanel Margin="14,10,14,8">
                <TextBlock x:Name="StatusText"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#E0F4F1"
                           Text="滚动截图 · 实时预览" />
                <TextBlock x:Name="FrameCountText"
                           Margin="0,3,0,0"
                           FontSize="12"
                           Foreground="#91C8C5"
                           Text="1 帧 · 上 0 · 下 0" />
                <TextBlock x:Name="InstructionText"
                           Margin="0,3,0,0"
                           FontSize="11"
                           Foreground="#B8DDD9"
                           Text="单击向下；双击向上；右键取消"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Border Grid.Row="1"
                    Margin="10,0"
                    Background="#B51B3037"
                    BorderBrush="#4F738789"
                    BorderThickness="1">
                <!-- The preview is a global map of the whole stitched image.
                     The window grows toward the work-area height as the image
                     grows, so the Uniform fit stays as wide and readable as
                     the screen allows. -->
                <Image x:Name="PreviewImage"
                       Margin="6"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Stretch="Uniform" />
            </Border>

            <StackPanel x:Name="ActionPanel"
                        Grid.Row="2"
                        Margin="12,10"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button Width="64"
                        Height="34"
                        Margin="0,0,8,0"
                        Background="#D91A3037"
                        BorderBrush="#5C7A9292"
                        Foreground="#D9F5F1"
                        Click="OnCancelClick"
                        Content="取消"
                        ToolTip="取消滚动截图" />
                <Button Width="56"
                        Height="34"
                        Margin="0,0,8,0"
                        Background="#D91A3037"
                        BorderBrush="#5C7A9292"
                        Foreground="#D9F5F1"
                        Click="OnEditClick"
                        Content="编辑"
                        ToolTip="完成并进入详情编辑" />
                <Button Width="36"
                        Height="34"
                        Background="#2EAFA5"
                        BorderBrush="#8AE1D8D0"
                        Click="OnCompleteClick"
                        Foreground="#FFFFFF"
                        ToolTip="复制并完成滚动截图">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE73E;" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
