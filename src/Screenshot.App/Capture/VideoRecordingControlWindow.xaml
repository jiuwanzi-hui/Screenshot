<Window x:Class="Screenshot.App.Capture.VideoRecordingControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="668"
        Height="38"
        MinHeight="38"
        MaxHeight="38"
        SizeToContent="Manual"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Title="SnapCut Recording Controls"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        KeyDown="OnWindowKeyDown"
        MouseEnter="OnWindowMouseEnter"
        MouseLeave="OnWindowMouseLeave"
        PreviewMouseLeftButtonDown="OnControlSurfaceMouseLeftButtonDown"
        PreviewMouseLeftButtonUp="OnControlSurfaceMouseLeftButtonUp"
        PreviewMouseMove="OnControlSurfaceMouseMove">
    <Window.Resources>
        <Geometry x:Key="PauseIconGeometry">M 5,4 V 14 M 12,4 V 14</Geometry>
        <Geometry x:Key="ResumeIconGeometry">M 5,3 L 14,9 L 5,15 Z</Geometry>
        <Geometry x:Key="StopIconGeometry">M 4,4 H 14 V 14 H 4 Z</Geometry>
        <Geometry x:Key="CancelIconGeometry">M 4,4 L 14,14 M 14,4 L 4,14</Geometry>
        <Style x:Key="RecordingControlButton" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource EditorToolbarButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EditorToolbarButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource EditorToolbarButtonHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="ControlSurface"
            Padding="7,6"
            Background="{DynamicResource AppPanelBackgroundBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Cursor="SizeAll">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="RecordingStatusPanel"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <TextBlock x:Name="RecordingStatusText"
                           FontSize="10"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                           LineHeight="11"
                           LineStackingStrategy="BlockLineHeight"
                           Text="准备录制"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ElapsedTimeText"
                           Margin="5,0,0,0"
                           FontFamily="Consolas"
                           FontSize="11"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           LineHeight="12"
                           LineStackingStrategy="BlockLineHeight"
                           Text="00:00" />
            </StackPanel>

            <StackPanel x:Name="RecordingOptionsPanel"
                        Grid.Column="1"
                        Margin="8,0,4,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <ComboBox x:Name="CodecComboBox"
                          Width="118"
                          Height="24"
                          Padding="5,0"
                          Margin="0,0,5,0"
                          FontSize="11"
                          Cursor="Arrow"
                          SelectedValuePath="Tag"
                          SelectionChanged="OnRecordingOptionChanged"
                          ToolTip="视频格式与编码">
                    <ComboBoxItem Content="MP4 · H.264" Tag="H264" />
                    <ComboBoxItem Content="MP4 · H.265" Tag="H265" />
                    <ComboBoxItem Content="GIF（无声音）" Tag="Gif" />
                </ComboBox>
                <ComboBox x:Name="FrameRateComboBox"
                          Width="66"
                          Height="24"
                          Padding="5,0"
                          Margin="0,0,7,0"
                          FontSize="11"
                          Cursor="Arrow"
                          SelectedValuePath="Tag"
                          SelectionChanged="OnRecordingOptionChanged"
                          ToolTip="录制帧率">
                    <ComboBoxItem Content="24 FPS" Tag="24" />
                    <ComboBoxItem Content="30 FPS" Tag="30" />
                    <ComboBoxItem Content="60 FPS" Tag="60" />
                </ComboBox>
                <CheckBox x:Name="SystemAudioCheckBox"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"
                          FontSize="11"
                          Cursor="Hand"
                          Checked="OnRecordingOptionChanged"
                          Unchecked="OnRecordingOptionChanged"
                          Content="系统声音"
                          Foreground="{DynamicResource AppTextPrimaryBrush}"
                          ToolTip="录制电脑正在播放的声音" />
                <CheckBox x:Name="MicrophoneCheckBox"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"
                          FontSize="11"
                          Cursor="Hand"
                          Checked="OnRecordingOptionChanged"
                          Unchecked="OnRecordingOptionChanged"
                          Content="麦克风"
                          Foreground="{DynamicResource AppTextPrimaryBrush}"
                          ToolTip="录制系统默认麦克风" />
                <ComboBox x:Name="InputDisplayModeComboBox"
                          Width="104"
                          Height="24"
                          Padding="5,0"
                          FontSize="11"
                          Cursor="Arrow"
                          SelectedValuePath="Tag"
                          SelectionChanged="OnRecordingOptionChanged"
                          ToolTip="在视频中显示键盘或鼠标输入">
                    <ComboBoxItem Content="不显示" Tag="None" />
                    <ComboBoxItem Content="显示鼠标" Tag="Mouse" />
                    <ComboBoxItem Content="显示键盘" Tag="Keyboard" />
                    <ComboBoxItem Content="显示键盘鼠标" Tag="KeyboardAndMouse" />
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Button x:Name="StartButton"
                        Click="OnStartClick"
                        Style="{StaticResource RecordingControlButton}"
                        ToolTip="开始录制">
                    <Ellipse Width="14" Height="14" Fill="#F04455" />
                </Button>
                <Button x:Name="PauseButton"
                        Click="OnPauseClick"
                        IsEnabled="False"
                        Visibility="Collapsed"
                        Style="{StaticResource RecordingControlButton}"
                        ToolTip="暂停录制">
                    <Path x:Name="PauseIcon"
                          Width="16"
                          Height="16"
                          Data="{StaticResource PauseIconGeometry}"
                          Fill="Transparent"
                          Stroke="{DynamicResource EditorToolbarIconBrush}"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          StrokeThickness="2"
                          Stretch="Uniform" />
                </Button>
                <Button x:Name="StopButton"
                        Click="OnStopClick"
                        Style="{StaticResource RecordingControlButton}"
                        ToolTip="取消">
                    <Path x:Name="StopIcon"
                          Width="16"
                          Height="16"
                          Data="{StaticResource CancelIconGeometry}"
                          Fill="Transparent"
                          Stroke="#F04455"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          StrokeThickness="1.8"
                          Stretch="Uniform" />
                </Button>
                <Button x:Name="FinishAndEditButton"
                        Click="OnFinishAndEditClick"
                        IsEnabled="False"
                        Visibility="Collapsed"
                        Style="{StaticResource RecordingControlButton}"
                        ToolTip="结束录制并打开裁剪与导出">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                               Foreground="{DynamicResource EditorToolbarIconBrush}"
                               Text="&#xE70F;" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
