<Window x:Class="Screenshot.App.Capture.VideoRecordingControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:presentation="clr-namespace:Screenshot.App.Presentation"
        xmlns:editor="clr-namespace:Screenshot.App.Editor"
        MinWidth="360"
        Height="64"
        MinHeight="28"
        SizeToContent="Width"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Title="SnapCut Recording Controls"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        KeyDown="OnWindowKeyDown"
        PreviewKeyDown="OnFeatureShortcutPreviewKeyDown"
        PreviewMouseLeftButtonDown="OnControlSurfaceMouseLeftButtonDown"
        PreviewMouseLeftButtonUp="OnControlSurfaceMouseLeftButtonUp"
        PreviewMouseMove="OnControlSurfaceMouseMove">
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="../Themes/ThemedContextMenus.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <Geometry x:Key="PauseIconGeometry">M 5,4 V 14 M 12,4 V 14</Geometry>
        <Geometry x:Key="ResumeIconGeometry">M 5,3 L 14,9 L 5,15 Z</Geometry>
        <Geometry x:Key="StopIconGeometry">M 4,4 H 14 V 14 H 4 Z</Geometry>
        <Geometry x:Key="CancelIconGeometry">M 4,4 L 14,14 M 14,4 L 4,14</Geometry>
        <Geometry x:Key="PointerIconGeometry">M 3,2 L 15,9 L 10,10 L 13,16 L 10,17 L 7,11 L 3,14 Z</Geometry>
        <Geometry x:Key="RectangleIconGeometry">M 2,2 H 16 V 16 H 2 Z</Geometry>
        <Geometry x:Key="EllipseIconGeometry">M 9,2 C 13.5,2 17,5.1 17,9 C 17,12.9 13.5,16 9,16 C 4.5,16 1,12.9 1,9 C 1,5.1 4.5,2 9,2 Z</Geometry>
        <Geometry x:Key="StraightFilledArrowIconGeometry">M 1,7 H 11 V 3 L 18,9 L 11,15 V 11 H 1 Z</Geometry>
        <!-- Keep the original arrow outline and hollow it through transparent fill. -->
        <Geometry x:Key="StraightHollowArrowIconGeometry">M 1,7 H 11 V 3 L 18,9 L 11,15 V 11 H 1 Z</Geometry>
        <Geometry x:Key="CurvedFilledArrowIconGeometry">M 1,4 C 2,11 7,15 13,11 L 11,8 L 18,10 L 14,17 L 13,14 C 5,19 1,13 1,4 Z</Geometry>
        <Geometry x:Key="CurvedHollowArrowIconGeometry">M 1,4 C 2,11 7,15 13,11 L 11,8 L 18,10 L 14,17 L 13,14 C 5,19 1,13 1,4 Z</Geometry>
        <Geometry x:Key="PenIconGeometry">M 3,14 L 4.2,9.8 L 12.6,1.4 L 16.6,5.4 L 8.2,13.8 Z M 11.2,3.8 L 14.2,6.8</Geometry>
        <Geometry x:Key="MosaicIconGeometry">M 2,2 H 16 V 16 H 2 Z M 6.7,2 V 16 M 11.3,2 V 16 M 2,6.7 H 16 M 2,11.3 H 16</Geometry>
        <Geometry x:Key="TextIconGeometry">M 3,3 H 15 M 9,3 V 16</Geometry>
        <Geometry x:Key="CameraIconGeometry">M 2,5 H 11 L 15,2 H 17 V 16 H 15 L 11,13 H 2 Z M 6,7 A 2.5,2.5 0 1 0 6,12 A 2.5,2.5 0 1 0 6,7 Z</Geometry>
        <Geometry x:Key="UndoIconGeometry">M 8,2 L 2,8 L 8,14 V 11 C 13,11 16,13 17,17 C 17,10 13,6 8,6 Z</Geometry>
        <Geometry x:Key="RedoIconGeometry">M 12,2 L 18,8 L 12,14 V 11 C 7,11 4,13 3,17 C 3,10 7,6 12,6 Z</Geometry>
        <Style x:Key="RecordingIconPath" TargetType="Path">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="{DynamicResource EditorToolbarIconBrush}" />
            <Setter Property="StrokeThickness" Value="1.7" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
        <Style x:Key="RecordingControlButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource EditorToolbarButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EditorToolbarButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <presentation:ToolbarButtonSurface x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" LensVisibility="{DynamicResource AppLiquidLensVisibility}"
                                HighlightBrush="{DynamicResource AppControlHighlightBrush}"
                                ReflectionBrush="{DynamicResource AppControlReflectionBrush}"
                                ReflectionRadius="{DynamicResource AppControlCornerRadius}"
                                IsEmphasized="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </presentation:ToolbarButtonSurface>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding LensVisibility, ElementName=ButtonBorder}" Value="Visible">
                                <Setter TargetName="ButtonBorder" Property="CornerRadius" Value="11" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource EditorToolbarButtonHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RecordingToolButton" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource EditorToolbarIconBrush}" />
            <Setter Property="presentation:SelectionMotion.SurfaceName" Value="ButtonBorder" />
            <Setter Property="presentation:SelectionMotion.ThemeVisibility" Value="{DynamicResource AppSelectionMotionVisibility}" />
            <Setter Property="presentation:SelectionMotion.Fill" Value="{DynamicResource EditorToolbarButtonSelectedBackgroundBrush}" />
            <Setter Property="presentation:SelectionMotion.Edge" Value="{DynamicResource EditorToolbarButtonSelectedBorderBrush}" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource EditorToolbarButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EditorToolbarButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <presentation:ToolbarButtonSurface x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" LensVisibility="{DynamicResource AppLiquidLensVisibility}"
                                HighlightBrush="{DynamicResource AppControlHighlightBrush}"
                                ReflectionBrush="{DynamicResource AppControlReflectionBrush}"
                                ReflectionRadius="{DynamicResource AppControlCornerRadius}"
                                IsEmphasized="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </presentation:ToolbarButtonSurface>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding LensVisibility, ElementName=ButtonBorder}" Value="Visible">
                                <Setter TargetName="ButtonBorder" Property="CornerRadius" Value="11" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource EditorToolbarButtonHoverBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{DynamicResource AppAccentMutedBrush}" />
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AppAccentBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="presentation:SelectionMotion.IsHosted" Value="True" />
                                    <Condition Property="IsChecked" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ButtonBorder" Property="Background" Value="Transparent" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="Transparent" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RecordingAudioToggle" TargetType="CheckBox">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Surface" CornerRadius="6" Background="Transparent"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource AppAccentMutedBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RecordingDockButton" TargetType="Button">
            <Setter Property="Width" Value="116" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="{DynamicResource AppFloatingSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DockSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DockSurface" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="DockSurface" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DockSurface" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RecordingEditorSlider" TargetType="Slider">
            <Setter Property="Height" Value="20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="3"
                                    Background="{DynamicResource ImageEditorSliderTrackBrush}"
                                    CornerRadius="1.5" />
                            <Track x:Name="PART_Track"
                                   Height="14"
                                   VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                  IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="3"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource AppAccentBrush}"
                                                        CornerRadius="1.5" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                  IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14"
                                           Height="14"
                                           Background="{DynamicResource AppAccentBrush}"
                                           BorderBrush="{DynamicResource ImageEditorSliderThumbBorderBrush}"
                                           BorderThickness="2">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{TemplateBinding Background}"
                                                         Stroke="{TemplateBinding BorderBrush}"
                                                         StrokeThickness="{TemplateBinding BorderThickness}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RecordingEmojiHostMenuItem" TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <ContentPresenter ContentSource="Header" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RecordingEmojiButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Padding="{TemplateBinding Padding}"
                                Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="WindowRoot"
          Background="Transparent"
          ClipToBounds="False">
    <Border x:Name="ControlSurface"
            RenderTransformOrigin="1,0.5"
            Padding="7,6"
            Background="{DynamicResource AppFloatingSurfaceBrush}"
            BorderBrush="{DynamicResource AppControlEdgeBrush}"
            BorderThickness="1"
            CornerRadius="10"
            QueryCursor="OnControlSurfaceQueryCursor">
        <Border.RenderTransform>
            <ScaleTransform x:Name="ToolbarVisualScale" ScaleX="1" ScaleY="1" />
        </Border.RenderTransform>
        <Grid x:Name="ToolbarGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="ToolbarLayoutScale"
                                ScaleX="1"
                                ScaleY="1" />
            </Grid.LayoutTransform>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="RecordingStatusPanel" Orientation="Horizontal"
                        Margin="4,0,16,0" VerticalAlignment="Center">
                <Ellipse x:Name="RecordingStatusDot" Width="8" Height="8" Margin="0,0,8,0"
                         Fill="#F04455" Visibility="Collapsed" />
                <TextBlock x:Name="RecordingStatusText" FontSize="13" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AppTextPrimaryBrush}" Text="准备录制" />
                <TextBlock x:Name="ElapsedTimeText" Margin="10,0,0,0"
                           FontFamily="Consolas" FontSize="13" VerticalAlignment="Center"
                           Foreground="{DynamicResource AppTextSecondaryBrush}" Text="00:00" />
            </StackPanel>

            <StackPanel x:Name="RecordingOptionsPanel" Grid.Column="1" Height="44"
                        Margin="0,0,10,0" Orientation="Horizontal"
                        HorizontalAlignment="Left" VerticalAlignment="Center">
                <StackPanel x:Name="EncodingOptionsPanel" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ComboBox x:Name="CodecComboBox" Width="144" MinWidth="144" Height="36"
                              Padding="9,0,28,0" Margin="0,0,8,0" FontSize="12"
                              SelectedValuePath="Tag" SelectionChanged="OnRecordingOptionChanged"
                              ToolTip="视频格式与编码">
                        <ComboBoxItem Content="MP4 · H.264" Tag="H264" />
                        <ComboBoxItem Content="MP4 · H.265" Tag="H265" />
                        <ComboBoxItem Content="GIF（无声音）" Tag="Gif" />
                    </ComboBox>
                    <ComboBox x:Name="FrameRateComboBox" Width="100" MinWidth="100" Height="36"
                              Padding="9,0,28,0" Margin="0,0,8,0" FontSize="12"
                              SelectedValuePath="Tag" SelectionChanged="OnRecordingOptionChanged"
                              ToolTip="录制帧率">
                        <ComboBoxItem Content="24 FPS" Tag="24" />
                        <ComboBoxItem Content="30 FPS" Tag="30" />
                        <ComboBoxItem Content="60 FPS" Tag="60" />
                    </ComboBox>
                </StackPanel>
                <CheckBox x:Name="SystemAudioCheckBox" Style="{StaticResource RecordingAudioToggle}"
                          Checked="OnRecordingOptionChanged" Unchecked="OnRecordingOptionChanged"
                          ToolTip="录制电脑正在播放的声音">
                    <Path Width="20" Height="20" Stretch="Uniform" Fill="Transparent"
                          Stroke="{DynamicResource EditorToolbarIconBrush}" StrokeThickness="1.6"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 2,7 H 6 L 11,3 V 17 L 6,13 H 2 Z M 14,6 Q 18,10 14,14 M 17,3 Q 23,10 17,17" />
                </CheckBox>
                <CheckBox x:Name="MicrophoneCheckBox" Style="{StaticResource RecordingAudioToggle}"
                          Checked="OnRecordingOptionChanged" Unchecked="OnRecordingOptionChanged"
                          ToolTip="录制系统默认麦克风">
                    <Path Width="20" Height="20" Stretch="Uniform" Fill="Transparent"
                          Stroke="{DynamicResource EditorToolbarIconBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 7,5 A 3,3 0 0 1 13,5 V 10 A 3,3 0 0 1 7,10 Z M 4,9 V 10 A 6,6 0 0 0 16,10 V 9 M 10,16 V 20 M 7,20 H 13" />
                </CheckBox>
                <CheckBox x:Name="ShowCameraCheckBox" Style="{StaticResource RecordingAudioToggle}"
                          Checked="OnRecordingOptionChanged" Unchecked="OnRecordingOptionChanged"
                          ToolTip="显示/隐藏摄像头">
                    <Path Data="{StaticResource CameraIconGeometry}" Style="{StaticResource RecordingIconPath}" />
                </CheckBox>
            </StackPanel>

            <Border x:Name="AnnotationRow" Grid.Row="1" Grid.ColumnSpan="3"
                    Visibility="{Binding Visibility, ElementName=AnnotationToolsPanel}"
                    Margin="0,8,0,0" Padding="0,6,0,0" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource AppSubtleBorderBrush}">
              <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <StackPanel x:Name="RecordingAnnotationMainRow" Orientation="Horizontal" HorizontalAlignment="Center">

            <StackPanel x:Name="AnnotationToolsPanel"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <ToggleButton x:Name="CameraToggleButton"
                              Visibility="Collapsed"
                              Click="OnCameraToggleClick"
                              Style="{StaticResource RecordingToolButton}"
                              Tag="Camera"
                              ToolTip="显示/隐藏摄像头">
                              <Path Data="{StaticResource CameraIconGeometry}"
                          Style="{StaticResource RecordingIconPath}" />
                </ToggleButton>
                <Border Width="1" Height="18" Margin="4,0,3,0" Visibility="Collapsed"
                        Background="{DynamicResource AppBorderBrush}" />
                <ToggleButton x:Name="ShapeToolButton"
                              Click="OnAnnotationToolClick"
                              Style="{StaticResource RecordingToolButton}"
                              Tag="Rectangle"
                              ToolTip="矩形/椭圆">
                    <ToggleButton.ContextMenu>
                        <ContextMenu Style="{StaticResource ThemedContextMenuStyle}">
                            <MenuItem Tag="Rectangle" IsCheckable="True"
                                      Style="{StaticResource ThemedMenuItemStyle}"
                                      Click="OnRecordingShapeMenuItemClick">
                                <MenuItem.Header><StackPanel Orientation="Horizontal"><Path Width="18" Height="18" Margin="0,0,8,0" Data="{StaticResource RectangleIconGeometry}" Fill="Transparent" Stroke="{DynamicResource AppControlForegroundBrush}" StrokeThickness="1.6" /><TextBlock VerticalAlignment="Center" Text="矩形" /></StackPanel></MenuItem.Header>
                            </MenuItem>
                            <MenuItem Tag="Ellipse" IsCheckable="True"
                                      Style="{StaticResource ThemedMenuItemStyle}"
                                      Click="OnRecordingShapeMenuItemClick">
                                <MenuItem.Header><StackPanel Orientation="Horizontal"><Path Width="18" Height="18" Margin="0,0,8,0" Data="{StaticResource EllipseIconGeometry}" Fill="Transparent" Stroke="{DynamicResource AppControlForegroundBrush}" StrokeThickness="1.6" /><TextBlock VerticalAlignment="Center" Text="椭圆" /></StackPanel></MenuItem.Header>
                            </MenuItem>
                        </ContextMenu>
                    </ToggleButton.ContextMenu>
                    <Grid Width="20">
                        <Path x:Name="ShapeToolIcon"
                              Width="18" Height="18"
                              HorizontalAlignment="Center"
                              Data="{StaticResource RectangleIconGeometry}"
                              Style="{StaticResource RecordingIconPath}" />
                    </Grid>
                </ToggleButton>
                <ToggleButton x:Name="ArrowToolButton"
                              Click="OnAnnotationToolClick"
                              Style="{StaticResource RecordingToolButton}"
                              Tag="Arrow"
                              ToolTip="箭头：在录制区域内拖动">
                    <ToggleButton.ContextMenu>
                        <ContextMenu Style="{StaticResource ThemedContextMenuStyle}">
                            <MenuItem Tag="Arrow,Filled" Style="{StaticResource ThemedMenuItemStyle}" Click="OnRecordingArrowMenuItemClick"><MenuItem.Header><StackPanel Orientation="Horizontal"><Path Width="18" Height="18" Margin="0,0,8,0" Data="{StaticResource StraightFilledArrowIconGeometry}" Fill="{DynamicResource AppControlForegroundBrush}" /><TextBlock VerticalAlignment="Center" Text="直线实心箭头" /></StackPanel></MenuItem.Header></MenuItem>
                            <MenuItem Tag="Arrow,Hollow" Style="{StaticResource ThemedMenuItemStyle}" Click="OnRecordingArrowMenuItemClick"><MenuItem.Header><StackPanel Orientation="Horizontal"><Path Width="18" Height="18" Margin="0,0,8,0" Data="{StaticResource StraightHollowArrowIconGeometry}" Fill="Transparent" Stroke="{DynamicResource AppControlForegroundBrush}" StrokeThickness="1.8" /><TextBlock VerticalAlignment="Center" Text="直线空心箭头" /></StackPanel></MenuItem.Header></MenuItem>
                            <MenuItem Tag="CurvedArrow,Filled" Style="{StaticResource ThemedMenuItemStyle}" Click="OnRecordingArrowMenuItemClick"><MenuItem.Header><StackPanel Orientation="Horizontal"><Path Width="18" Height="18" Margin="0,0,8,0" Data="{StaticResource CurvedFilledArrowIconGeometry}" Fill="{DynamicResource AppControlForegroundBrush}" /><TextBlock VerticalAlignment="Center" Text="弧形实心箭头" /></StackPanel></MenuItem.Header></MenuItem>
                            <MenuItem Tag="CurvedArrow,Hollow" Style="{StaticResource ThemedMenuItemStyle}" Click="OnRecordingArrowMenuItemClick"><MenuItem.Header><StackPanel Orientation="Horizontal"><Path Width="18" Height="18" Margin="0,0,8,0" Data="{StaticResource CurvedHollowArrowIconGeometry}" Fill="Transparent" Stroke="{DynamicResource AppControlForegroundBrush}" StrokeThickness="1.8" /><TextBlock VerticalAlignment="Center" Text="弧形空心箭头" /></StackPanel></MenuItem.Header></MenuItem>
                        </ContextMenu>
                    </ToggleButton.ContextMenu>
                    <Grid Width="20">
                        <Path x:Name="ArrowToolIcon"
                              Width="18" Height="18"
                              HorizontalAlignment="Center"
                              Data="{StaticResource StraightFilledArrowIconGeometry}"
                              Fill="{DynamicResource EditorToolbarIconBrush}"
                              Stretch="Uniform" />
                    </Grid>
                </ToggleButton>
                <ToggleButton x:Name="DoubleArrowToolButton" Tag="DoubleArrow" Click="OnAnnotationToolClick"
                              Foreground="{DynamicResource EditorToolbarIconBrush}"
                              Style="{StaticResource RecordingToolButton}" ToolTip="双向箭头" />
                <ToggleButton x:Name="EmojiToolButton"
                              Click="OnAnnotationToolClick"
                              Style="{StaticResource RecordingToolButton}"
                              Tag="Emoji"
                              ToolTip="表情；右键选择表情">
                    <ToggleButton.ContextMenu>
                        <ContextMenu x:Name="RecordingEmojiMenu"
                                     ItemContainerStyle="{StaticResource RecordingEmojiHostMenuItem}"
                                     Style="{StaticResource ThemedContextMenuStyle}" />
                    </ToggleButton.ContextMenu>
                    <Grid Width="20">
                        <editor:EmojiStickerImage x:Name="EmojiToolIcon"
                                                  Width="22" Height="22"
                                                  HorizontalAlignment="Center"
                                                  Sticker="😊" />
                    </Grid>
                </ToggleButton>
                <ToggleButton x:Name="NumberToolButton"
                              Click="OnAnnotationToolClick"
                              Style="{StaticResource RecordingToolButton}"
                              Tag="Number"
                              ToolTip="序号标注">
                    <Border Width="19" Height="19"
                            Background="{DynamicResource EditorToolbarIconBrush}"
                            CornerRadius="9.5">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource AppPanelBackgroundBrush}"
                                   Text="1" />
                    </Border>
                </ToggleButton>
                <ToggleButton x:Name="BrushToolButton"
                              Click="OnAnnotationToolClick"
                              Style="{StaticResource RecordingToolButton}"
                              Tag="Brush"
                              ToolTip="画笔：在录制区域内拖动">
                    <Path Data="{StaticResource PenIconGeometry}"
                          Style="{StaticResource RecordingIconPath}" />
                </ToggleButton>
                <ToggleButton x:Name="TextToolButton"
                              Click="OnAnnotationToolClick"
                              Style="{StaticResource RecordingToolButton}"
                              Tag="Text"
                              ToolTip="文字（Ctrl+Enter 完成）">
                    <Path Data="{StaticResource TextIconGeometry}"
                          Style="{StaticResource RecordingIconPath}" />
                </ToggleButton>
                <ToggleButton x:Name="MosaicToolButton"
                              Click="OnAnnotationToolClick"
                              Style="{StaticResource RecordingToolButton}"
                              Tag="Mosaic"
                              ToolTip="马赛克：在录制区域内拖动">
                    <Path Data="{StaticResource MosaicIconGeometry}"
                          Style="{StaticResource RecordingIconPath}" />
                </ToggleButton>
            </StackPanel>
            <StackPanel x:Name="AnnotationHistoryPanel" Orientation="Horizontal">
                <Border Width="1" Height="18" Margin="4,0,3,0"
                        Background="{DynamicResource AppBorderBrush}" />
                <Button Click="OnAnnotationUndoClick"
                        Style="{StaticResource RecordingControlButton}"
                        ToolTip="撤销上一项标注">
                    <Path Data="{StaticResource UndoIconGeometry}"
                          Style="{StaticResource RecordingIconPath}" />
                </Button>
                <Button Click="OnAnnotationRedoClick"
                        Style="{StaticResource RecordingControlButton}"
                        ToolTip="重做标注">
                    <Path Data="{StaticResource RedoIconGeometry}"
                          Style="{StaticResource RecordingIconPath}" />
                </Button>
                <Button Click="OnAnnotationClearClick"
                        Style="{StaticResource RecordingControlButton}"
                        ToolTip="清除所有标记">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="18"
                               Foreground="{DynamicResource EditorToolbarIconBrush}"
                               Text="&#xE74D;" />
                </Button>
            </StackPanel>
            </StackPanel>
            <presentation:ToolbarAdjustmentPanel x:Name="RecordingAdjustmentLine"
                WidthSource="{Binding ElementName=RecordingAnnotationMainRow}">
            <StackPanel x:Name="AnnotationPropertiesPanel"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Visibility="Collapsed">
                <Button x:Name="AnnotationColorButton"
                        Click="OnAnnotationColorClick"
                        Style="{StaticResource RecordingControlButton}"
                        ToolTip="标注颜色">
                    <Grid Width="26" Height="26">
                        <Rectangle x:Name="AnnotationColorSwatch" RadiusX="3" RadiusY="3" Fill="#F04455"
                                   Stroke="{DynamicResource AppBorderBrush}" StrokeThickness="1" />
                        <Path x:Name="AnnotationColorCheckMark" Margin="6" Data="M 1,6 L 5,10 L 13,1" Stretch="Uniform"
                              Stroke="White" StrokeThickness="2" StrokeLineJoin="Round" />
                    </Grid>
                </Button>
                <Button x:Name="AnnotationCyanColorButton" Style="{StaticResource RecordingControlButton}" Tag="#00A6B2"
                        Click="OnAnnotationQuickColorClick" ToolTip="青色">
                    <Rectangle Width="24" Height="24" RadiusX="3" RadiusY="3" Fill="#00A6B2"
                               Stroke="{DynamicResource AppBorderBrush}" StrokeThickness="1" />
                </Button>
                <Button x:Name="AnnotationWhiteColorButton" Style="{StaticResource RecordingControlButton}" Tag="#FFFFFF"
                        Click="OnAnnotationQuickColorClick" ToolTip="白色">
                    <Rectangle Width="24" Height="24" RadiusX="3" RadiusY="3" Fill="#FFFFFF"
                               Stroke="{DynamicResource AppBorderBrush}" StrokeThickness="1" />
                </Button>
                <Slider x:Name="AnnotationStrokeWidthSlider"
                        Width="90" Height="20"
                        Margin="5,0,1,0"
                        VerticalAlignment="Center"
                        Minimum="1" Maximum="12" Value="3"
                        SmallChange="1" LargeChange="2"
                        TickFrequency="1"
                        Style="{StaticResource RecordingEditorSlider}"
                        ValueChanged="OnAnnotationStrokeWidthChanged"
                        PreviewMouseLeftButtonUp="OnAnnotationStrokeWidthCommitted"
                        LostKeyboardFocus="OnAnnotationStrokeWidthCommitted"
                        ToolTip="标注大小" />
                <TextBlock Text="{Binding Value, ElementName=AnnotationStrokeWidthSlider, StringFormat={}{0:0} px}"
                           Margin="5,0,0,0" MinWidth="30" VerticalAlignment="Center"
                           Foreground="{DynamicResource EditorToolbarIconBrush}" />
            </StackPanel>
            <presentation:ToolbarOptionsRow x:Name="RecordingToolAdjustments" Margin="8,0,0,0" VerticalAlignment="Center" />
            </presentation:ToolbarAdjustmentPanel>

              </StackPanel>
            </Border>

            <StackPanel x:Name="RecordingActionPanel"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Button x:Name="RecordingSettingsButton" Click="OnRecordingSettingsClick"
                        Style="{StaticResource RecordingControlButton}"
                        ToolTip="输入显示与录制设备">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="18"
                               Foreground="{DynamicResource EditorToolbarIconBrush}" Text="&#xE713;" />
                </Button>
                <Border Width="1" Height="18" Margin="3,0,4,0"
                        Background="{DynamicResource AppBorderBrush}" />
                <Button x:Name="DockToolbarButton"
                        Click="OnDockToolbarClick"
                        Visibility="Collapsed"
                        Style="{StaticResource RecordingControlButton}"
                        ToolTip="收起录制工具栏">
                    <Path Width="18" Height="18" Stretch="Uniform"
                          Data="M 3,3 H 15 V 15 H 3 Z M 6,9 H 12 M 9,6 L 12,9 L 9,12"
                          Fill="Transparent" Stroke="{DynamicResource EditorToolbarIconBrush}"
                          StrokeThickness="1.6" StrokeLineJoin="Round"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
                <Button x:Name="StartButton"
                        Click="OnStartClick"
                        Style="{StaticResource RecordingControlButton}"
                        ToolTip="开始录制">
                    <Ellipse Width="22" Height="22" Fill="#F04455" Stroke="White" StrokeThickness="1.5" />
                </Button>
                <Button x:Name="PauseButton"
                        Click="OnPauseClick"
                        IsEnabled="False"
                        Visibility="Collapsed"
                        Style="{StaticResource RecordingControlButton}"
                        ToolTip="暂停录制">
                    <Path x:Name="PauseIcon"
                          Width="18"
                          Height="18"
                          Data="{StaticResource PauseIconGeometry}"
                          Fill="Transparent"
                          Stroke="{DynamicResource EditorToolbarIconBrush}"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          StrokeThickness="2"
                          Stretch="Uniform" />
                </Button>
                <Button x:Name="StopButton"
                        Click="OnStopClick"
                        Style="{StaticResource RecordingControlButton}"
                        ToolTip="取消">
                    <Path x:Name="StopIcon"
                          Width="18"
                          Height="18"
                          Data="{StaticResource CancelIconGeometry}"
                          Fill="Transparent"
                          Stroke="#F04455"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          StrokeThickness="1.8"
                          Stretch="Uniform" />
                </Button>
                <Button x:Name="CancelRecordingButton"
                        Click="OnCancelRecordingClick"
                        IsEnabled="False"
                        Visibility="Collapsed"
                        Style="{StaticResource RecordingControlButton}"
                        ToolTip="取消录制并删除本次视频">
                    <Path Width="18" Height="18"
                          Data="{StaticResource CancelIconGeometry}"
                          Fill="Transparent"
                          Stroke="#F04455"
                          StrokeThickness="1.8"
                          Stretch="Uniform" />
                </Button>
                <Button x:Name="FinishAndEditButton"
                        Click="OnFinishAndEditClick"
                        IsEnabled="False"
                        Visibility="Collapsed"
                        Style="{StaticResource RecordingControlButton}"
                        ToolTip="结束录制并打开裁剪与导出">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="18"
                               Foreground="{DynamicResource EditorToolbarIconBrush}"
                               Text="&#xE70F;" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
    <Popup x:Name="RecordingDevicePopup" Placement="Top"
           PlacementTarget="{Binding ElementName=RecordingSettingsButton}"
           AllowsTransparency="True" StaysOpen="False">
        <Border Padding="16" Margin="0,0,0,8" CornerRadius="10"
                Background="{DynamicResource AppFloatingSurfaceBrush}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="44" /><RowDefinition Height="40" />
                    <RowDefinition Height="44" /><RowDefinition Height="44" />
                </Grid.RowDefinitions>
                <TextBlock Grid.ColumnSpan="2" Margin="0,0,0,10" Text="输入显示与录制设备"
                           FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                <TextBlock Grid.Row="1" Text="输入显示" VerticalAlignment="Center" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                <ComboBox x:Name="InputDisplayModeComboBox" Grid.Row="1" Grid.Column="1"
                          Width="220" Height="32" Padding="8,0,28,0" FontSize="12"
                          SelectedValuePath="Tag" SelectionChanged="OnRecordingOptionChanged">
                    <ComboBoxItem Content="不显示" Tag="None" />
                    <ComboBoxItem Content="显示鼠标" Tag="Mouse" />
                    <ComboBoxItem Content="显示键盘" Tag="Keyboard" />
                    <ComboBoxItem Content="显示键盘鼠标" Tag="KeyboardAndMouse" />
                </ComboBox>
                <CheckBox x:Name="MouseTrailCheckBox" Grid.Row="2" Grid.ColumnSpan="2"
                          Content="鼠标移动轨迹" VerticalAlignment="Center"
                          Checked="OnRecordingOptionChanged" Unchecked="OnRecordingOptionChanged"
                          Foreground="{DynamicResource AppTextPrimaryBrush}" />
                <TextBlock Grid.Row="3" Text="麦克风" VerticalAlignment="Center" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                <ComboBox x:Name="MicrophoneDeviceComboBox" Grid.Row="3" Grid.Column="1"
                          Width="220" Height="32" Padding="8,0,28,0" FontSize="12"
                          DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectionChanged="OnMicrophoneDeviceChanged" ToolTip="选择录音麦克风" />
                <TextBlock Grid.Row="4" Text="摄像头" VerticalAlignment="Center" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                <ComboBox x:Name="CameraDeviceComboBox" Grid.Row="4" Grid.Column="1"
                          Width="220" Height="32" Padding="8,0,28,0" FontSize="12"
                          DisplayMemberPath="Name" SelectedValuePath="Id"
                          SelectionChanged="OnCameraDeviceChanged" ToolTip="选择摄像头" />
            </Grid>
        </Border>
    </Popup>
    <Button x:Name="CollapsedToolbarButton"
            RenderTransformOrigin="0.5,0.5"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            PreviewMouseLeftButtonDown="OnCollapsedToolbarMouseLeftButtonDown"
            PreviewMouseMove="OnCollapsedToolbarMouseMove"
            PreviewMouseLeftButtonUp="OnCollapsedToolbarMouseLeftButtonUp"
            LostMouseCapture="OnCollapsedToolbarLostMouseCapture"
            Click="OnCollapsedToolbarClick"
            Visibility="Collapsed"
            Panel.ZIndex="999"
            Style="{StaticResource RecordingDockButton}"
            AutomationProperties.Name="展开录制工具栏"
            ToolTip="点击展开录制工具栏 · 按住拖动">
        <Button.RenderTransform>
            <ScaleTransform x:Name="CollapsedToolbarScale" ScaleX="1" ScaleY="1" />
        </Button.RenderTransform>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Grid Width="22" Height="22" Margin="0,0,7,0">
                <Path Data="M 7,2 H 5 Q 2,2 2,5 V 7 M 15,2 H 17 Q 20,2 20,5 V 7 M 20,15 V 17 Q 20,20 17,20 H 15 M 7,20 H 5 Q 2,20 2,17 V 15"
                      Stroke="{DynamicResource AppTextPrimaryBrush}" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.8" />
                <Ellipse Width="8" Height="8" Fill="#F04455">
                    <Ellipse.Style><Style TargetType="Ellipse">
                        <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=RecordingStatusText}" Value="已暂停">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger></Style.Triggers>
                    </Style></Ellipse.Style>
                </Ellipse>
                <Path x:Name="CollapsedPauseIcon" Data="M 8,7 V 15 M 14,7 V 15"
                      Stroke="#E8AD50" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                    <Path.Style><Style TargetType="Path">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=RecordingStatusText}" Value="已暂停">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger></Style.Triggers>
                    </Style></Path.Style>
                </Path>
            </Grid>
            <TextBlock x:Name="CollapsedElapsedText" Text="{Binding Text, ElementName=ElapsedTimeText}"
                       FontFamily="Consolas" FontSize="11" Width="53" TextAlignment="Center"
                       VerticalAlignment="Center" Foreground="{DynamicResource AppTextPrimaryBrush}" />
            <Path Width="5" Height="9" Margin="5,0,0,0" Stretch="Uniform"
                  Data="M 4,1 L 0,5 L 4,9" Stroke="{DynamicResource AppTextSecondaryBrush}"
                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        </StackPanel>
    </Button>
    </Grid>
</Window>
