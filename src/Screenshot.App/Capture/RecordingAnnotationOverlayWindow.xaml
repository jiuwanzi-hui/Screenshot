<Window x:Class="Screenshot.App.Capture.RecordingAnnotationOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editor="clr-namespace:Screenshot.App.Editor"
        AllowsTransparency="True"
        Background="Transparent"
        Cursor="Arrow"
        Focusable="True"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        Title="SnapCut Recording Annotations"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowStyle="None">
    <editor:ImageEditorCanvas x:Name="DrawingCanvas"
                              Background="Transparent" />
</Window>
