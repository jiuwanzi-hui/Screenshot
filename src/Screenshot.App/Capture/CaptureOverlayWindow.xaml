<Window x:Class="Screenshot.App.Capture.CaptureOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:presentation="clr-namespace:Screenshot.App.Presentation"
        xmlns:editor="clr-namespace:Screenshot.App.Editor"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        AllowsTransparency="True"
        Background="Transparent"
        Focusable="True"
        FontFamily="Microsoft YaHei UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        ShowInTaskbar="False"
        Title="SnapCut Capture"
        Topmost="True"
        WindowStyle="None"
        PreviewKeyDown="OnCaptureWindowPreviewKeyDown"
        TextInput="OnCaptureWindowTextInput">
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="../Themes/ThemedContextMenus.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <Geometry x:Key="UndoIconGeometry">M 8,2 L 2,8 L 8,14 V 11 C 13,11 16,13 17,17 C 17,10 13,6 8,6 Z</Geometry>
        <Geometry x:Key="RedoIconGeometry">M 12,2 L 18,8 L 12,14 V 11 C 7,11 4,13 3,17 C 3,10 7,6 12,6 Z</Geometry>
        <Geometry x:Key="RectangleIconGeometry">M 2,2 H 16 V 16 H 2 Z</Geometry>
        <Geometry x:Key="EllipseIconGeometry">M 9,2 C 13.5,2 17,5.1 17,9 C 17,12.9 13.5,16 9,16 C 4.5,16 1,12.9 1,9 C 1,5.1 4.5,2 9,2 Z</Geometry>
        <Geometry x:Key="ArrowIconGeometry">M 2,9 H 15 M 10,4 L 15,9 L 10,14</Geometry>
        <Geometry x:Key="CurvedArrowIconGeometry">M 2,14 C 4,3 12,3 15,9 M 10,6 L 15,9 L 12,14</Geometry>
        <Geometry x:Key="StraightFilledArrowIconGeometry">M 1,7 H 11 V 3 L 18,9 L 11,15 V 11 H 1 Z</Geometry>
        <Geometry x:Key="StraightHollowArrowIconGeometry">M 1,7 H 11 V 3 L 18,9 L 11,15 V 11 H 1 Z</Geometry>
        <Geometry x:Key="CurvedFilledArrowIconGeometry">M 1,4 C 2,11 7,15 13,11 L 11,8 L 18,10 L 14,17 L 13,14 C 5,19 1,13 1,4 Z</Geometry>
        <Geometry x:Key="CurvedHollowArrowIconGeometry">M 1,4 C 2,11 7,15 13,11 L 11,8 L 18,10 L 14,17 L 13,14 C 5,19 1,13 1,4 Z</Geometry>
        <Geometry x:Key="PenIconGeometry">M 3,14 L 4.2,9.8 L 12.6,1.4 L 16.6,5.4 L 8.2,13.8 Z M 11.2,3.8 L 14.2,6.8</Geometry>
        <Geometry x:Key="MosaicIconGeometry">M 2,2 H 16 V 16 H 2 Z M 6.7,2 V 16 M 11.3,2 V 16 M 2,6.7 H 16 M 2,11.3 H 16</Geometry>
        <Geometry x:Key="TableIconGeometry">M 2,2 H 16 V 16 H 2 Z M 2,6 H 16 M 7,6 V 16 M 12,6 V 16 M 7,11 H 16</Geometry>
        <Geometry x:Key="TextIconGeometry">M 3,3 H 15 M 9,3 V 16</Geometry>
        <Geometry x:Key="SaveIconGeometry">M 3,2 H 13 L 16,5 V 16 H 3 Z M 5,2 V 7 H 13 V 2 M 6,11 H 13 V 16 H 6 Z</Geometry>
        <Geometry x:Key="RecordIconGeometry">M 2,4 H 12 V 14 H 2 Z M 12,7 L 16,4 V 14 L 12,11 Z</Geometry>
        <Geometry x:Key="ScrollIconGeometry">M 9,2 V 16 M 6,5 L 9,2 L 12,5 M 6,13 L 9,16 L 12,13</Geometry>
        <Geometry x:Key="OcrIconGeometry">M 2,5 V 2 H 5 M 13,2 H 16 V 5 M 16,13 V 16 H 13 M 5,16 H 2 V 13 M 5,12 L 8,5 L 11,12 M 6,10 H 10</Geometry>
        <Geometry x:Key="PinIconGeometry">M 6,2 H 12 L 11.5,6 L 14,8.5 L 10,9.5 L 9,16 L 8,9.5 L 4,8.5 L 6.5,6 Z</Geometry>
        <Geometry x:Key="CancelIconGeometry">M 4,4 L 14,14 M 14,4 L 4,14</Geometry>
        <Geometry x:Key="ConfirmIconGeometry">M 3,9 L 7,13 L 15,4</Geometry>
        <LinearGradientBrush x:Key="InlineHueGradientBrush" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Offset="0" Color="#EF4444" />
            <GradientStop Offset="0.16" Color="#FACC15" />
            <GradientStop Offset="0.33" Color="#22C55E" />
            <GradientStop Offset="0.50" Color="#06B6D4" />
            <GradientStop Offset="0.66" Color="#3B82F6" />
            <GradientStop Offset="0.83" Color="#A855F7" />
            <GradientStop Offset="1" Color="#EF4444" />
        </LinearGradientBrush>
        <Style x:Key="InlineIconPath" TargetType="Path">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="{DynamicResource EditorToolbarIconBrush}" />
            <Setter Property="StrokeThickness" Value="1.7" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="HorizontalAlignment" Value="Center" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
        <Style x:Key="InlineGlyphIcon" TargetType="TextBlock">
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource EditorToolbarIconBrush}" />
        </Style>
        <Style x:Key="InlineToolButton" TargetType="RadioButton">
            <Setter Property="presentation:SelectionMotion.SurfaceName" Value="ToolBackground" />
            <Setter Property="presentation:SelectionMotion.ThemeVisibility" Value="{DynamicResource AppSelectionMotionVisibility}" />
            <Setter Property="presentation:SelectionMotion.Fill" Value="{DynamicResource EditorToolbarButtonSelectedBackgroundBrush}" />
            <Setter Property="presentation:SelectionMotion.Edge" Value="{DynamicResource EditorToolbarButtonSelectedBorderBrush}" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource EditorToolbarIconBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource EditorToolbarButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EditorToolbarButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <presentation:ToolbarButtonSurface x:Name="ToolBackground"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource EditorToolbarButtonCornerRadius}"
                                LensVisibility="{DynamicResource AppLiquidLensVisibility}"
                                HighlightBrush="{DynamicResource AppControlHighlightBrush}"
                                ReflectionBrush="{DynamicResource AppControlReflectionBrush}"
                                ReflectionRadius="{DynamicResource AppControlCornerRadius}"
                                IsEmphasized="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </presentation:ToolbarButtonSurface>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToolBackground"
                                        Property="Background"
                                        Value="{DynamicResource EditorToolbarButtonHoverBackgroundBrush}" />
                                <Setter TargetName="ToolBackground"
                                        Property="BorderBrush"
                                        Value="{DynamicResource EditorToolbarButtonHoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ToolBackground"
                                        Property="Background"
                                        Value="{DynamicResource EditorToolbarButtonPressedBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToolBackground"
                                        Property="Background"
                                        Value="{DynamicResource EditorToolbarButtonSelectedBackgroundBrush}" />
                                <Setter TargetName="ToolBackground"
                                        Property="BorderBrush"
                                        Value="{DynamicResource EditorToolbarButtonSelectedBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource EditorToolbarIconBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="presentation:SelectionMotion.IsHosted" Value="True" />
                                    <Condition Property="IsChecked" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ToolBackground" Property="Background" Value="Transparent" />
                                <Setter TargetName="ToolBackground" Property="BorderBrush" Value="Transparent" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InlineActionButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource EditorToolbarIconBrush}" />
            <Setter Property="Background" Value="{DynamicResource EditorToolbarButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EditorToolbarButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <presentation:ToolbarButtonSurface x:Name="ActionBackground"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource EditorToolbarButtonCornerRadius}"
                                LensVisibility="{DynamicResource AppLiquidLensVisibility}"
                                HighlightBrush="{DynamicResource AppControlHighlightBrush}"
                                ReflectionBrush="{DynamicResource AppControlReflectionBrush}"
                                ReflectionRadius="{DynamicResource AppControlCornerRadius}"
                                IsEmphasized="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </presentation:ToolbarButtonSurface>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBackground" Property="Background" Value="{DynamicResource EditorToolbarButtonHoverBackgroundBrush}" />
                                <Setter TargetName="ActionBackground" Property="BorderBrush" Value="{DynamicResource EditorToolbarButtonHoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ActionBackground" Property="Background" Value="{DynamicResource EditorToolbarButtonPressedBackgroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionBackground" Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InlineColorSwatch" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,4,5,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Swatch"
                                     Fill="{TemplateBinding Background}"
                                     Stroke="{TemplateBinding BorderBrush}"
                                     StrokeThickness="{TemplateBinding BorderThickness}" />
                            <ContentPresenter x:Name="SwatchContent" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        <Grid x:Name="SelectedMark" Visibility="Collapsed" IsHitTestVisible="False">
                                <Ellipse Margin="0.5" Stroke="#17212B" StrokeThickness="3" />
                                <Ellipse Margin="1" Stroke="White" StrokeThickness="1.5" />
                                <Path Data="M 0,4 L 3,7 L 9,0" Width="10" Height="8" Stretch="Fill" Stroke="#17212B" StrokeThickness="4" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Path Data="M 0,4 L 3,7 L 9,0" Width="10" Height="8" Stretch="Fill" Stroke="White" StrokeThickness="2" StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="editor:AnnotationColorSwatch.IsSelected" Value="True">
                                <Setter TargetName="SelectedMark" Property="Visibility" Value="Visible" />
                                <Setter TargetName="SwatchContent" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Swatch" Property="Stroke" Value="#F2FFFC" />
                                <Setter TargetName="Swatch" Property="StrokeThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InlineEmojiButton" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Background" Value="{DynamicResource AppPanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="InlineToolbarSeparator" TargetType="Border">
            <Setter Property="Width" Value="2" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="14,3" />
            <Setter Property="Background" Value="{DynamicResource AppSeparatorBrush}" />
            <Setter Property="CornerRadius" Value="1" />
        </Style>
        <Style x:Key="InlineStrokeSlider" TargetType="Slider">
            <Setter Property="Width" Value="82" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="3"
                                    Background="{DynamicResource ImageEditorSliderTrackBrush}"
                                    CornerRadius="1.5" />
                            <Track x:Name="PART_Track"
                                   Height="16"
                                   VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="3" VerticalAlignment="Center"
                                                        Background="{DynamicResource AppAccentBrush}"
                                                        CornerRadius="1.5" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14"
                                           Background="{DynamicResource AppAccentBrush}"
                                           BorderBrush="{DynamicResource ImageEditorSliderThumbBorderBrush}"
                                           BorderThickness="2"
                                           Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{TemplateBinding Background}"
                                                         Stroke="{TemplateBinding BorderBrush}"
                                                         StrokeThickness="{TemplateBinding BorderThickness}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InlineColorPickerSlider" TargetType="Slider">
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource AppAccentTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ImageEditorSliderTrackBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="5"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2.5" />
                            <Track x:Name="PART_Track"
                                   Height="18"
                                   VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                  IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border x:Name="ColorPickerDecreaseTrack"
                                                        Height="5"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource AppAccentBrush}"
                                                        CornerRadius="2.5" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                  IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="13"
                                           Height="13"
                                           Background="{DynamicResource AppAccentBrush}"
                                           BorderBrush="{DynamicResource ImageEditorSliderThumbBorderBrush}"
                                           BorderThickness="2">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{TemplateBinding Background}"
                                                         Stroke="{TemplateBinding BorderBrush}"
                                                         StrokeThickness="{TemplateBinding BorderThickness}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InlineHuePickerSlider"
               TargetType="Slider"
               BasedOn="{StaticResource InlineColorPickerSlider}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="5"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource AppBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2.5" />
                            <Track x:Name="PART_Track"
                                   Height="18"
                                   VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="13" Height="13"
                                           Background="{DynamicResource AppAccentBrush}"
                                           BorderBrush="{DynamicResource ImageEditorSliderThumbBorderBrush}"
                                           BorderThickness="2">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{TemplateBinding Background}"
                                                         Stroke="{TemplateBinding BorderBrush}"
                                                         StrokeThickness="{TemplateBinding BorderThickness}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SelectionResizeThumb" TargetType="Thumb">
            <Setter Property="Panel.ZIndex" Value="90" />
            <Setter Property="Background" Value="{DynamicResource SelectionBorderBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppSubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ForceCursor" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent"><Border Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="1" /></Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>
            <Grid x:Name="CaptureSurface"
          Background="Transparent"
          Cursor="Arrow"
          Focusable="True"
           KeyDown="OnCaptureSurfaceKeyDown"
           Loaded="OnCaptureSurfaceLoaded"
           PreviewMouseRightButtonDown="OnCaptureSurfacePreviewMouseRightButtonDown"
           PreviewMouseRightButtonUp="OnCaptureSurfacePreviewMouseRightButtonUp"
           PreviewMouseLeftButtonDown="OnCaptureSurfacePreviewMouseLeftButtonDown"
           MouseLeftButtonDown="OnCaptureSurfaceMouseLeftButtonDown"
           MouseLeftButtonUp="OnCaptureSurfaceMouseLeftButtonUp"
           PreviewMouseLeftButtonUp="OnCaptureSurfacePreviewMouseLeftButtonUp"
           PreviewMouseMove="OnCaptureSurfacePreviewMouseMove"
           MouseMove="OnCaptureSurfaceMouseMove">
        <!-- The source is already a frozen screen bitmap. BitmapCache creates
             another raster surface and resamples it when monitor DPI differs. -->
        <Image x:Name="FrozenScreenImage"
               IsHitTestVisible="False"
               RenderOptions.BitmapScalingMode="LowQuality"
               SnapsToDevicePixels="True"
               Stretch="Fill" />
        <Canvas>
            <Rectangle x:Name="ScrollCaptureOutline"
                       Fill="Transparent"
                       IsHitTestVisible="False"
                       Panel.ZIndex="80"
                       Stroke="{DynamicResource SelectionBorderBrush}"
                       StrokeThickness="2"
                       Visibility="Collapsed" />
            <Rectangle x:Name="WindowSnapRectangle"
                       Fill="#24000000"
                       IsHitTestVisible="False"
                       Panel.ZIndex="45"
                       Stroke="{DynamicResource SelectionBorderBrush}"
                       StrokeThickness="3"
                       Visibility="Collapsed">
                <Rectangle.Effect>
                    <DropShadowEffect BlurRadius="8"
                                      Direction="0"
                                      Opacity="0.8"
                                      ShadowDepth="0"
                                      Color="#000000" />
                </Rectangle.Effect>
            </Rectangle>
            <Rectangle x:Name="SelectionRectangle"
                       Cursor="SizeAll"
                       Fill="Transparent"
                       ForceCursor="True"
                       SnapsToDevicePixels="True"
                       Panel.ZIndex="70"
                       Stroke="Transparent"
                       StrokeThickness="2"
                       Visibility="Collapsed"
                       MouseLeftButtonDown="OnSelectionRectangleMouseLeftButtonDown"
                       MouseMove="OnSelectionRectangleMouseMove"
                       MouseLeftButtonUp="OnSelectionRectangleMouseLeftButtonUp" />

            <!-- Small move affordances inset from the resize corners. They
                 are input-only and never overlap the eight resize handles. -->
            <Border x:Name="SelectionMoveTopLeftZone"
                    Width="14"
                    Height="14"
                    Background="Transparent"
                    Cursor="SizeAll"
                    Panel.ZIndex="85"
                    Visibility="Collapsed"
                    MouseLeftButtonDown="OnSelectionMoveZoneMouseLeftButtonDown" />
            <Border x:Name="SelectionMoveTopRightZone"
                    Width="14"
                    Height="14"
                    Background="Transparent"
                    Cursor="SizeAll"
                    Panel.ZIndex="85"
                    Visibility="Collapsed"
                    MouseLeftButtonDown="OnSelectionMoveZoneMouseLeftButtonDown" />
            <Border x:Name="SelectionMoveBottomLeftZone"
                    Width="14"
                    Height="14"
                    Background="Transparent"
                    Cursor="SizeAll"
                    Panel.ZIndex="85"
                    Visibility="Collapsed"
                    MouseLeftButtonDown="OnSelectionMoveZoneMouseLeftButtonDown" />
            <Border x:Name="SelectionMoveBottomRightZone"
                    Width="14"
                    Height="14"
                    Background="Transparent"
                    Cursor="SizeAll"
                    Panel.ZIndex="85"
                    Visibility="Collapsed"
                    MouseLeftButtonDown="OnSelectionMoveZoneMouseLeftButtonDown" />

            <Border x:Name="SelectionSizeBadge"
                    MinWidth="52"
                    Height="22"
                    Padding="7,0"
                    Panel.ZIndex="105"
                    Background="{DynamicResource AppSizeBadgeBackgroundBrush}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <TextBlock x:Name="SelectionSizeText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Segoe UI"
                           FontSize="11"
                           FontWeight="Normal"
                           Foreground="{DynamicResource AppControlForegroundBrush}"
                           Text="0 × 0" />
            </Border>

            <editor:ImageEditorCanvas x:Name="InlineEditorCanvas"
                                      Panel.ZIndex="50"
                                      Visibility="Collapsed" />

            <Canvas x:Name="OcrTextOverlay"
                    ClipToBounds="True"
                    IsHitTestVisible="True"
                    Panel.ZIndex="95"
                    Visibility="Collapsed" />

            <Canvas x:Name="ContentRecognitionOverlay"
                    ClipToBounds="True"
                    IsHitTestVisible="False"
                    Panel.ZIndex="97"
                    Visibility="Collapsed" />

            <Border x:Name="ColorPickerPanel"
                    Panel.ZIndex="140"
                    Padding="5"
                    Background="{DynamicResource ImageEditorToolbarBackgroundBrush}"
                    BorderBrush="{DynamicResource AppAccentBrush}"
                    BorderThickness="1"
                    CornerRadius="5"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="ColorPickerMagnifier"
                           Width="112"
                           Height="112"
                           Stretch="Fill"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <StackPanel Grid.Column="1"
                                Margin="8,0,3,0"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="ColorPickerValueText"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AppControlForegroundBrush}"
                                   Text="#000000" />
                        <TextBlock x:Name="ColorPickerRgbText"
                                   Margin="0,3,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   Text="RGB(0, 0, 0)" />
                        <TextBlock Margin="0,7,0,0"
                                   FontSize="10"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   Text="C 复制  ·  Esc/右键退出" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border x:Name="InlineCustomColorPanel"
                    Width="272"
                    Padding="0"
                    Panel.ZIndex="150"
                    Background="Transparent"
                    BorderThickness="0"
                    Visibility="Collapsed">
                <ContentControl x:Name="InlineSharedColorHost" />
            </Border>

            <Border x:Name="SelectionMessageToast"
                    MinWidth="150"
                    MaxWidth="360"
                    Padding="14,9"
                    Background="{DynamicResource AppFloatingSurfaceBrush}"
                    BorderBrush="{DynamicResource AppAccentBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    IsHitTestVisible="False"
                    Panel.ZIndex="120"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14"
                                      Direction="270"
                                      Opacity="0.28"
                                      ShadowDepth="3"
                                      Color="#000000" />
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <Ellipse Width="8"
                             Height="8"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource AppAccentBrush}" />
                    <TextBlock x:Name="SelectionMessageText"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource AppControlForegroundBrush}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Rectangle x:Name="InlineEditorOutline"
                       Cursor="SizeAll"
                       Fill="Transparent"
                       IsHitTestVisible="False"
                       Panel.ZIndex="80"
                       Stroke="Transparent"
                       StrokeThickness="3"
                       Visibility="Collapsed"
                       MouseLeftButtonDown="OnInlineEditorOutlineMouseLeftButtonDown"
                       MouseMove="OnInlineEditorOutlineMouseMove"
                       MouseLeftButtonUp="OnInlineEditorOutlineMouseLeftButtonUp">
                <Rectangle.Effect>
                    <DropShadowEffect BlurRadius="9"
                                      Direction="0"
                                      Opacity="0.85"
                                      ShadowDepth="0"
                                      Color="#000000" />
                </Rectangle.Effect>
            </Rectangle>

            <Thumb x:Name="TopLeftResizeThumb"
                   Width="12"
                   Height="12"
                   Cursor="SizeNWSE"
                   Panel.ZIndex="90"
                   DragCompleted="OnSelectionResizeThumbDragCompleted"
                   DragDelta="OnTopLeftResizeThumbDragDelta"
                   Style="{StaticResource SelectionResizeThumb}"
                   Visibility="Collapsed" />
            <Thumb x:Name="TopRightResizeThumb"
                   Width="12"
                   Height="12"
                   Cursor="SizeNESW"
                   Panel.ZIndex="90"
                   DragCompleted="OnSelectionResizeThumbDragCompleted"
                   DragDelta="OnTopRightResizeThumbDragDelta"
                   Style="{StaticResource SelectionResizeThumb}"
                   Visibility="Collapsed" />
            <Thumb x:Name="TopResizeThumb"
                   Width="18"
                   Height="8"
                   Cursor="SizeNS"
                   Panel.ZIndex="90"
                   DragCompleted="OnSelectionResizeThumbDragCompleted"
                   DragDelta="OnTopResizeThumbDragDelta"
                   Style="{StaticResource SelectionResizeThumb}"
                   Visibility="Collapsed" />
            <Thumb x:Name="LeftResizeThumb"
                   Width="8"
                   Height="18"
                   Cursor="SizeWE"
                   Panel.ZIndex="90"
                   DragCompleted="OnSelectionResizeThumbDragCompleted"
                   DragDelta="OnLeftResizeThumbDragDelta"
                   Style="{StaticResource SelectionResizeThumb}"
                   Visibility="Collapsed" />
            <Thumb x:Name="RightResizeThumb"
                   Width="8"
                   Height="18"
                   Cursor="SizeWE"
                   Panel.ZIndex="90"
                   DragCompleted="OnSelectionResizeThumbDragCompleted"
                   DragDelta="OnRightResizeThumbDragDelta"
                   Style="{StaticResource SelectionResizeThumb}"
                   Visibility="Collapsed" />
            <Thumb x:Name="BottomResizeThumb"
                   Width="18"
                   Height="8"
                   Cursor="SizeNS"
                   Panel.ZIndex="90"
                   DragCompleted="OnSelectionResizeThumbDragCompleted"
                   DragDelta="OnBottomResizeThumbDragDelta"
                   Style="{StaticResource SelectionResizeThumb}"
                   Visibility="Collapsed" />
            <Thumb x:Name="BottomLeftResizeThumb"
                   Width="12"
                   Height="12"
                   Cursor="SizeNESW"
                   Panel.ZIndex="90"
                   DragCompleted="OnSelectionResizeThumbDragCompleted"
                   DragDelta="OnBottomLeftResizeThumbDragDelta"
                   Style="{StaticResource SelectionResizeThumb}"
                   Visibility="Collapsed" />
            <Thumb x:Name="BottomRightResizeThumb"
                   Width="12"
                   Height="12"
                   Cursor="SizeNWSE"
                   Panel.ZIndex="90"
                   DragCompleted="OnSelectionResizeThumbDragCompleted"
                   DragDelta="OnBottomRightResizeThumbDragDelta"
                   Style="{StaticResource SelectionResizeThumb}"
                   Visibility="Collapsed" />

            <Border x:Name="CaptureToolbar" SizeChanged="OnCaptureToolbarSizeChanged"
                    Panel.ZIndex="100"
                    Cursor="SizeAll"
                    Padding="12,10"
                    Background="{DynamicResource AppFloatingSurfaceBrush}"
                    BorderBrush="{DynamicResource AppControlEdgeBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    PreviewMouseLeftButtonDown="OnCaptureToolbarSurfaceMouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="OnCaptureToolbarSurfaceMouseLeftButtonUp"
                    PreviewMouseMove="OnCaptureToolbarSurfaceMouseMove"
                    Visibility="Collapsed">
                <StackPanel>
                    <StackPanel x:Name="InlineEditorTools" presentation:SelectionMotion.IsScope="True">
                    <StackPanel x:Name="InlineEditorToolsRow1" Orientation="Horizontal">
                        <RadioButton x:Name="InlineShapeToolButton"
                                     GroupName="InlineEditorTool"
                                     Checked="OnInlineEditorToolSelected"
                                     IsChecked="True"
                                     Style="{StaticResource InlineToolButton}"
                                     Tag="Rectangle"
                                     ToolTip="矩形/椭圆">
                            <RadioButton.ContextMenu>
                                <ContextMenu Style="{StaticResource ThemedContextMenuStyle}">
                                    <MenuItem x:Name="InlineRectangleShapeMenuItem" Tag="Rectangle" IsCheckable="True" Style="{StaticResource ThemedMenuItemStyle}" Click="OnInlineShapeMenuItemClick">
                                        <MenuItem.Header><StackPanel Orientation="Horizontal"><Path Width="18" Height="18" Margin="0,0,8,0" Data="{StaticResource RectangleIconGeometry}" Fill="Transparent" Stroke="{DynamicResource AppControlForegroundBrush}" StrokeThickness="1.6" /><TextBlock VerticalAlignment="Center" Text="矩形" /></StackPanel></MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem x:Name="InlineEllipseShapeMenuItem" Tag="Ellipse" IsCheckable="True" Style="{StaticResource ThemedMenuItemStyle}" Click="OnInlineShapeMenuItemClick">
                                        <MenuItem.Header><StackPanel Orientation="Horizontal"><Path Width="18" Height="18" Margin="0,0,8,0" Data="{StaticResource EllipseIconGeometry}" Fill="Transparent" Stroke="{DynamicResource AppControlForegroundBrush}" StrokeThickness="1.6" /><TextBlock VerticalAlignment="Center" Text="椭圆" /></StackPanel></MenuItem.Header>
                                    </MenuItem>
                                </ContextMenu>
                            </RadioButton.ContextMenu>
                            <Grid Width="20">
                                <Path x:Name="InlineShapeToolIcon"
                                      Width="18"
                                      Height="18"
                                      HorizontalAlignment="Center"
                                      Data="{StaticResource RectangleIconGeometry}"
                                      Style="{StaticResource InlineIconPath}" />
                            </Grid>
                        </RadioButton>
                        <RadioButton x:Name="InlineArrowToolButton"
                                     GroupName="InlineEditorTool"
                                     Checked="OnInlineEditorToolSelected"
                                     Style="{StaticResource InlineToolButton}"
                                     Tag="Arrow"
                                     ToolTip="箭头">
                            <RadioButton.ContextMenu>
                                <ContextMenu Style="{StaticResource ThemedContextMenuStyle}">
                                    <MenuItem x:Name="InlineStraightFilledArrowMenuItem" Tag="Arrow,Filled" IsCheckable="True" Style="{StaticResource ThemedMenuItemStyle}" Click="OnInlineArrowVariantMenuItemClick">
                                        <MenuItem.Header><StackPanel Orientation="Horizontal"><Path Width="18" Height="18" Margin="0,0,8,0" Data="{StaticResource StraightFilledArrowIconGeometry}" Fill="{DynamicResource AppControlForegroundBrush}" /><TextBlock VerticalAlignment="Center" Text="直线实心箭头" /></StackPanel></MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem x:Name="InlineStraightHollowArrowMenuItem" Tag="Arrow,Hollow" IsCheckable="True" Style="{StaticResource ThemedMenuItemStyle}" Click="OnInlineArrowVariantMenuItemClick">
                                        <MenuItem.Header><StackPanel Orientation="Horizontal"><Path Width="18" Height="18" Margin="0,0,8,0" Data="{StaticResource StraightHollowArrowIconGeometry}" Fill="Transparent" Stroke="{DynamicResource AppControlForegroundBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /><TextBlock VerticalAlignment="Center" Text="直线空心箭头" /></StackPanel></MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem x:Name="InlineCurvedFilledArrowMenuItem" Tag="CurvedArrow,Filled" IsCheckable="True" Style="{StaticResource ThemedMenuItemStyle}" Click="OnInlineArrowVariantMenuItemClick">
                                        <MenuItem.Header><StackPanel Orientation="Horizontal"><Path Width="18" Height="18" Margin="0,0,8,0" Data="{StaticResource CurvedFilledArrowIconGeometry}" Fill="{DynamicResource AppControlForegroundBrush}" /><TextBlock VerticalAlignment="Center" Text="弧形实心箭头" /></StackPanel></MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem x:Name="InlineCurvedHollowArrowMenuItem" Tag="CurvedArrow,Hollow" IsCheckable="True" Style="{StaticResource ThemedMenuItemStyle}" Click="OnInlineArrowVariantMenuItemClick">
                                        <MenuItem.Header><StackPanel Orientation="Horizontal"><Path Width="18" Height="18" Margin="0,0,8,0" Data="{StaticResource CurvedHollowArrowIconGeometry}" Fill="Transparent" Stroke="{DynamicResource AppControlForegroundBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /><TextBlock VerticalAlignment="Center" Text="弧形空心箭头" /></StackPanel></MenuItem.Header>
                                    </MenuItem>
                                </ContextMenu>
                            </RadioButton.ContextMenu>
                            <Grid Width="20">
                                <Path x:Name="InlineArrowToolIcon"
                                      Width="18"
                                      Height="18"
                                      HorizontalAlignment="Center"
                                      Data="{StaticResource StraightFilledArrowIconGeometry}"
                                      Style="{StaticResource InlineIconPath}" />
                            </Grid>
                        </RadioButton>
                        <RadioButton x:Name="InlineEmojiToolButton"
                                     GroupName="InlineEditorTool"
                                     Checked="OnInlineEditorToolSelected"
                                     Style="{StaticResource InlineToolButton}"
                                     Tag="Emoji"
                                     ToolTip="表情">
                            <editor:EmojiStickerImage Width="22" Height="22" Sticker="😊" />
                        </RadioButton>
                        <RadioButton x:Name="InlineNumberToolButton"
                                     GroupName="InlineEditorTool"
                                     Checked="OnInlineEditorToolSelected"
                                     Style="{StaticResource InlineToolButton}"
                                     Tag="Number"
                                     ToolTip="序号标注">
                            <Border Width="19"
                                    Height="19"
                                    Background="{DynamicResource EditorToolbarIconBrush}"
                                    CornerRadius="9.5">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource AppPanelBackgroundBrush}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Text="1" />
                            </Border>
                        </RadioButton>
                        <RadioButton x:Name="InlineDoubleArrowToolButton" GroupName="InlineEditorTool" Tag="DoubleArrow" Checked="OnInlineEditorToolSelected" Style="{StaticResource InlineToolButton}" ToolTip="双向箭头" />
                        <RadioButton x:Name="InlineLineToolButton" GroupName="InlineEditorTool" Tag="Line" Checked="OnInlineEditorToolSelected" Style="{StaticResource InlineToolButton}" Width="42" ToolTip="直线/波浪线" />
                        <RadioButton x:Name="InlineBrushToolButton"
                                     GroupName="InlineEditorTool"
                                     Checked="OnInlineEditorToolSelected"
                                     Style="{StaticResource InlineToolButton}"
                                     Tag="Brush"
                                     ToolTip="画笔">
                            <Path Data="{StaticResource PenIconGeometry}"
                                  Style="{StaticResource InlineIconPath}" />
                        </RadioButton>
                        <RadioButton x:Name="InlineTextToolButton"
                                     GroupName="InlineEditorTool"
                                     Checked="OnInlineEditorToolSelected"
                                     Style="{StaticResource InlineToolButton}"
                                     Tag="Text"
                                     ToolTip="文字">
                            <Path Data="{StaticResource TextIconGeometry}"
                                  Style="{StaticResource InlineIconPath}" />
                        </RadioButton>
                        <RadioButton x:Name="InlineMosaicToolButton" Width="42"
                                     GroupName="InlineEditorTool"
                                     Checked="OnInlineEditorToolSelected"
                                     Style="{StaticResource InlineToolButton}"
                                     Tag="Mosaic"
                                     ToolTip="马赛克笔刷">
                            <Path Data="{StaticResource TableIconGeometry}"
                                  Style="{StaticResource InlineIconPath}" />
                        </RadioButton>

                        <Border x:Name="ToolActionSeparator"
                                Style="{StaticResource InlineToolbarSeparator}" />

                        <Button x:Name="AspectRatioButton"
                                Click="OnAspectRatioClick"
                                Style="{StaticResource InlineActionButton}"
                                ToolTip="普通截图比例">
                            <presentation:ToolbarFeatureIcon Feature="AspectRatio" />
                        </Button>
                        <Button x:Name="RecordButton"
                                Click="OnRecordClick"
                                Style="{StaticResource InlineActionButton}"
                                ToolTip="录制当前区域">
                            <Path Data="{StaticResource RecordIconGeometry}"
                                  Style="{StaticResource InlineIconPath}" />
                        </Button>
                        <Button x:Name="SaveButton"
                                Click="OnSaveClick"
                                Style="{StaticResource InlineActionButton}"
                                ToolTip="保存 PNG">
                            <Path Data="{StaticResource SaveIconGeometry}"
                                  Style="{StaticResource InlineIconPath}" />
                        </Button>
                        <Button x:Name="ScrollCaptureButton"
                                Click="OnScrollCaptureClick"
                                Style="{StaticResource InlineActionButton}"
                                ToolTip="使用当前选区开始长截图">
                            <Path Data="{StaticResource ScrollIconGeometry}"
                                  Style="{StaticResource InlineIconPath}" />
                        </Button>
                        <Button x:Name="OcrButton"
                                Click="OnOcrClick"
                                Style="{StaticResource InlineActionButton}"
                                ToolTip="识别文字并在原位置选择复制">
                            <Grid Width="27">
                                <TextBlock Style="{StaticResource InlineGlyphIcon}"
                                           Text="文" />
                            </Grid>
                        </Button>
                        <Button x:Name="CopyTableButton"
                                Click="OnCopyTableMenuItemClick"
                                Style="{StaticResource InlineActionButton}"
                                ToolTip="识别表格并复制为制表符格式">
                            <Path Data="{StaticResource MosaicIconGeometry}"
                                  Style="{StaticResource InlineIconPath}" />
                        </Button>
                        <Button x:Name="CopyRecognizedTextButton"
                                Click="OnCopyRecognizedTextClick"
                                Style="{StaticResource InlineActionButton}"
                                ToolTipService.ShowOnDisabled="True"
                                ToolTip="识别全部文字、复制到剪贴板并关闭截图">
                            <TextBlock Style="{StaticResource InlineGlyphIcon}"
                                       Text="取" />
                        </Button>
                        <Button presentation:TranslationLanguageMenu.InlineOptions="True" presentation:TranslationLanguageMenu.Enabled="True" x:Name="TranslateButton"
                                Click="OnTranslateClick"
                                Style="{StaticResource InlineActionButton}"
                                ToolTip="翻译（右键选择目标语言）">
                            <TextBlock x:Name="TranslateButtonText"
                                       Style="{StaticResource InlineGlyphIcon}"
                                       Text="译" />
                        </Button>
                        <Button x:Name="PrivacyRedactionButton"
                                Click="OnPrivacyRedactionClick"
                                Style="{StaticResource InlineActionButton}"
                                ToolTip="识别敏感信息，确认后批量打码">
                            <TextBlock Style="{StaticResource InlineGlyphIcon}"
                                       Text="隐" />
                        </Button>
                    <Button x:Name="WatermarkButton"
                            Style="{StaticResource InlineActionButton}"
                            ToolTip="添加预设水印（在常规设置 → 水印中编辑）"
                            Click="OnWatermarkClick">
                        <TextBlock Style="{StaticResource InlineGlyphIcon}" Text="印" />
                    </Button>
                    <Button x:Name="PinButton"
                                Click="OnPinClick"
                                Style="{StaticResource InlineActionButton}"
                                ToolTip="钉在最上层">
                            <Path Data="{StaticResource PinIconGeometry}"
                                  Style="{StaticResource InlineIconPath}" />
                        </Button>

                        <Border x:Name="ActionHistorySeparator"
                                Style="{StaticResource InlineToolbarSeparator}" />

                        <Button x:Name="InlineUndoButton"
                                Click="OnInlineUndoClick"
                                IsEnabled="False"
                                Style="{StaticResource InlineActionButton}"
                                ToolTip="撤销">
                            <Path Data="{StaticResource UndoIconGeometry}"
                                  Style="{StaticResource InlineIconPath}" />
                        </Button>
                        <Button x:Name="InlineRedoButton"
                                Click="OnInlineRedoClick"
                                IsEnabled="False"
                                Style="{StaticResource InlineActionButton}"
                                ToolTip="重做">
                            <Path Data="{StaticResource RedoIconGeometry}"
                                  Style="{StaticResource InlineIconPath}" />
                        </Button>

                        <Border x:Name="HistoryFinishSeparator"
                                Style="{StaticResource InlineToolbarSeparator}" />

                        <Button x:Name="CancelButton"
                                Click="OnCancelClick"
                                Margin="4,0,0,0"
                                Style="{StaticResource InlineActionButton}"
                                ToolTip="取消截图">
                            <Path Data="{StaticResource CancelIconGeometry}"
                                  Stroke="{DynamicResource EditorToolbarCancelIconBrush}"
                                  Style="{StaticResource InlineIconPath}" />
                        </Button>
                        <Button x:Name="ConfirmButton"
                                Click="OnConfirmClick"
                                Margin="4,0,0,0"
                                Background="{DynamicResource EditorToolbarConfirmBackgroundBrush}"
                                BorderBrush="{DynamicResource EditorToolbarConfirmBorderBrush}"
                                Style="{StaticResource InlineActionButton}"
                                ToolTip="完成并复制到剪贴板（Ctrl+C）">
                            <Path Data="{StaticResource ConfirmIconGeometry}"
                                  Stroke="{DynamicResource EditorToolbarConfirmIconBrush}"
                                  Style="{StaticResource InlineIconPath}" />
                        </Button>
                    </StackPanel>
                    <StackPanel x:Name="InlineEditorToolsRow2"
                                Margin="0,6,0,0"
                                Orientation="Horizontal"
                                Visibility="Collapsed" />
                    </StackPanel>

                    <Grid x:Name="InlineBottomRow" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    <StackPanel>
                    <StackPanel x:Name="InlineEditorOptions"
                                Orientation="Vertical"
                                Visibility="Collapsed">
                        <presentation:ToolbarAdjustmentPanel x:Name="InlineAdjustmentLine"
                            WidthSource="{Binding ElementName=InlineEditorTools}"
                            ReservedWidthSource="{Binding ElementName=InlineStatusRow}">
                        <presentation:ToolbarEmojiStrip x:Name="InlineEmojiPalette"
                            presentation:ToolbarAdjustmentPanel.FillRemainingWidth="True"
                            Margin="0,0,8,0" Visibility="Collapsed">
                            <WrapPanel x:Name="InlineEmojiPanel" ItemWidth="42" ItemHeight="34" />
                        </presentation:ToolbarEmojiStrip>
                        <StackPanel x:Name="InlineStrokeOptions" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="InlineRedColorButton"
                                Background="#D64545"
                                BorderBrush="#F2FFFC"
                                BorderThickness="2"
                                Click="OnInlineColorClick"
                                Style="{StaticResource InlineColorSwatch}"
                                Tag="#D64545"
                                ToolTip="红色" />
                        <Button x:Name="InlineCyanColorButton"
                                Background="#007F73"
                                BorderBrush="#00695F"
                                Click="OnInlineColorClick"
                                Style="{StaticResource InlineColorSwatch}"
                                Tag="#007F73"
                                ToolTip="青绿" />
                        <Button x:Name="InlineDarkColorButton"
                                Background="#25313A"
                                BorderBrush="#1C252D"
                                Click="OnInlineColorClick"
                                Style="{StaticResource InlineColorSwatch}"
                                Tag="#25313A"
                                ToolTip="黑色" />
                        <Button x:Name="InlineCustomColorButton"
                                Margin="0,4,8,0"
                                Background="#647A80"
                                BorderBrush="#40565C"
                                Click="OnInlineCustomColorClick"
                                Style="{StaticResource InlineColorSwatch}"
                                ToolTip="自定义颜色">
                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#FFFFFF" Text="&#xE790;" />
                        </Button>
                        <Slider x:Name="InlineStrokeWidthSlider"
                                Minimum="1"
                                Maximum="12"
                                SmallChange="1"
                                TickFrequency="1"
                                Style="{StaticResource InlineStrokeSlider}"
                                Value="3"
                                ValueChanged="OnInlineStrokeWidthChanged"
                                ToolTip="线条粗细" />
                        <TextBlock x:Name="InlineStrokeWidthText"
                                   MinWidth="30"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppMutedTextBrush}"
                                   Text="3 px" />
                        </StackPanel>
                        <presentation:ToolbarOptionsRow x:Name="InlineToolAdjustments" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </presentation:ToolbarAdjustmentPanel>
                    </StackPanel>
                    <presentation:ToolbarOptionsRow x:Name="InlineActionAdjustments" />
                    </StackPanel>

                    <StackPanel x:Name="InlineStatusRow" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12,0,2,0">
                        <Button x:Name="BackgroundCaptureButton" Content="后台处理" Padding="7,2" Margin="0,0,8,0" Visibility="Collapsed"
                                ToolTip="收起截图，识别和翻译继续进行；从任务栏返回截图" Click="OnBackgroundCaptureClick"/>
                        <Button x:Name="RetryTranslationButton" Width="24" Height="24" Margin="0,0,6,0" Padding="0"
                                Content="↻" FontSize="18" Visibility="Collapsed" Click="OnRetryTranslationClick"
                                ToolTip="只重新翻译未完成段落，保留已经完成的译文；仍按设置的模型顺序执行" />
                        <presentation:ActivityIndicator x:Name="CaptureActivity" Width="14" Height="14" Margin="0,0,7,0" />
                        <TextBlock x:Name="CaptureStatusText" MaxWidth="460" VerticalAlignment="Center"
                                   FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                   LineHeight="18" LineStackingStrategy="BlockLineHeight" MaxHeight="36"
                                   ToolTipService.ShowOnDisabled="True" ToolTipService.ShowDuration="60000"
                                   Visibility="Collapsed" />
                    </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <presentation:ImageQuestionEntry x:Name="ImageQuestionButton" Panel.ZIndex="1000"
                    Visibility="Collapsed" ToolTip="AI 问图：总结、提取文字、翻译或自由提问" Click="OnImageQuestionClick"/>
        </Canvas>
    </Grid>
</Window>
