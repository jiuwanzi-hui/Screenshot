<Window x:Class="Screenshot.App.Capture.CapturePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Icon="/SnapCut;component/Assets/Screenshot.ico"
        Title="SnapCut"
        Width="760"
        Height="560"
        MinWidth="500"
        MinHeight="280"
        FontFamily="Microsoft YaHei UI"
        Topmost="True"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="PreviewCommandButton" TargetType="Button">
            <Setter Property="MinWidth" Value="62" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="{DynamicResource AppPanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppControlForegroundBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryPreviewCommandButton" TargetType="Button" BasedOn="{StaticResource PreviewCommandButton}">
            <Setter Property="Background" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="PreviewScrollViewerStyle" TargetType="ScrollViewer">
            <Setter Property="Background" Value="{DynamicResource AppPanelBackgroundBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    Margin="{TemplateBinding Padding}" />
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       Orientation="Vertical"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                            <ScrollBar x:Name="PART_HorizontalScrollBar"
                                       Grid.Row="1"
                                       Maximum="{TemplateBinding ScrollableWidth}"
                                       Orientation="Horizontal"
                                       ViewportSize="{TemplateBinding ViewportWidth}"
                                       Value="{TemplateBinding HorizontalOffset}"
                                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                            <Border Grid.Row="1"
                                    Grid.Column="1"
                                    Background="{TemplateBinding Background}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource AppWindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0"
                   Background="{DynamicResource AppSidebarBackgroundBrush}"
                   LastChildFill="False">
            <TextBlock Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AppControlForegroundBrush}"
                       Text="SnapCut" />
            <StackPanel DockPanel.Dock="Right"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Button x:Name="ConfirmButton"
                        Width="34"
                        Height="34"
                        Margin="0,0,8,0"
                        Background="{DynamicResource AppAccentBrush}"
                        BorderBrush="{DynamicResource AppAccentBrush}"
                        Click="OnConfirmClick"
                        Foreground="#FFFFFF"
                        ToolTip="复制并关闭">
                    <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="14" Text="&#xE73E;" />
                </Button>
                <Button Click="OnCopyClick"
                        Content="复制"
                        Style="{StaticResource PrimaryPreviewCommandButton}" />
                <Button Click="OnSaveClick"
                        Content="保存"
                        Style="{StaticResource PreviewCommandButton}" />
                <Button x:Name="ReselectButton"
                        Click="OnReselectClick"
                        Content="重选"
                        Style="{StaticResource PreviewCommandButton}" />
                <Button x:Name="EditButton"
                        Click="OnEditClick"
                        Content="编辑"
                        Style="{StaticResource PreviewCommandButton}" />
                <Button x:Name="PinButton"
                        Click="OnPinClick"
                        Content="钉图"
                        Style="{StaticResource PreviewCommandButton}" />
                <Button x:Name="OcrButton"
                        Click="OnOcrClick"
                        Content="识别"
                        Style="{StaticResource PreviewCommandButton}" />
                <Button x:Name="CloseButton"
                        Width="32"
                        Height="34"
                        Margin="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnCloseClick"
                        Content="x"
                        Foreground="{DynamicResource AppTextSecondaryBrush}"
                        ToolTip="关闭" />
            </StackPanel>
        </DockPanel>

        <TextBlock x:Name="StatusText"
                   Grid.Row="1"
                   Margin="16,0,16,0"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                   TextTrimming="CharacterEllipsis" />

        <Border Grid.Row="2"
                Margin="12"
                Background="{DynamicResource AppPanelBackgroundBrush}"
                BorderBrush="{DynamicResource AppSubtleBorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <ScrollViewer x:Name="PreviewScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
                          PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp"
                          PreviewMouseMove="OnPreviewMouseMove"
                          PreviewMouseWheel="OnPreviewMouseWheel"
                          LostMouseCapture="OnPreviewLostMouseCapture"
                          ScrollChanged="OnPreviewScrollChanged"
                          Style="{StaticResource PreviewScrollViewerStyle}">
                <Image x:Name="PreviewImage"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Top"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="{Binding Preview}"
                       Stretch="None">
                    <Image.LayoutTransform>
                        <ScaleTransform x:Name="PreviewScaleTransform"
                                        ScaleX="1"
                                        ScaleY="1" />
                    </Image.LayoutTransform>
                </Image>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
