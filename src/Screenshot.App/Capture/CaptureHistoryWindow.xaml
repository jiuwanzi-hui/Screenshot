<Window x:Class="Screenshot.App.Capture.CaptureHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="截图历史"
        Width="500"
        Height="620"
        MinWidth="360"
        MinHeight="360"
        FontFamily="Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="HistoryActionButton" TargetType="Button">
            <Setter Property="MinWidth" Value="62" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Background" Value="{DynamicResource AppInputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AppControlForegroundBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AppAccentMutedBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Background="{DynamicResource AppWindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <StackPanel Margin="22,16,22,0">
            <TextBlock FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AppControlForegroundBrush}"
                       Text="截图历史" />
            <TextBlock Margin="0,5,0,0"
                       FontSize="13"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                       Text="本次运行的完整截图，可查看、复制或保存" />
        </StackPanel>

        <ListBox x:Name="HistoryListBox"
                 Grid.Row="1"
                 Margin="16,6,16,16"
                 Background="Transparent"
                 BorderThickness="0"
                 ItemsSource="{Binding Items}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,10"
                            Padding="10"
                            Background="{DynamicResource AppPanelBackgroundBrush}"
                            BorderBrush="{DynamicResource AppSubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                             <Grid.ColumnDefinitions>
                                 <ColumnDefinition Width="128" />
                                 <ColumnDefinition Width="*" />
                                 <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Height="86"
                                    Background="{DynamicResource AppSidebarBackgroundBrush}"
                                    BorderBrush="{DynamicResource AppSubtleBorderBrush}"
                                    BorderThickness="1">
                                <Image Source="{Binding Thumbnail}"
                                       Stretch="Uniform" />
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="14,4,0,0">
                                <TextBlock FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                           Text="{Binding CapturedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}">
                                    <Run Text="{Binding PixelWidth, Mode=OneWay}" />
                                    <Run Text=" x " />
                                    <Run Text="{Binding PixelHeight, Mode=OneWay}" />
                                </TextBlock>
                             </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Margin="12,2,0,0">
                                <Button Click="OnViewHistoryItemClick"
                                        Content="查看"
                                        Style="{StaticResource HistoryActionButton}"
                                        Tag="{Binding}" />
                                <Button Click="OnCopyHistoryItemClick"
                                        Content="复制"
                                        Style="{StaticResource HistoryActionButton}"
                                        Tag="{Binding}" />
                            </StackPanel>
                         </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="HistoryStatusText"
                   Grid.Row="2"
                   Margin="20,0"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                   Text="点击查看可打开完整图片。"
                   TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
