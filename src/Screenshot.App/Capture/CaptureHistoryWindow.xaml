<Window x:Class="Screenshot.App.Capture.CaptureHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:capture="clr-namespace:Screenshot.App.Capture"
        Title="历史查看"
        Width="720"
        Height="560"
        MinWidth="560"
        MinHeight="400"
        FontFamily="Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="HistoryActionButton" TargetType="Button">
            <Setter Property="MinWidth" Value="64" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,0,7" />
            <Setter Property="Padding" Value="11,2" />
            <Setter Property="Background" Value="{DynamicResource AppInputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AppControlForegroundBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource AppAccentMutedBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HistoryDeleteButton"
               BasedOn="{StaticResource HistoryActionButton}"
               TargetType="Button">
            <Setter Property="Foreground" Value="#E24A5A" />
        </Style>
        <Style x:Key="HistoryViewSwitch" TargetType="RadioButton">
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource AppInputBackgroundBrush}"
                                BorderBrush="{DynamicResource AppSubtleBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource AppAccentBrush}" />
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HistoryListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HistoryCard" TargetType="Border">
            <Setter Property="Margin" Value="4,3,10,8" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="Background" Value="{DynamicResource AppPanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppSubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="7"
                                      Direction="270"
                                      Opacity="0.13"
                                      ShadowDepth="2"
                                      Color="#10262E" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="11"
                                              Direction="270"
                                              Opacity="0.23"
                                              ShadowDepth="3"
                                              Color="#10262E" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource AppWindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <StackPanel Margin="24,16,24,0">
            <TextBlock FontSize="21"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AppControlForegroundBrush}"
                       Text="历史查看" />
            <TextBlock Margin="0,5,0,0"
                       FontSize="13"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                       Text="管理截图与本地录屏" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="18,0,18,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ScreenshotHistoryTab"
                             Checked="OnScreenshotHistoryTabChecked"
                             Content="截图历史"
                             GroupName="HistoryView"
                             IsChecked="True"
                             Style="{StaticResource HistoryViewSwitch}" />
                <RadioButton x:Name="VideoHistoryTab"
                             Checked="OnVideoHistoryTabChecked"
                             Content="录屏历史"
                             GroupName="HistoryView"
                             Style="{StaticResource HistoryViewSwitch}" />
            </StackPanel>

            <Grid x:Name="ScreenshotHistoryPanel" Grid.Row="1" Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="4,0,4,10">
                        <Button x:Name="ClearScreenshotHistoryButton"
                                DockPanel.Dock="Right"
                                Click="OnClearScreenshotHistoryClick"
                                Content="全部清空"
                                Style="{StaticResource HistoryDeleteButton}" />
                        <TextBlock x:Name="ScreenshotHistoryScopeText"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   Text="本次运行" />
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="HistoryListBox"
                                 Padding="0,1,0,6"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemContainerStyle="{StaticResource HistoryListBoxItem}"
                                 ItemsSource="{Binding ScreenshotItems}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Cursor="Hand"
                                            PreviewMouseLeftButtonDown="OnScreenshotCardMouseLeftButtonDown"
                                            PreviewMouseMove="OnScreenshotCardMouseMove"
                                            PreviewMouseLeftButtonUp="OnScreenshotCardMouseLeftButtonUp"
                                            Loaded="OnHistoryDragHintLoaded"
                                            Unloaded="OnHistoryDragHintUnloaded"
                                            Style="{StaticResource HistoryCard}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="154" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.RowSpan="2"
                                                    Height="84"
                                                    Background="{DynamicResource AppSidebarBackgroundBrush}"
                                                    BorderBrush="{DynamicResource AppSubtleBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                            </Border>

                                            <StackPanel Grid.RowSpan="2"
                                                        Grid.Column="1"
                                                        Margin="16,0,12,0"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Center">
                                                <TextBlock FontSize="14"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                           Text="{Binding CapturedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Margin="0,9,0,0"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding PixelWidth, Mode=OneWay}" />
                                                    <Run Text=" x " />
                                                    <Run Text="{Binding PixelHeight, Mode=OneWay}" />
                                                    <Run Text=" px" />
                                                    <Run Text="  ·  " />
                                                    <Run Text="{Binding FormatText, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Margin="0,3,0,0"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis">
                                                    <Run Text="文件大小 " />
                                                    <Run Text="{Binding FileSizeText, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.RowSpan="2"
                                                        Grid.Column="2"
                                                        Margin="0,0,12,0"
                                                        VerticalAlignment="Center">
                                                <Button Click="OnViewHistoryItemClick"
                                                        Content="查看"
                                                        Margin="0,0,0,6"
                                                        Style="{StaticResource HistoryActionButton}"
                                                        Tag="{Binding}" />
                                                <Button Click="OnCopyHistoryItemClick"
                                                        Content="复制"
                                                        Margin="0,0,0,6"
                                                        Style="{StaticResource HistoryActionButton}"
                                                        Tag="{Binding}" />
                                                <Button Click="OnDeleteHistoryItemClick"
                                                        Content="删除"
                                                        Margin="0"
                                                        Style="{StaticResource HistoryDeleteButton}"
                                                        Tag="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="ScreenshotEmptyText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   Text="暂无截图历史" />
                    </Grid>
            </Grid>

            <Grid x:Name="VideoHistoryPanel"
                  Grid.Row="1"
                  Margin="0,12,0,0"
                  Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Margin="4,0,4,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="OpenVideoDirectoryButton"
                                    Margin="0,0,8,7"
                                    Click="OnOpenVideoDirectoryClick"
                                    Content="打开目录"
                                    Style="{StaticResource HistoryActionButton}" />
                            <Button x:Name="RefreshVideoHistoryButton"
                                    Click="OnRefreshVideoHistoryClick"
                                    Content="刷新"
                                    Style="{StaticResource HistoryActionButton}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,10,7"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       Text="排序" />
                            <ComboBox x:Name="VideoSortComboBox"
                                      Width="122"
                                      Height="30"
                                      Margin="0,0,0,7"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="最新录制"
                                              Tag="{x:Static capture:VideoHistorySortMode.NewestFirst}" />
                                <ComboBoxItem Content="最早录制"
                                              Tag="{x:Static capture:VideoHistorySortMode.OldestFirst}" />
                                <ComboBoxItem Content="文件名"
                                              Tag="{x:Static capture:VideoHistorySortMode.FileName}" />
                                <ComboBoxItem Content="文件大小"
                                              Tag="{x:Static capture:VideoHistorySortMode.LargestFirst}" />
                            </ComboBox>
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <ListBox x:Name="VideoHistoryListBox"
                                 Padding="0,1,0,6"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemContainerStyle="{StaticResource HistoryListBoxItem}"
                                 ItemsSource="{Binding VideoItems}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Cursor="Hand"
                                            Style="{StaticResource HistoryCard}"
                                            PreviewMouseLeftButtonDown="OnVideoCardMouseLeftButtonDown"
                                            PreviewMouseMove="OnVideoCardMouseMove"
                                            PreviewMouseLeftButtonUp="OnVideoCardMouseLeftButtonUp"
                                            Loaded="OnHistoryDragHintLoaded"
                                            Unloaded="OnHistoryDragHintUnloaded">

                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.RowSpan="2"
                                                    Width="50"
                                                    Height="50"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource AppAccentMutedBrush}"
                                                    CornerRadius="7">
                                                <Grid>
                                                    <Image Source="{Binding Thumbnail}"
                                                           Stretch="UniformToFill" />
                                                    <TextBlock HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="22"
                                                               Foreground="{DynamicResource AppAccentBrush}"
                                                               Text="&#xE714;">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.RowSpan="2"
                                                        Grid.Column="1"
                                                        Margin="12,0,12,0"
                                                        HorizontalAlignment="Stretch"
                                                        VerticalAlignment="Center">
                                                <Grid>
                                                    <TextBlock x:Name="VideoNameTextBlock"
                                                               Cursor="IBeam"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                                                               PreviewMouseLeftButtonDown="OnVideoNameMouseLeftButtonDown"
                                                               Tag="{Binding}"
                                                               Text="{Binding FileName}"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip="单击重命名" />
                                                    <TextBox x:Name="VideoNameEditor"
                                                             Height="30"
                                                             Padding="8,3"
                                                             KeyDown="OnVideoNameEditorKeyDown"
                                                             LostKeyboardFocus="OnVideoNameEditorLostKeyboardFocus"
                                                             Tag="{Binding}"
                                                             Visibility="Collapsed" />
                                                </Grid>
                                                <TextBlock Margin="0,6,0,0"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding RecordedAt, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                                                    <Run Text="  ·  " />
                                                    <Run Text="{Binding FileSizeText, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock Margin="0,3,0,0"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis">
                                                    <Run Text="时长 " />
                                                    <Run Text="{Binding DurationText, Mode=OneWay}" />
                                                    <Run Text="  ·  " />
                                                    <Run Text="{Binding ResolutionText, Mode=OneWay}" />
                                                    <Run Text="  ·  " />
                                                    <Run Text="{Binding FormatText, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.RowSpan="2"
                                                        Grid.Column="2"
                                                        Margin="0,0,16,0"
                                                        VerticalAlignment="Center">
                                                <Button Click="OnViewVideoHistoryItemClick"
                                                        Content="查看"
                                                        Margin="0,0,0,6"
                                                        Style="{StaticResource HistoryActionButton}"
                                                        Tag="{Binding}" />
                                                <Button Click="OnCopyVideoHistoryItemClick"
                                                        Content="复制"
                                                        Margin="0,0,0,6"
                                                        Style="{StaticResource HistoryActionButton}"
                                                        Tag="{Binding}" />
                                                <Button Click="OnDeleteVideoHistoryItemClick"
                                                        Content="删除"
                                                        Margin="0"
                                                        Style="{StaticResource HistoryDeleteButton}"
                                                        Tag="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="VideoEmptyText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                                   Text="暂无录屏历史" />
                    </Grid>
            </Grid>
        </Grid>

        <TextBlock x:Name="HistoryStatusText"
                   Grid.Row="2"
                   Margin="22,0"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource AppTextSecondaryBrush}"
                   Text="截图历史仅保留本次运行，录屏文件保存在视频目录。"
                   TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
