<Window x:Class="Screenshot.App.Capture.CaptureHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="截图历史"
        Width="500"
        Height="620"
        MinWidth="360"
        MinHeight="360"
        FontFamily="Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource AppWindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="68" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="22,16,22,0">
            <TextBlock FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource AppControlForegroundBrush}"
                       Text="截图历史" />
            <TextBlock Margin="0,5,0,0"
                       FontSize="13"
                       Foreground="{DynamicResource AppTextSecondaryBrush}"
                       Text="仅保留本次运行的缩略图" />
        </StackPanel>

        <ListBox Grid.Row="1"
                 Margin="16,6,16,16"
                 Background="Transparent"
                 BorderThickness="0"
                 ItemsSource="{Binding Items}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0,0,0,10"
                            Padding="10"
                            Background="{DynamicResource AppPanelBackgroundBrush}"
                            BorderBrush="{DynamicResource AppSubtleBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="128" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Height="86"
                                    Background="{DynamicResource AppSidebarBackgroundBrush}"
                                    BorderBrush="{DynamicResource AppSubtleBorderBrush}"
                                    BorderThickness="1">
                                <Image Source="{Binding Thumbnail}"
                                       Stretch="Uniform" />
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="14,4,0,0">
                                <TextBlock FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AppTextPrimaryBrush}"
                                           Text="{Binding CapturedAt, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" />
                                <TextBlock Margin="0,8,0,0"
                                           Foreground="{DynamicResource AppTextSecondaryBrush}">
                                    <Run Text="{Binding PixelWidth}" />
                                    <Run Text=" x " />
                                    <Run Text="{Binding PixelHeight}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
