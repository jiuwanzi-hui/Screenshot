<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>SnapCut</AssemblyName>
    <RootNamespace>Screenshot.App</RootNamespace>
    <ApplicationIcon>Assets\Screenshot.ico</ApplicationIcon>
    <Version>2.3.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>Screenshot</Authors>
    <Product>SnapCut</Product>
    <AssemblyTitle>SnapCut</AssemblyTitle>
    <Description>轻量 Windows 截图工具</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Screenshot.ico" />
    <Content Include="THIRD-PARTY-NOTICES.txt"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BergamotTranslatorSharp" Version="0.5.1" />
    <PackageReference Include="Panlingo.LanguageIdentification.CLD3" Version="0.8.0" />
  </ItemGroup>

</Project>
