<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>SnapCut</AssemblyName>
    <RootNamespace>Screenshot.App</RootNamespace>
    <StartupObject>Screenshot.App.Program</StartupObject>
    <ApplicationIcon>Assets\Screenshot.ico</ApplicationIcon>
    <Version>4.2.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>九万字 (jiuwanzi-hui)</Authors>
    <Copyright>Copyright © 2026 九万字 (jiuwanzi-hui). All rights reserved.</Copyright>
    <Product>SnapCut</Product>
    <AssemblyTitle>SnapCut</AssemblyTitle>
    <Description>轻量 Windows 截图工具</Description>
    <PlatformTarget>x64</PlatformTarget>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <AllowedReferenceRelatedFileExtensions>
      .pri;.dll.config;.exe.config
    </AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Presentation\Localization\*.json" />
    <Resource Include="Assets\Screenshot.ico" />
    <Content Include="..\..\artifacts\translation-runtime\llama-b10276-bin-win-vulkan-x64.zip"
             Condition="Exists('..\..\artifacts\translation-runtime\llama-b10276-bin-win-vulkan-x64.zip')"
             Link="OfflinePackages\llama-b10276-bin-win-vulkan-x64.zip"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             ExcludeFromSingleFile="true" />
    <Resource Include="Assets\Screenshot.png" />
    <Resource Include="Assets\DonateQr.jpg" />
    <Resource Include="Assets\SnapCutCommunityQr.jpg" />
    <Resource Include="Assets\CreatorAvatar.jpg" />
    <Content Include="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Licenses\Hy-MT2-1.8B.txt" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="Licenses\Qwen3-VL-4B.txt" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\updates\SnapCut-Releases.json" Link="SnapCut-Releases.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BergamotTranslatorSharp" Version="0.5.1" />
    <PackageReference Include="DirectShowLib"
                      Version="1.0.0"
                      NoWarn="NU1701" />
    <PackageReference Include="Panlingo.LanguageIdentification.CLD3" Version="0.8.0" />
    <ProjectReference Include="..\Screenshot.OcrRuntime\Screenshot.OcrRuntime.csproj" />
    <Content Include="..\Screenshot.OcrRuntime\LICENSE.txt" Link="Licenses\RapidOcrNet.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <PackageReference Include="ZXing.Net" Version="0.16.10" />
    <PackageReference Include="ScreenRecorderLib" Version="6.6.0" ExcludeAssets="build;compile" GeneratePathProperty="true" />
    <Reference Include="ScreenRecorderLib">
      <HintPath>$(PkgScreenRecorderLib)\build\x64\ScreenRecorderLib.dll</HintPath>
      <Private>true</Private>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Reference>
  </ItemGroup>

</Project>
