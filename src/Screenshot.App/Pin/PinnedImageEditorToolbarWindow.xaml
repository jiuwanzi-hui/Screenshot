<Window x:Class="Screenshot.App.Pin.PinnedImageEditorToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:editor="clr-namespace:Screenshot.App.Editor"
        Title="钉图编辑工具"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI"
        ResizeMode="NoResize"
        ShowActivated="False"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        Topmost="True"
        WindowStyle="None"
        PreviewMouseLeftButtonDown="OnToolbarSurfaceMouseLeftButtonDown"
        PreviewMouseLeftButtonUp="OnToolbarSurfaceMouseLeftButtonUp"
        PreviewMouseMove="OnToolbarSurfaceMouseMove">
    <Window.Resources>
        <Geometry x:Key="UndoIconGeometry">M 8,2 L 2,8 L 8,14 V 11 C 13,11 16,13 17,17 C 17,10 13,6 8,6 Z</Geometry>
        <Geometry x:Key="RectangleIconGeometry">M 2,2 H 16 V 16 H 2 Z</Geometry>
        <Geometry x:Key="EllipseIconGeometry">M 9,2 C 13.5,2 17,5.1 17,9 C 17,12.9 13.5,16 9,16 C 4.5,16 1,12.9 1,9 C 1,5.1 4.5,2 9,2 Z</Geometry>
        <Geometry x:Key="ArrowIconGeometry">M 2,9 H 15 M 10,4 L 15,9 L 10,14</Geometry>
        <Geometry x:Key="CurvedArrowIconGeometry">M 2,14 C 4,3 12,3 15,9 M 10,6 L 15,9 L 12,14</Geometry>
        <Geometry x:Key="StraightFilledArrowIconGeometry">M 1,7 H 11 V 3 L 18,9 L 11,15 V 11 H 1 Z</Geometry>
        <Geometry x:Key="StraightHollowArrowIconGeometry">M 1,7 H 11 V 3 L 18,9 L 11,15 V 11 H 1 Z</Geometry>
        <Geometry x:Key="CurvedFilledArrowIconGeometry">M 1,4 C 2,11 7,15 13,11 L 11,8 L 18,10 L 14,17 L 13,14 C 5,19 1,13 1,4 Z</Geometry>
        <Geometry x:Key="CurvedHollowArrowIconGeometry">M 1,4 C 2,11 7,15 13,11 L 11,8 L 18,10 L 14,17 L 13,14 C 5,19 1,13 1,4 Z</Geometry>
        <Geometry x:Key="PenIconGeometry">M 3,14 L 4.2,9.8 L 12.6,1.4 L 16.6,5.4 L 8.2,13.8 Z M 11.2,3.8 L 14.2,6.8</Geometry>
        <Geometry x:Key="MosaicIconGeometry">M 2,2 H 16 V 16 H 2 Z M 6.7,2 V 16 M 11.3,2 V 16 M 2,6.7 H 16 M 2,11.3 H 16</Geometry>
        <Geometry x:Key="TextIconGeometry">M 3,3 H 15 M 9,3 V 16</Geometry>
        <Geometry x:Key="SaveIconGeometry">M 3,2 H 13 L 16,5 V 16 H 3 Z M 5,2 V 7 H 13 V 2 M 6,11 H 13 V 16 H 6 Z</Geometry>
        <Geometry x:Key="ScissorsIconGeometry">M 4,3 A 2,2 0 1 0 4,7 A 2,2 0 1 0 4,3 M 4,11 A 2,2 0 1 0 4,15 A 2,2 0 1 0 4,11 M 5.6,6.3 L 15.5,13 M 5.6,11.7 L 10.2,8.6</Geometry>
        <Style x:Key="ToolbarIconPath" TargetType="Path">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Stroke" Value="{DynamicResource EditorToolbarIconBrush}" />
            <Setter Property="StrokeThickness" Value="1.7" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
        <Style x:Key="ToolbarToggle" TargetType="RadioButton">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource EditorToolbarButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EditorToolbarButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource EditorToolbarIconBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource EditorToolbarButtonHoverBackgroundBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource EditorToolbarButtonHoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource EditorToolbarButtonSelectedBackgroundBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource EditorToolbarButtonSelectedBorderBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Width" Value="36" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource EditorToolbarButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource EditorToolbarButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource EditorToolbarIconBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource EditorToolbarButtonHoverBackgroundBrush}" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource EditorToolbarButtonHoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ColorSwatch" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,4,5,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderBrush" Value="{DynamicResource ImageEditorSliderThumbBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="SwatchBorder"
                                     Fill="{TemplateBinding Background}"
                                     Stroke="{TemplateBinding BorderBrush}"
                                     StrokeThickness="{TemplateBinding BorderThickness}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwatchBorder" Property="Stroke" Value="#F2FFFC" />
                                <Setter TargetName="SwatchBorder" Property="StrokeThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ToolbarSeparator" TargetType="Border">
            <Setter Property="Width" Value="2" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="9,3,14,3" />
            <Setter Property="Background" Value="#7AF7EA" />
            <Setter Property="CornerRadius" Value="1" />
        </Style>
        <Style x:Key="ToolbarStrokeSlider" TargetType="Slider">
            <Setter Property="Width" Value="82" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="3" Background="#405C7472" CornerRadius="1.5" />
                            <Track x:Name="PART_Track" Height="16" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="3" VerticalAlignment="Center" Background="{DynamicResource AppAccentBrush}" CornerRadius="1.5" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14" Background="{DynamicResource AppAccentBrush}" BorderBrush="#C7FFF9" BorderThickness="2" Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="{TemplateBinding BorderThickness}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="ToolbarSurface"
            Margin="6"
            Padding="10,8"
            Background="{DynamicResource AppPanelBackgroundBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Cursor="SizeAll">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" Direction="0" Opacity="0.42" ShadowDepth="0" Color="#000000" />
        </Border.Effect>
        <Grid>
            <StackPanel x:Name="EditPanel">
                <StackPanel x:Name="EditTools">
                <StackPanel x:Name="EditToolsRow1" Orientation="Horizontal">
                    <RadioButton x:Name="ShapeToolButton" GroupName="PinnedEditorTool" Tag="Rectangle" Checked="OnToolChecked" Style="{StaticResource ToolbarToggle}" ToolTip="矩形/椭圆">
                        <RadioButton.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="RectangleShapeMenuItem" Tag="Rectangle" IsCheckable="True" Click="OnShapeMenuItemClick"><MenuItem.Header><StackPanel Orientation="Horizontal"><Path Width="18" Height="18" Margin="0,0,8,0" Data="{StaticResource RectangleIconGeometry}" Style="{StaticResource ToolbarIconPath}" /><TextBlock VerticalAlignment="Center" Text="矩形" /></StackPanel></MenuItem.Header></MenuItem>
                                <MenuItem x:Name="EllipseShapeMenuItem" Tag="Ellipse" IsCheckable="True" Click="OnShapeMenuItemClick"><MenuItem.Header><StackPanel Orientation="Horizontal"><Path Width="18" Height="18" Margin="0,0,8,0" Data="{StaticResource EllipseIconGeometry}" Style="{StaticResource ToolbarIconPath}" /><TextBlock VerticalAlignment="Center" Text="椭圆" /></StackPanel></MenuItem.Header></MenuItem>
                            </ContextMenu>
                        </RadioButton.ContextMenu>
                        <Grid Width="27">
                            <Path x:Name="ShapeToolIcon" Width="17" Height="17" HorizontalAlignment="Left" Data="{StaticResource RectangleIconGeometry}" Style="{StaticResource ToolbarIconPath}" />
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="9" Foreground="{DynamicResource EditorToolbarIconBrush}" Text="▾" PreviewMouseLeftButtonDown="OnShapeMenuArrowMouseDown" />
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="ArrowToolButton" GroupName="PinnedEditorTool" Tag="Arrow" Checked="OnToolChecked" Style="{StaticResource ToolbarToggle}" ToolTip="箭头">
                        <RadioButton.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="StraightFilledArrowMenuItem" Tag="Arrow,Filled" IsCheckable="True" Click="OnArrowVariantMenuItemClick"><MenuItem.Header><StackPanel Orientation="Horizontal"><Path Width="18" Height="18" Margin="0,0,8,0" Data="{StaticResource StraightFilledArrowIconGeometry}" Fill="{DynamicResource AppControlForegroundBrush}" /><TextBlock VerticalAlignment="Center" Text="直线实心箭头" /></StackPanel></MenuItem.Header></MenuItem>
                                <MenuItem x:Name="StraightHollowArrowMenuItem" Tag="Arrow,Hollow" IsCheckable="True" Click="OnArrowVariantMenuItemClick"><MenuItem.Header><StackPanel Orientation="Horizontal"><Path Width="18" Height="18" Margin="0,0,8,0" Data="{StaticResource StraightHollowArrowIconGeometry}" Fill="Transparent" Stroke="{DynamicResource AppControlForegroundBrush}" StrokeThickness="1.8" /><TextBlock VerticalAlignment="Center" Text="直线空心箭头" /></StackPanel></MenuItem.Header></MenuItem>
                                <MenuItem x:Name="CurvedFilledArrowMenuItem" Tag="CurvedArrow,Filled" IsCheckable="True" Click="OnArrowVariantMenuItemClick"><MenuItem.Header><StackPanel Orientation="Horizontal"><Path Width="18" Height="18" Margin="0,0,8,0" Data="{StaticResource CurvedFilledArrowIconGeometry}" Fill="{DynamicResource AppControlForegroundBrush}" /><TextBlock VerticalAlignment="Center" Text="弧形实心箭头" /></StackPanel></MenuItem.Header></MenuItem>
                                <MenuItem x:Name="CurvedHollowArrowMenuItem" Tag="CurvedArrow,Hollow" IsCheckable="True" Click="OnArrowVariantMenuItemClick"><MenuItem.Header><StackPanel Orientation="Horizontal"><Path Width="18" Height="18" Margin="0,0,8,0" Data="{StaticResource CurvedHollowArrowIconGeometry}" Fill="Transparent" Stroke="{DynamicResource AppControlForegroundBrush}" StrokeThickness="1.8" /><TextBlock VerticalAlignment="Center" Text="弧形空心箭头" /></StackPanel></MenuItem.Header></MenuItem>
                            </ContextMenu>
                        </RadioButton.ContextMenu>
                        <Grid Width="27">
                            <Path x:Name="ArrowToolIcon" Width="17" Height="17" HorizontalAlignment="Left" Data="{StaticResource StraightFilledArrowIconGeometry}" Style="{StaticResource ToolbarIconPath}" />
                            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="9" Foreground="{DynamicResource EditorToolbarIconBrush}" Text="▾" PreviewMouseLeftButtonDown="OnArrowMenuArrowMouseDown" />
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="EmojiToolButton" GroupName="PinnedEditorTool" Tag="Emoji" Checked="OnToolChecked" Style="{StaticResource ToolbarToggle}" ToolTip="表情">
                        <editor:EmojiStickerImage Width="21" Height="21" Sticker="😊" />
                    </RadioButton>
                    <RadioButton x:Name="NumberToolButton" GroupName="PinnedEditorTool" Tag="Number" Checked="OnToolChecked" Style="{StaticResource ToolbarToggle}" ToolTip="序号">
                        <Border Width="19" Height="19" Background="{DynamicResource EditorToolbarIconBrush}" CornerRadius="10">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AppPanelBackgroundBrush}" FontSize="11" FontWeight="Bold" Text="1" />
                        </Border>
                    </RadioButton>
                    <RadioButton x:Name="BrushToolButton" GroupName="PinnedEditorTool" Tag="Brush" Checked="OnToolChecked" Style="{StaticResource ToolbarToggle}" ToolTip="画笔">
                        <Path Data="{StaticResource PenIconGeometry}" Style="{StaticResource ToolbarIconPath}" />
                    </RadioButton>
                    <RadioButton x:Name="TextToolButton" GroupName="PinnedEditorTool" Tag="Text" Checked="OnToolChecked" Style="{StaticResource ToolbarToggle}" ToolTip="文字">
                        <Path Data="{StaticResource TextIconGeometry}" Style="{StaticResource ToolbarIconPath}" />
                    </RadioButton>
                    <RadioButton x:Name="MosaicToolButton" GroupName="PinnedEditorTool" Tag="Mosaic" Checked="OnToolChecked" Style="{StaticResource ToolbarToggle}" ToolTip="马赛克">
                        <Path Data="{StaticResource MosaicIconGeometry}" Style="{StaticResource ToolbarIconPath}" />
                    </RadioButton>
                    <Border x:Name="ToolActionSeparator" Style="{StaticResource ToolbarSeparator}" />
                    <Button x:Name="SaveButton" Click="OnSaveClick" Style="{StaticResource ToolbarButton}" ToolTip="保存 PNG">
                        <Path Data="{StaticResource SaveIconGeometry}" Style="{StaticResource ToolbarIconPath}" />
                    </Button>
                    <Button x:Name="OcrButton" Click="OnOcrClick" Style="{StaticResource ToolbarButton}" ToolTip="识别文字并在原位置选择复制">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="文" />
                    </Button>
                    <Button x:Name="CopyTextButton" Click="OnCopyTextClick" Style="{StaticResource ToolbarButton}" ToolTip="识别并复制全部文字">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="取" />
                    </Button>
                    <Button x:Name="TranslateActionButton" Click="OnTranslateClick" Style="{StaticResource ToolbarButton}" ToolTip="识别并翻译图片文字">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="译" />
                    </Button>
                    <Button x:Name="PrivacyButton" Click="OnPrivacyClick" Style="{StaticResource ToolbarButton}" ToolTip="识别敏感信息，确认后批量打码">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="隐" />
                    </Button>
                    <Border x:Name="ActionHistorySeparator" Style="{StaticResource ToolbarSeparator}" />
                    <Button x:Name="CropToolButton" Click="OnCropClick" Style="{StaticResource ToolbarButton}" ToolTip="框选裁剪">
                        <Grid Width="21" Height="18">
                            <Path x:Name="ScissorsIcon" Data="{StaticResource ScissorsIconGeometry}" Style="{StaticResource ToolbarIconPath}" />
                            <Line X1="10" Y1="8.5" X2="21" Y2="8.5" Stroke="{DynamicResource EditorToolbarIconBrush}" StrokeThickness="1.5" StrokeDashArray="2,2" />
                        </Grid>
                    </Button>
                    <Button x:Name="UndoButton" Click="OnUndoClick" Style="{StaticResource ToolbarButton}" ToolTip="撤销">
                        <Path Data="{StaticResource UndoIconGeometry}"
                              Fill="{DynamicResource EditorToolbarIconBrush}"
                              Stroke="Transparent"
                              StrokeThickness="0" />
                    </Button>
                    <Border x:Name="HistoryFinishSeparator" Style="{StaticResource ToolbarSeparator}" />
                    <Button x:Name="CancelEditButton" Click="OnCancelClick" Style="{StaticResource ToolbarButton}" ToolTip="取消编辑">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EditorToolbarCancelIconBrush}" Text="&#xE711;" />
                    </Button>
                    <Button x:Name="EditApplyButton"
                            Click="OnApplyClick"
                            Background="{DynamicResource EditorToolbarConfirmBackgroundBrush}"
                            BorderBrush="{DynamicResource EditorToolbarConfirmBorderBrush}"
                            Style="{StaticResource ToolbarButton}"
                            ToolTip="应用编辑">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{DynamicResource EditorToolbarConfirmIconBrush}" Text="&#xE73E;" />
                    </Button>
                </StackPanel>
                <StackPanel x:Name="EditToolsRow2"
                            Margin="0,6,0,0"
                            Orientation="Horizontal"
                            Visibility="Collapsed" />
                </StackPanel>
                <StackPanel x:Name="ColorOptions"
                            Margin="0,6,0,0"
                            Background="Transparent"
                            Cursor="SizeAll"
                            Orientation="Horizontal">
                    <Button x:Name="RedColorButton" Background="#D64545" BorderBrush="#F2FFFC" BorderThickness="2" Tag="#D64545" Click="OnColorClick" Style="{StaticResource ColorSwatch}" ToolTip="红色" />
                    <Button x:Name="CyanColorButton" Background="#007F73" BorderBrush="#00695F" Tag="#007F73" Click="OnColorClick" Style="{StaticResource ColorSwatch}" ToolTip="青绿" />
                    <Button x:Name="DarkColorButton" Background="#25313A" BorderBrush="#1C252D" Tag="#25313A" Click="OnColorClick" Style="{StaticResource ColorSwatch}" ToolTip="黑色" />
                    <Button x:Name="CustomColorButton" Margin="0,4,8,0" Background="#647A80" BorderBrush="#40565C" Click="OnCustomColorClick" Style="{StaticResource ColorSwatch}" ToolTip="自定义颜色">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" Text="&#xE790;" />
                    </Button>
                    <Slider x:Name="StrokeWidthSlider"
                            Minimum="1"
                            Maximum="12"
                            SmallChange="1"
                            TickFrequency="1"
                            Style="{StaticResource ToolbarStrokeSlider}"
                            Value="3"
                            ValueChanged="OnStrokeWidthChanged" />
                    <TextBlock x:Name="StrokeWidthText"
                               MinWidth="30"
                               Margin="5,0,0,0"
                               VerticalAlignment="Center"
                               FontFamily="Consolas"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Text="3 px" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="CropPanel" Visibility="Collapsed" Orientation="Horizontal">
                <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource AppTextPrimaryBrush}" Text="裁剪范围" />
                <TextBlock x:Name="CropSizeText" Width="112" VerticalAlignment="Center" FontFamily="Consolas" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                <Button Width="52" Click="OnCancelClick" Content="取消" Style="{StaticResource ToolbarButton}" />
                <Button x:Name="CropApplyButton"
                        Width="86"
                        Click="OnApplyClick"
                        Content="应用裁剪"
                        Background="{DynamicResource EditorToolbarConfirmBackgroundBrush}"
                        BorderBrush="{DynamicResource EditorToolbarConfirmBorderBrush}"
                        Style="{StaticResource ToolbarButton}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
