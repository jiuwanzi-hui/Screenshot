<Window x:Class="Screenshot.App.Pin.PinnedImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:editor="clr-namespace:Screenshot.App.Editor"
        xmlns:pin="clr-namespace:Screenshot.App.Pin"
        mc:Ignorable="d"
        Title="钉图"
        MinWidth="25"
        MinHeight="25"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewMouseMove="OnWindowPreviewMouseMove"
        PreviewMouseLeftButtonUp="OnWindowPreviewMouseLeftButtonUp"
        LostMouseCapture="OnWindowLostMouseCapture">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/ThemedContextMenus.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="PinnedCropHandle" TargetType="Thumb">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Background" Value="{DynamicResource SelectionBorderBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Panel.ZIndex" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent"><Border Width="6" Height="6" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource ImageEditorSliderThumbBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="1" /></Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border x:Name="PinnedShell"
            ContextMenuOpening="OnPinnedShellContextMenuOpening"
            Margin="12"
            Background="Transparent"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="0"
            CornerRadius="0">
        <Border.ContextMenu>
            <ContextMenu Style="{StaticResource ThemedContextMenuStyle}">
                <MenuItem x:Name="EditMenuItem" Click="OnEditClick" Header="编辑" Style="{StaticResource ThemedMenuItemStyle}" />
                <MenuItem Click="OnCopyClick" Header="复制图片" Style="{StaticResource ThemedMenuItemStyle}" />
                <MenuItem Click="OnSaveClick" Header="保存图片" Style="{StaticResource ThemedMenuItemStyle}" />
                <Separator />
                <MenuItem Click="OnOpenSettingsClick"
                          Header="打开设置"
                          Style="{StaticResource ThemedMenuItemStyle}" />
                <Separator />
                <MenuItem x:Name="RestoreMenuItem"
                          Click="OnRestoreClick"
                          Header="重启后恢复此钉图"
                          Style="{StaticResource ThemedMenuItemStyle}" />
                <MenuItem x:Name="GroupMenuItem"
                          Click="OnGroupClick"
                          Header="加入钉图编组"
                          Style="{StaticResource ThemedMenuItemStyle}" />
                <MenuItem Click="OnMinimizeClick"
                          Header="最小化此钉图"
                          Style="{StaticResource ThemedMenuItemStyle}" />
                <MenuItem Click="OnHideAllClick"
                          Header="最小化全部钉图"
                          Style="{StaticResource ThemedMenuItemStyle}" />
                <MenuItem Click="OnCloseFromContextMenuClick"
                          Header="关闭钉图"
                          Style="{StaticResource ThemedMenuItemStyle}" />
                <Separator />
                <MenuItem x:Name="StatusMenuItem" Header="钉图" IsEnabled="False" MaxWidth="380" Style="{StaticResource ThemedMenuItemStyle}" />
            </ContextMenu>
        </Border.ContextMenu>
        <Grid>
            <Border x:Name="ImageSurface"
                    Background="Transparent"
                    CornerRadius="0"
                    Cursor="SizeAll"
                    ClipToBounds="True"
                    PreviewMouseWheel="OnImageMouseWheel"
                    PreviewMouseLeftButtonDown="OnImageMouseLeftButtonDown"
                    PreviewMouseMove="OnImageMouseMove"
                    PreviewMouseLeftButtonUp="OnImageMouseLeftButtonUp"
                    LostMouseCapture="OnImageLostMouseCapture">
                <Grid x:Name="ImageViewport"
                      SizeChanged="OnImageViewportSizeChanged">
                    <pin:PixelAlignedImage x:Name="PinnedImage"
                           Source="{Binding Preview}"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Stretch="Uniform" />
                    <Canvas x:Name="TextOverlay" IsHitTestVisible="False"
                            Panel.ZIndex="20"
                            Background="{x:Null}" />
                    <ScrollViewer x:Name="InlineEditorViewport"
                          Panel.ZIndex="10"
                          Background="Transparent"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalContentAlignment="Center"
                          VerticalContentAlignment="Center"
                          PreviewMouseDown="OnInlineEditorPreviewMouseDown"
                          PreviewMouseMove="OnInlineEditorPreviewMouseMove"
                          PreviewMouseUp="OnInlineEditorPreviewMouseUp"
                          LostMouseCapture="OnInlineEditorLostMouseCapture"
                          Visibility="Collapsed">
                        <Border x:Name="InlineEditorFrame"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                ClipToBounds="True">
                            <editor:ImageEditorCanvas x:Name="InlineEditorCanvas"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Top" />
                        </Border>
                    </ScrollViewer>
                    <Canvas x:Name="CropOverlay"
                            Panel.ZIndex="40"
                            Visibility="Collapsed"
                            Background="Transparent"
                            Cursor="Cross"
                            MouseLeftButtonDown="OnCropMouseLeftButtonDown"
                            MouseLeftButtonUp="OnCropMouseLeftButtonUp"
                            MouseMove="OnCropMouseMove">
                        <Path x:Name="CropMask" Fill="#99000000" IsHitTestVisible="False" />
                        <Rectangle x:Name="CropSelection"
                                   Fill="Transparent"
                                   Stroke="{DynamicResource SelectionBorderBrush}"
                                   StrokeDashArray="5,3"
                                   StrokeThickness="2"
                                   IsHitTestVisible="False" />
                        <Thumb x:Name="CropMoveThumb" Tag="Move" Opacity="0" Cursor="SizeAll" DragDelta="OnCropHandleDragDelta" />
                        <Thumb x:Name="CropTopLeftThumb" Tag="TopLeft" Cursor="SizeNWSE" Style="{StaticResource PinnedCropHandle}" DragDelta="OnCropHandleDragDelta" />
                        <Thumb x:Name="CropTopRightThumb" Tag="TopRight" Cursor="SizeNESW" Style="{StaticResource PinnedCropHandle}" DragDelta="OnCropHandleDragDelta" />
                        <Thumb x:Name="CropBottomLeftThumb" Tag="BottomLeft" Cursor="SizeNESW" Style="{StaticResource PinnedCropHandle}" DragDelta="OnCropHandleDragDelta" />
                        <Thumb x:Name="CropBottomRightThumb" Tag="BottomRight" Cursor="SizeNWSE" Style="{StaticResource PinnedCropHandle}" DragDelta="OnCropHandleDragDelta" />
                    </Canvas>
                </Grid>
            </Border>

            <pin:PinnedImageOutline x:Name="ImageOutline" Margin="-2" Panel.ZIndex="-1"
                                    EdgeBrush="{DynamicResource SelectionBorderBrush}"
                                    IsHitTestVisible="False" SnapsToDevicePixels="True" UseLayoutRounding="True">
                <pin:PinnedImageOutline.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.32" Color="#000000" />
                </pin:PinnedImageOutline.Effect>
            </pin:PinnedImageOutline>
        </Grid>
    </Border>
</Window>
