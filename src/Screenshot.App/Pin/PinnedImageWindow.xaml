<Window x:Class="Screenshot.App.Pin.PinnedImageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="钉图"
        MinWidth="260"
        MinHeight="140"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Microsoft YaHei UI"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/ThemedContextMenus.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="PinnedCommandButton" TargetType="Button">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="42" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="Background" Value="{DynamicResource AppInputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppSubtleBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AppControlForegroundBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CommandBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CommandBorder" Property="Background" Value="{DynamicResource AppAccentMutedBrush}" />
                                <Setter TargetName="CommandBorder" Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CommandBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="CommandBorder" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PinnedCloseButton" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBorder" Property="Background" Value="#D9C94B55" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CloseBorder" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PinnedOpacitySlider" TargetType="Slider">
            <Setter Property="Width" Value="66" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4"
                                    Background="{DynamicResource ImageEditorSliderTrackBrush}"
                                    CornerRadius="2" />
                            <Track x:Name="PART_Track"
                                   Height="14"
                                   VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}"
                                                  IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource AppAccentBrush}"
                                                        CornerRadius="2" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}"
                                                  Background="Transparent"
                                                  IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12"
                                           Height="12"
                                           Background="{DynamicResource AppAccentBrush}"
                                           BorderBrush="{DynamicResource ImageEditorSliderThumbBorderBrush}"
                                           BorderThickness="1"
                                           Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{TemplateBinding Background}"
                                                         Stroke="{TemplateBinding BorderBrush}"
                                                         StrokeThickness="{TemplateBinding BorderThickness}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InvisibleResizeThumb" TargetType="Thumb">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ForceCursor" Value="True" />
            <Setter Property="Panel.ZIndex" Value="20" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border x:Name="PinnedShell"
            Margin="12"
            Background="{DynamicResource AppPanelBackgroundBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Border.ContextMenu>
            <ContextMenu Style="{StaticResource ThemedContextMenuStyle}">
                <MenuItem Click="OnOpenSettingsClick"
                          Header="打开设置"
                          Style="{StaticResource ThemedMenuItemStyle}" />
                <MenuItem Click="OnCloseFromContextMenuClick"
                          Header="关闭钉图"
                          Style="{StaticResource ThemedMenuItemStyle}" />
            </ContextMenu>
        </Border.ContextMenu>
        <Border.Effect>
            <DropShadowEffect BlurRadius="18"
                              Direction="0"
                              Opacity="0.50"
                              ShadowDepth="0"
                              Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="PinnedHeader"
                    Grid.Row="0"
                    Background="{DynamicResource AppSidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource AppSeparatorBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="7,7,0,0"
                    Cursor="SizeAll"
                    MouseLeftButtonDown="OnHeaderMouseLeftButtonDown">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right"
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Button Click="OnCopyClick"
                                Content="复制"
                                Style="{StaticResource PinnedCommandButton}"
                                ToolTip="复制图片" />
                        <Button x:Name="TranslateButton"
                                Click="OnTranslateClick"
                                Content="翻译"
                                Style="{StaticResource PinnedCommandButton}"
                                ToolTip="翻译图片文字并覆盖显示" />
                        <Slider Style="{StaticResource PinnedOpacitySlider}"
                                Minimum="0.2"
                                Maximum="1"
                                SmallChange="0.1"
                                Value="1"
                                ValueChanged="OnOpacityValueChanged"
                                ToolTip="透明度" />
                        <Button Margin="5,0,0,0"
                                Click="OnCloseClick"
                                Style="{StaticResource PinnedCloseButton}"
                                ToolTip="关闭">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       Text="&#xE711;" />
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="HeaderStatusText"
                               Margin="9,0,8,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource AppTextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               Text="钉图" />
                </DockPanel>
            </Border>

            <Border x:Name="ImageSurface"
                    Grid.Row="1"
                    Background="{DynamicResource ImageEditorViewportBackgroundBrush}"
                    CornerRadius="0,0,7,7"
                    Cursor="SizeAll"
                    ClipToBounds="True"
                    MouseLeftButtonDown="OnImageMouseLeftButtonDown">
                <Grid x:Name="ImageViewport"
                      SizeChanged="OnImageViewportSizeChanged">
                    <Image x:Name="PinnedImage"
                           Source="{Binding Preview}"
                           Stretch="Uniform" />
                    <Canvas x:Name="TextOverlay"
                            Background="Transparent" />
                </Grid>
            </Border>

            <Thumb Grid.Row="1"
                   Width="8"
                   HorizontalAlignment="Left"
                   Cursor="SizeWE"
                   DragDelta="OnResizeEdgeDragDelta"
                   Style="{StaticResource InvisibleResizeThumb}"
                   Tag="Left" />
            <Thumb Grid.Row="1"
                   Width="8"
                   HorizontalAlignment="Right"
                   Cursor="SizeWE"
                   DragDelta="OnResizeEdgeDragDelta"
                   Style="{StaticResource InvisibleResizeThumb}"
                   Tag="Right" />
            <Thumb Grid.Row="1"
                   Height="8"
                   VerticalAlignment="Top"
                   Cursor="SizeNS"
                   DragDelta="OnResizeEdgeDragDelta"
                   Style="{StaticResource InvisibleResizeThumb}"
                   Tag="Top" />
            <Thumb Grid.Row="1"
                   Height="8"
                   VerticalAlignment="Bottom"
                   Cursor="SizeNS"
                   DragDelta="OnResizeEdgeDragDelta"
                   Style="{StaticResource InvisibleResizeThumb}"
                   Tag="Bottom" />
            <Thumb Grid.Row="1"
                   Width="14"
                   Height="14"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Cursor="SizeNWSE"
                   DragDelta="OnResizeEdgeDragDelta"
                   Style="{StaticResource InvisibleResizeThumb}"
                   Tag="TopLeft" />
            <Thumb Grid.Row="1"
                   Width="14"
                   Height="14"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Cursor="SizeNESW"
                   DragDelta="OnResizeEdgeDragDelta"
                   Style="{StaticResource InvisibleResizeThumb}"
                   Tag="TopRight" />
            <Thumb Grid.Row="1"
                   Width="14"
                   Height="14"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Bottom"
                   Cursor="SizeNESW"
                   DragDelta="OnResizeEdgeDragDelta"
                   Style="{StaticResource InvisibleResizeThumb}"
                   Tag="BottomLeft" />
            <Thumb Grid.Row="1"
                   Width="14"
                   Height="14"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Cursor="SizeNWSE"
                   DragDelta="OnResizeEdgeDragDelta"
                   Style="{StaticResource InvisibleResizeThumb}"
                   Tag="BottomRight" />
        </Grid>
    </Border>
</Window>
